{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spellbook.replex.me/contracts/validation-report.schema.json",
  "title": "ValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "valid",
    "baseDocumentSha256",
    "candidateDocumentSha256",
    "changedParts",
    "errors",
    "warnings"
  ],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "valid": { "type": "boolean" },
    "baseDocumentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateDocumentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changedParts": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
