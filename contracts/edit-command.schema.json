{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spellbook.replex.me/contracts/edit-command.schema.json",
  "title": "EditCommandBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "baseDocumentSha256", "summary", "commands"],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "baseDocumentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/replaceText" },
          { "$ref": "#/$defs/moveShape" },
          { "$ref": "#/$defs/resizeShape" },
          { "$ref": "#/$defs/setFill" },
          { "$ref": "#/$defs/alignShapes" },
          { "$ref": "#/$defs/group_shapes" },
          { "$ref": "#/$defs/ungroup_shape" },
          { "$ref": "#/$defs/add_image" },
          { "$ref": "#/$defs/replace_image" },
          { "$ref": "#/$defs/crop_image" },
          { "$ref": "#/$defs/add_slide" },
          { "$ref": "#/$defs/duplicate_slide" },
          { "$ref": "#/$defs/delete_slide" },
          { "$ref": "#/$defs/move_slide" },
          { "$ref": "#/$defs/add_text_box" },
          { "$ref": "#/$defs/add_shape" },
          { "$ref": "#/$defs/delete_shape" },
          { "$ref": "#/$defs/duplicate_shape" },
          { "$ref": "#/$defs/rotate_shape" },
          { "$ref": "#/$defs/reorder_shape" },
          { "$ref": "#/$defs/set_text_style" },
          { "$ref": "#/$defs/set_paragraph_style" },
          { "$ref": "#/$defs/set_line" },
          { "$ref": "#/$defs/set_background" },
          { "$ref": "#/$defs/distribute_shapes" },
          { "$ref": "#/$defs/set_table_cell" },
          { "$ref": "#/$defs/add_table" }
        ]
      }
    }
  },
  "$defs": {
    "group_shapes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targets"],
      "properties": {
        "op": { "const": "group_shapes" },
        "targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    },
    "ungroup_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "op": { "const": "ungroup_shape" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "add_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex", "x", "y", "width", "height", "assetId"],
      "properties": {
        "op": {
          "type": "string",
          "const": "add_image"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        }
      }
    },
    "replace_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "assetId"],
      "properties": {
        "op": {
          "type": "string",
          "const": "replace_image"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        }
      }
    },
    "crop_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "left", "top", "right", "bottom"],
      "properties": {
        "op": {
          "type": "string",
          "const": "crop_image"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        }
      }
    },
    "add_slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "templateSlideIndex", "insertIndex"],
      "properties": {
        "op": {
          "type": "string",
          "const": "add_slide"
        },
        "templateSlideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "insertIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "duplicate_slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex", "insertIndex"],
      "properties": {
        "op": {
          "type": "string",
          "const": "duplicate_slide"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "insertIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "delete_slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex"],
      "properties": {
        "op": {
          "type": "string",
          "const": "delete_slide"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "move_slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex", "insertIndex"],
      "properties": {
        "op": {
          "type": "string",
          "const": "move_slide"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "insertIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "add_text_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex", "x", "y", "width", "height", "text"],
      "properties": {
        "op": {
          "type": "string",
          "const": "add_text_box"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "add_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "slideIndex",
        "x",
        "y",
        "width",
        "height",
        "geometry",
        "rgb"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "add_shape"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "geometry": {
          "enum": [
            "rect",
            "roundRect",
            "ellipse",
            "triangle",
            "diamond",
            "chevron",
            "rightArrow",
            "line"
          ]
        },
        "rgb": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        }
      }
    },
    "delete_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "op": {
          "type": "string",
          "const": "delete_shape"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "duplicate_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "x", "y"],
      "properties": {
        "op": {
          "type": "string",
          "const": "duplicate_shape"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "rotate_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "degrees"],
      "properties": {
        "op": {
          "type": "string",
          "const": "rotate_shape"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "degrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      }
    },
    "reorder_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "position"],
      "properties": {
        "op": {
          "type": "string",
          "const": "reorder_shape"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "position": {
          "enum": ["front", "back", "forward", "backward"]
        }
      }
    },
    "set_text_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "op": {
          "type": "string",
          "const": "set_text_style"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fontSize": {
          "type": "number",
          "minimum": 1,
          "maximum": 400
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "rgb": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        }
      }
    },
    "set_paragraph_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "op": {
          "type": "string",
          "const": "set_paragraph_style"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "alignment": {
          "enum": ["left", "center", "right", "justify"]
        },
        "bullet": {
          "enum": ["none", "bullet", "number"]
        }
      }
    },
    "set_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "rgb", "width"],
      "properties": {
        "op": {
          "type": "string",
          "const": "set_line"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "rgb": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "set_background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex", "rgb"],
      "properties": {
        "op": {
          "type": "string",
          "const": "set_background"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "rgb": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        }
      }
    },
    "distribute_shapes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targets", "axis"],
      "properties": {
        "op": {
          "type": "string",
          "const": "distribute_shapes"
        },
        "targets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "axis": {
          "enum": ["horizontal", "vertical"]
        }
      }
    },
    "set_table_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "row", "column", "text"],
      "properties": {
        "op": {
          "type": "string",
          "const": "set_table_cell"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "add_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slideIndex", "x", "y", "width", "height", "rows"],
      "properties": {
        "op": {
          "type": "string",
          "const": "add_table"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideIndex", "elementId", "sourceHash"],
      "properties": {
        "slideIndex": { "type": "integer", "minimum": 0 },
        "elementId": { "type": "string", "minLength": 1 },
        "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "replaceText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "text"],
      "properties": {
        "op": { "type": "string", "const": "replace_text" },
        "target": { "$ref": "#/$defs/target" },
        "text": { "type": "string", "maxLength": 4000 }
      }
    },
    "moveShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "x", "y"],
      "properties": {
        "op": { "type": "string", "const": "move_shape" },
        "target": { "$ref": "#/$defs/target" },
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "resizeShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "width", "height"],
      "properties": {
        "op": { "type": "string", "const": "resize_shape" },
        "target": { "$ref": "#/$defs/target" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "setFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "rgb"],
      "properties": {
        "op": { "type": "string", "const": "set_fill" },
        "target": { "$ref": "#/$defs/target" },
        "rgb": { "type": "string", "pattern": "^[A-Fa-f0-9]{6}$" }
      }
    },
    "alignShapes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targets", "alignment"],
      "properties": {
        "op": { "type": "string", "const": "align_shapes" },
        "targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/target" }
        },
        "alignment": {
          "enum": ["left", "center", "right", "top", "middle", "bottom"]
        }
      }
    }
  }
}
