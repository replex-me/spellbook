      "candidate": "same_engine_mutated_save"
    },
    "visual": {
      "kind": "native_agent_review_evidence",
      "implementation": "apps/ai-connector/src/native-agent.ts",
      "test": "apps/ai-connector/src/native-agent.test.ts",
      "policy": "Every changed slide must have a fresh PNG, no introduced deterministic layout issue, and explicit model review coverage for the same revision."
    },
    "playback": {
      "kind": "collabora_web_slideshow_evidence",
      "implementation": "services/office-session-spike/slideshow-playback.mjs",
      "test": "services/office-session-spike/slideshow-playback.test.mjs",
      "families": ["slide_transition", "animation"],
      "policy": "The edited timing data must reach Collabora's web slideshow runtime, create a real playback activity, render multiple frames, and reach its completion event in the same document session."
    }
  },
