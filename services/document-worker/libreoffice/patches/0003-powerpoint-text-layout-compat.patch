 namespace {

+// EEControlBits::FIXEDCELLFONTMETRICBASELINE
+// A fixed cell line box is 1.2 times the font height. PowerPoint splits that
+// box between ascent and descent by the font's hhea metrics instead of placing
+// the baseline at 1.0 em. Artificially emboldened fonts and fonts whose ratio is
+// more than 10% away from the 1.0 em baseline keep the default behaviour.
+bool CalculateFontMetricFixedCellAscent(OutputDevice& rDevice, sal_uInt16 nLineHeight,
+                                        sal_uInt16 nFontHeight, sal_uInt16& rAscent)
+{
+    if (nFontHeight == 0)
+        return false;
+
+    tools::Long nHheaAscent = 0;
+    tools::Long nHheaDescent = 0;
+    bool bArtificialBold = false;
+    if (!rDevice.GetFontHheaMetrics(nHheaAscent, nHheaDescent, bArtificialBold)
+        || bArtificialBold)
+        return false;
+
+    if (nHheaAscent <= 0 || nHheaDescent >= 0)
+        return false;
+
+    const sal_Int64 nMetricHeight
+        = static_cast<sal_Int64>(nHheaAscent) - static_cast<sal_Int64>(nHheaDescent);
+    const sal_Int64 nTargetAscent
+        = (static_cast<sal_Int64>(nLineHeight) * nHheaAscent + nMetricHeight / 2)
+          / nMetricHeight;
+    if (nTargetAscent < 0 || nTargetAscent > nLineHeight)
+        return false;
+
+    const sal_Int64 nDifference
+        = std::abs(static_cast<sal_Int64>(nFontHeight) - nTargetAscent);
+    if (nDifference * 10 > nFontHeight)
+        return false;
+
+    rAscent = static_cast<sal_uInt16>(nTargetAscent);
+    return true;
+}
+
+bool IsGlueCharacter(sal_Unicode c)
+{
+    switch (c)
+    {
+        case 0x0001: // CH_FEATURE
+        case 0x00A0: // No-break Space
+        case 0x2011: // Non-breaking Hyphen
+        case 0x202F: // Narrow No-break Space
+        case 0x2060: // Word Joiner
+        case 0xFEFF: // NWNBSP
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Korean's BreakIterator protects whole words by default. PPTX character-cell
+// wrapping relaxes that rule between Hangul cells; it must not replace normal
+// Latin word wrapping (e.g. DANCE must not become DA / NCE just to fill a line).
+bool IsHangulCell(sal_Unicode c)
+{
+    return (c >= 0x1100 && c <= 0x11ff)
+           || (c >= 0x3130 && c <= 0x318f)
+           || (c >= 0xa960 && c <= 0xa97f)
+           || (c >= 0xac00 && c <= 0xd7a3)
+           || (c >= 0xd7b0 && c <= 0xd7ff);
+}
+
+// EEControlBits::WORDSPLITWITHOUTHYPHEN: Korean compatibility only.
+// Returns the last character cell boundary in (nBreakPos, nMaxBreakPos] where
+// the line may end without a hyphen, or nBreakPos when there is none. Forbidden
+// begin/end characters and glue characters are respected.
+sal_Int32 FindWordSplitPosition(const OUString& rText,
+                                const css::uno::Reference<css::i18n::XBreakIterator>& rBI,
+                                const css::lang::Locale& rLocale,
+                                const css::i18n::LineBreakUserOptions& rOptions,
+                                sal_Int32 nMinBreakPos, sal_Int32 nBreakPos,
+                                sal_Int32 nMaxBreakPos)
+{
+    sal_Int32 nPos = nMaxBreakPos;
+    while (nPos > nBreakPos && nPos > nMinBreakPos && nPos < rText.getLength())
+    {
+        sal_Int32 nDone = 0;
+        const sal_Int32 nCellStart = rBI->previousCharacters(
+            rText, nPos, rLocale, css::i18n::CharacterIteratorMode::SKIPCELL, 1, nDone);
+        if (nDone != 1 || nCellStart < nMinBreakPos)
+            break;
+        const sal_Int32 nCellEnd = rBI->nextCharacters(
+            rText, nCellStart, rLocale, css::i18n::CharacterIteratorMode::SKIPCELL, 1, nDone);
+        if (nCellEnd != nPos)
+        {
+            // nPos is inside a character cell; retry at its start
+            nPos = nCellStart;
+            continue;
+        }
+
+        const sal_Unicode cBefore = rText[nPos - 1];
+        const sal_Unicode cAfter = rText[nPos];
+        const bool bForbidden
+            = rOptions.applyForbiddenRules
+              && (rOptions.forbiddenEndCharacters.indexOf(cBefore) >= 0
+                  || rOptions.forbiddenBeginCharacters.indexOf(cAfter) >= 0);
+        if (!bForbidden && IsHangulCell(cBefore) && IsHangulCell(cAfter)
+            && !IsGlueCharacter(cBefore) && !IsGlueCharacter(cAfter))
+            return nPos;
+
+        nPos = nCellStart;
+    }
+    return nBreakPos;
+}
