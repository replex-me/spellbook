+bool OutputDevice::GetFontHheaMetrics(tools::Long& rAscent, tools::Long& rDescent,
+                                      bool& rArtificialBold) const
+{
+    if (!ImplNewFont())
+        return false;
+
+    const LogicalFontInstance* pFontInstance = mpFontInstance.get();
+    const FontMetricDataRef& xFontMetric = pFontInstance->mxFontMetric;
+    if (!xFontMetric)
+        return false;
+
+    rAscent = xFontMetric->GetHheaAscent();
+    rDescent = xFontMetric->GetHheaDescent();
+    rArtificialBold = pFontInstance->NeedsArtificialBold();
+    return true;
+}
