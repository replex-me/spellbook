ARG SPELLBOOK_DOCUMENT_WORKER_BASE_IMAGE=spellbook-document-worker:office-fonts
FROM ${SPELLBOOK_DOCUMENT_WORKER_BASE_IMAGE}

ARG SPELLBOOK_LIBREOFFICE_ENGINE_SHA256

USER root
COPY libmergedlo.so libmergedlo.so.sha256 libsdlo.so libsdlo.so.sha256 /tmp/spellbook-engine/
COPY MANIFEST.txt /usr/share/doc/spellbook-libreoffice-engine/MANIFEST.txt
COPY COPYING.MPL /usr/share/doc/spellbook-libreoffice-engine/COPYING.MPL
COPY 0001-oox-powerpoint-text-import.patch \
    /usr/share/doc/spellbook-libreoffice-engine/0001-oox-powerpoint-text-import.patch
COPY 0002-fix-source-tarball-module-symlinks.patch \
    /usr/share/doc/spellbook-libreoffice-engine/0002-fix-source-tarball-module-symlinks.patch
COPY 0003-powerpoint-text-layout-compat.patch \
    /usr/share/doc/spellbook-libreoffice-engine/0003-powerpoint-text-layout-compat.patch
COPY 0004-hangul-glyph-fallback-language.patch \
    /usr/share/doc/spellbook-libreoffice-engine/0004-hangul-glyph-fallback-language.patch
# The merged library carries the import and layout changes; libsdlo.so carries the
# PPTX import hook that enables the compatibility flags. Both are verified by hash,
# and the presence of the new entry points is checked before installation.
RUN test -n "${SPELLBOOK_LIBREOFFICE_ENGINE_SHA256}" \
    && cd /tmp/spellbook-engine \
    && echo "${SPELLBOOK_LIBREOFFICE_ENGINE_SHA256}  libmergedlo.so" | sha256sum --check --strict \
    && sha256sum --check --strict libmergedlo.so.sha256 libsdlo.so.sha256 \
    && grep --binary-files=text --quiet 'GetFontHheaMetrics' libmergedlo.so \
    && grep --binary-files=text --quiet 'SPELLBOOK_POWERPOINT_COMPAT' libsdlo.so \
    && install --mode=0755 libmergedlo.so /opt/libreoffice26.8/program/libmergedlo.so \
    && install --mode=0755 libsdlo.so /opt/libreoffice26.8/program/libsdlo.so \
    && cd / && rm -rf /tmp/spellbook-engine \
    && if ldd /opt/libreoffice26.8/program/libmergedlo.so | grep --fixed-strings 'not found'; then exit 1; fi \
    && if ldd /opt/libreoffice26.8/program/libsdlo.so | grep --fixed-strings 'not found'; then exit 1; fi \
    && soffice --version | grep --fixed-strings 'LibreOffice 26.8.0.3'

# PowerPoint text layout compatibility is enabled by the PPTX importer inside the
# engine. SPELLBOOK_POWERPOINT_COMPAT=0 disables it for control experiments only.
# The Python UNO post-processing paths stay off; layout rules live in the engine.
ENV SPELLBOOK_POWERPOINT_COMPAT=1 \
    SPELLBOOK_DISABLE_CJK_SCRIPT_SPACING=0 \
    SPELLBOOK_POWERPOINT_METRIC_BASELINE=0 \
    SPELLBOOK_LIBREOFFICE_ENGINE_SHA256=${SPELLBOOK_LIBREOFFICE_ENGINE_SHA256}

LABEL org.opencontainers.image.title="Spellbook patched LibreOffice engine" \
      org.opencontainers.image.licenses="MPL-2.0" \
      me.replex.spellbook.libreoffice-engine-sha256=${SPELLBOOK_LIBREOFFICE_ENGINE_SHA256}

USER 1000:1000
