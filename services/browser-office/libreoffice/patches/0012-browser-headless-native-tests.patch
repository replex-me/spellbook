+    void loadSdImpressDocModelOnly(const OUString& rURL)
+    {
+        if (mxComponent.is())
+        {
+            mxComponent->dispose();
+            mxComponent.clear();
+        }
+        uno::Reference<uno::XInterface> xModelInstance
+            = getMultiServiceFactory()->createInstance(
+                u"com.sun.star.comp.Draw.PresentationDocument"_ustr);
+        uno::Reference<frame::XLoadable> xLoadable(xModelInstance, uno::UNO_QUERY_THROW);
+        if (rURL.isEmpty())
+            xLoadable->initNew();
+        else
+            xLoadable->load({ comphelper::makePropertyValue(u"URL"_ustr, rURL) });
+        mxComponent.set(xModelInstance, uno::UNO_QUERY_THROW);
+        uno::Reference<lang::XServiceInfo> xServiceInfo(mxComponent, uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT(
+            xServiceInfo->supportsService("com.sun.star.presentation.PresentationDocument"));
+        CPPUNIT_ASSERT(!getSdDocShell()->GetMedium()->GetWarningError());
+    }
+
+    void createSdImpressDocModelOnly(const char* pName = nullptr)
+    {
+        loadSdImpressDocModelOnly(
+            pName ? createFileURL(OUString::createFromAscii(pName)) : OUString());
+    }
+
+    void saveAndReloadSdImpressDocModelOnly(const OUString& rFilter)
+    {
+        save(rFilter);
+        loadSdImpressDocModelOnly(maTempFile.GetURL());
+    }
