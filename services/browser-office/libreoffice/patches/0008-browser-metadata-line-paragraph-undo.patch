+struct PageMetadataState
+{
+    sd::HeaderFooterSettings maHeaderFooter;
+    double mfHighResolutionDuration = 0.0;
+    bool mbBackgroundObjectsVisible = false;
+
+    bool operator==(const PageMetadataState& rOther) const
+    {
+        return maHeaderFooter == rOther.maHeaderFooter
+               && mfHighResolutionDuration == rOther.mfHighResolutionDuration
+               && mbBackgroundObjectsVisible == rOther.mbBackgroundObjectsVisible;
+    }
+};
+
+PageMetadataState getPageMetadata(SdDrawDocument& rDocument, SdPage& rPage)
+{
+    SdrLayerAdmin& rLayerAdmin = rDocument.GetLayerAdmin();
+    const SdrLayerID aBackgroundObjects
+        = rLayerAdmin.GetLayerID(sUNO_LayerName_background_objects);
+    return {
+        rPage.getHeaderFooterSettings(),
+        rPage.GetTime(),
+        rPage.TRG_GetMasterPageVisibleLayers().IsSet(aBackgroundObjects),
+    };
+}
+
+void setPageMetadata(SdDrawDocument& rDocument, SdPage& rPage,
+                     const PageMetadataState& rState)
+{
+    rPage.setHeaderFooterSettings(rState.maHeaderFooter);
+    rPage.SetTime(rState.mfHighResolutionDuration);
+    SdrLayerAdmin& rLayerAdmin = rDocument.GetLayerAdmin();
+    const SdrLayerID aBackgroundObjects
+        = rLayerAdmin.GetLayerID(sUNO_LayerName_background_objects);
+    SdrLayerIDSet aVisibleLayers = rPage.TRG_GetMasterPageVisibleLayers();
+    aVisibleLayers.Set(aBackgroundObjects, rState.mbBackgroundObjectsVisible);
+    rPage.TRG_SetMasterPageVisibleLayers(aVisibleLayers);
+    rPage.ActionChanged();
+    rDocument.SetChanged();
+}
+
+class PageMetadataUndoAction final : public SdUndoAction
+{
+public:
+    PageMetadataUndoAction(SdDrawDocument& rDocument, SdPage& rPage,
+                           PageMetadataState aOldState,
+                           PageMetadataState aNewState)
+        : SdUndoAction(&rDocument)
+        , mrPage(rPage)
+        , maOldState(std::move(aOldState))
+        , maNewState(std::move(aNewState))
+    {
+    }
+
+    void Undo() override { setPageMetadata(*mpDoc, mrPage, maOldState); }
+    void Redo() override { setPageMetadata(*mpDoc, mrPage, maNewState); }
+
+private:
+    SdPage& mrPage;
+    PageMetadataState maOldState;
+    PageMetadataState maNewState;
+};
