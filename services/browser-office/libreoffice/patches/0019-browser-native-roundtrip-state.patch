     pDrawDocument->EndUndo();
     CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
@@ -1830,11 +1837,11 @@
         CPPUNIT_ASSERT_EQUAL(nExpectedKerning, nKerning);
         CPPUNIT_ASSERT_DOUBLES_EQUAL(fExpectedWeight, fWeight, 0.01);
     };
-    assertTextProperties(20, 150.0);
