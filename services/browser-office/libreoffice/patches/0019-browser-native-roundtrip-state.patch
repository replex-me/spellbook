+    CPPUNIT_ASSERT(std::abs(pPage->GetSize().Width() - 30000) <= 1);
+    CPPUNIT_ASSERT(std::abs(pPage->GetSize().Height() - 17000) <= 1);
+    CPPUNIT_ASSERT(std::abs(pMaster->GetSize().Width() - 30000) <= 1);
+    CPPUNIT_ASSERT(std::abs(pMaster->GetSize().Height() - 17000) <= 1);
     CPPUNIT_ASSERT_EQUAL(sal_Int32(1), pPage->getMainSequence()->getCount());
     assertTheme();
 }
diff --git a/sd/source/ui/unoidl/unoobj.cxx b/sd/source/ui/unoidl/unoobj.cxx
--- a/sd/source/ui/unoidl/unoobj.cxx
+++ b/sd/source/ui/unoidl/unoobj.cxx
@@ -306,7 +306,19 @@
     {
         if (!mxObject)
             return;
-        mxObject->setMediaProperties(rMedia);
+        // MediaItem applies only fields in its mask. A value that was never
+        // authored before this edit has no mask bit, so replaying the stored
+        // object alone cannot undo the first Loop, Mute or VolumeDB change.
+        avmedia::MediaItem aState(rMedia);
+        aState.setURL(rMedia.getURL(), rMedia.getTempURL(), rMedia.getReferer());
+        aState.setMimeType(rMedia.getMimeType());
+        aState.setGraphic(rMedia.getGraphic());
+        aState.setCrop(rMedia.getCrop());
+        aState.setLoop(rMedia.isLoop());
+        aState.setMute(rMedia.isMute());
+        aState.setVolumeDB(rMedia.getVolumeDB());
+        aState.setZoom(rMedia.getZoom());
+        mxObject->setMediaProperties(aState);
         mxObject->SetChanged();
         mxObject->BroadcastObjectChange();
     }
