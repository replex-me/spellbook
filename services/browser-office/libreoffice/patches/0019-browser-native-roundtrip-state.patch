     pUndoManager->Undo();
     assertTextProperties(nOriginalKerning, fOriginalWeight);
     pUndoManager->Redo();
-    assertTextProperties(20, 150.0);
+    assertTextProperties(nStoredKerning, 150.0);
 
     auto getNotesText = [](const uno::Reference<drawing::XDrawPage>& xSlide) {
         uno::Reference<presentation::XPresentationPage> xPresentationPage(
@@ -2070,9 +2077,12 @@
         uno::UNO_QUERY_THROW);
     // A model-only document has no installed UI palette. Supply the named
     // resources that a real document must carry for named line styles.
-    const OUString aDashName = u"Fine Dashed"_ustr;
-    const OUString aStartName = u"Arrow"_ustr;
-    const OUString aEndName = u"Square"_ustr;
+    const OUString aDashName = u"Spellbook Native Dash"_ustr;
+    const OUString aStartName = u"Spellbook Native Start"_ustr;
+    const OUString aEndName = u"Spellbook Native End"_ustr;
+    CPPUNIT_ASSERT(!xDashTable->hasByName(aDashName));
+    CPPUNIT_ASSERT(!xMarkerTable->hasByName(aStartName));
+    CPPUNIT_ASSERT(!xMarkerTable->hasByName(aEndName));
     drawing::LineDash aDash;
     aDash.Style = drawing::DashStyle_RECT;
     aDash.Dots = 1;
@@ -2375,7 +2385,13 @@
     pPage = pDrawDocument->GetSdPage(0, PageKind::Standard);
     pMaster = pDrawDocument->GetMasterSdPage(0, PageKind::Standard);
     CPPUNIT_ASSERT(pPage && pMaster);
-    CPPUNIT_ASSERT_EQUAL(Size(30000, 17000), pPage->GetSize());
+    // PPTX export maps 1/100 mm through PowerPoint's 1/576-inch master unit.
+    // The in-memory size is exact above; only the serialized size may lose
