+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookShapeAppearancePropertiesUseNativeUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent,
+                                                        uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.RectangleShape"),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(5000, 3000));
+    xShapes->add(xShape);
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+
+    sal_Int32 nOriginalLineColor = 0;
+    sal_Int32 nOriginalLineWidth = 0;
+    sal_Int16 nOriginalFillTransparence = 0;
+    sal_Int16 nOriginalLineTransparence = 0;
+    sal_Int32 nOriginalRotateAngle = 0;
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("LineColor") >>= nOriginalLineColor);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("LineWidth") >>= nOriginalLineWidth);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("FillTransparence")
+                   >>= nOriginalFillTransparence);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("LineTransparence")
+                   >>= nOriginalLineTransparence);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("RotateAngle") >>= nOriginalRotateAngle);
+
+    auto assertAppearance = [&](sal_Int32 nLineColor, sal_Int32 nLineWidth,
+                                sal_Int16 nFillTransparence,
+                                sal_Int16 nLineTransparence, sal_Int32 nRotateAngle) {
+        sal_Int32 nActualLineColor = 0;
+        sal_Int32 nActualLineWidth = 0;
+        sal_Int16 nActualFillTransparence = 0;
+        sal_Int16 nActualLineTransparence = 0;
+        sal_Int32 nActualRotateAngle = 0;
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("LineColor") >>= nActualLineColor);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("LineWidth") >>= nActualLineWidth);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("FillTransparence")
+                       >>= nActualFillTransparence);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("LineTransparence")
+                       >>= nActualLineTransparence);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("RotateAngle") >>= nActualRotateAngle);
+        CPPUNIT_ASSERT_EQUAL(nLineColor, nActualLineColor);
+        CPPUNIT_ASSERT_EQUAL(nLineWidth, nActualLineWidth);
+        CPPUNIT_ASSERT_EQUAL(nFillTransparence, nActualFillTransparence);
+        CPPUNIT_ASSERT_EQUAL(nLineTransparence, nActualLineTransparence);
+        CPPUNIT_ASSERT_EQUAL(nRotateAngle, nActualRotateAngle);
+    };
+
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser shape appearance");
+    xProperties->setPropertyValue("LineColor", uno::Any(sal_Int32(0x123456)));
+    xProperties->setPropertyValue("LineWidth", uno::Any(sal_Int32(200)));
+    xProperties->setPropertyValue("FillTransparence", uno::Any(sal_Int16(37)));
+    xProperties->setPropertyValue("LineTransparence", uno::Any(sal_Int16(43)));
+    xProperties->setPropertyValue("RotateAngle", uno::Any(sal_Int32(1500)));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    assertAppearance(0x123456, 200, 37, 43, 1500);
+
+    pUndoManager->Undo();
+    assertAppearance(nOriginalLineColor, nOriginalLineWidth,
+                     nOriginalFillTransparence, nOriginalLineTransparence,
+                     nOriginalRotateAngle);
+    pUndoManager->Redo();
+    assertAppearance(0x123456, 200, 37, 43, 1500);
+}
