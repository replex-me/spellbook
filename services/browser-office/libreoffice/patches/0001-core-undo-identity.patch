diff --git a/svx/source/svdraw/svdmodel.cxx b/svx/source/svdraw/svdmodel.cxx
index 90fc769..ca5ee35 100644
--- a/svx/source/svdraw/svdmodel.cxx
+++ b/svx/source/svdraw/svdmodel.cxx
@@ -1223,7 +1223,14 @@ void SdrModel::MovePage(sal_uInt16 nPgNum, sal_uInt16 nNewPos)
         maPages.erase(maPages.begin()+nPgNum); // shortcut to avoid two broadcasts
         PageListChanged();
         pPg->SetInserted(false);
+        // A move re-inserts the same page; it does not introduce copied
+        // objects.  Running the insertion-time uniqueness pass here can rename
+        // existing shapes, and a sequence of moves then cannot round-trip
+        // through Undo without changing object identity metadata.
+        const bool bMakeNamesUnique = DoesMakePageObjectsNamesUnique();
+        DoMakePageObjectsNamesUnique(false);
         InsertPage(pPg.get(), nNewPos);
+        DoMakePageObjectsNamesUnique(bMakeNamesUnique);
     }
     else
         RemovePage(nPgNum);
