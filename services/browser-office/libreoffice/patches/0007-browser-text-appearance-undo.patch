+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookTextAppearancePropertiesUseNativeUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent,
+                                                        uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.TextShape"),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(8000, 3000));
+    xShapes->add(xShape);
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString("Alpha Beta");
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+    xCursor->gotoStart(false);
+    xCursor->gotoEnd(true);
+    uno::Reference<beans::XPropertySet> xProperties(xCursor, uno::UNO_QUERY_THROW);
+
+    sal_Int16 nOriginalUnderline = 0;
+    sal_Int16 nOriginalStrikeout = 0;
+    sal_Int32 nOriginalColor = 0;
+    style::ParagraphAdjust eOriginalAdjust = style::ParagraphAdjust_LEFT;
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("CharUnderline") >>= nOriginalUnderline);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("CharStrikeout") >>= nOriginalStrikeout);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("CharColor") >>= nOriginalColor);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("ParaAdjust") >>= eOriginalAdjust);
+
+    auto assertAppearance = [&](sal_Int16 nUnderline, sal_Int16 nStrikeout,
+                                sal_Int32 nColor, style::ParagraphAdjust eAdjust) {
+        xCursor = xText->createTextCursor();
+        xCursor->gotoStart(false);
+        xCursor->gotoEnd(true);
+        xProperties.set(xCursor, uno::UNO_QUERY_THROW);
+        sal_Int16 nActualUnderline = 0;
+        sal_Int16 nActualStrikeout = 0;
+        sal_Int32 nActualColor = 0;
+        style::ParagraphAdjust eActualAdjust = style::ParagraphAdjust_LEFT;
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("CharUnderline") >>= nActualUnderline);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("CharStrikeout") >>= nActualStrikeout);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("CharColor") >>= nActualColor);
+        CPPUNIT_ASSERT(xProperties->getPropertyValue("ParaAdjust") >>= eActualAdjust);
+        CPPUNIT_ASSERT_EQUAL(nUnderline, nActualUnderline);
+        CPPUNIT_ASSERT_EQUAL(nStrikeout, nActualStrikeout);
+        CPPUNIT_ASSERT_EQUAL(nColor, nActualColor);
+        CPPUNIT_ASSERT_EQUAL(eAdjust, eActualAdjust);
+    };
+
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser text appearance");
+    xProperties->setPropertyValue("CharUnderline", uno::Any(sal_Int16(1)));
+    xProperties->setPropertyValue("CharStrikeout", uno::Any(sal_Int16(1)));
+    xProperties->setPropertyValue("CharColor", uno::Any(sal_Int32(0x123456)));
+    xProperties->setPropertyValue("ParaAdjust", uno::Any(style::ParagraphAdjust_CENTER));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    assertAppearance(1, 1, 0x123456, style::ParagraphAdjust_CENTER);
+
+    pUndoManager->Undo();
+    assertAppearance(nOriginalUnderline, nOriginalStrikeout, nOriginalColor,
+                     eOriginalAdjust);
+    pUndoManager->Redo();
+    assertAppearance(1, 1, 0x123456, style::ParagraphAdjust_CENTER);
+
+    saveAndReload("Impress Office Open XML");
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPage.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xShapes.set(xPage, uno::UNO_QUERY_THROW);
+    xShape.set(xShapes->getByIndex(0), uno::UNO_QUERY_THROW);
+    xText.set(xShape, uno::UNO_QUERY_THROW);
+    assertAppearance(1, 1, 0x123456, style::ParagraphAdjust_CENTER);
+}
