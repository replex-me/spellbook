+class PageVisibilityUndoAction final : public SdUndoAction
+{
+public:
+    PageVisibilityUndoAction(SdDrawDocument& rDocument, SdPage& rPage,
+                             bool bOldVisible, bool bNewVisible)
+        : SdUndoAction(&rDocument)
+        , mrPage(rPage)
+        , mbOldVisible(bOldVisible)
+        , mbNewVisible(bNewVisible)
+    {
+    }
+
+    void Undo() override { apply(mbOldVisible); }
+    void Redo() override { apply(mbNewVisible); }
+
+private:
+    void apply(bool bVisible)
+    {
+        mrPage.SetExcluded(!bVisible);
+        mpDoc->SetChanged();
+    }
+
+    SdPage& mrPage;
+    bool mbOldVisible;
+    bool mbNewVisible;
+};
+
+class PageNameUndoAction final : public SdUndoAction
+{
+public:
+    PageNameUndoAction(SdDrawDocument& rDocument, SdPage& rPage,
+                       OUString aOldName, OUString aNewName)
+        : SdUndoAction(&rDocument)
+        , mrPage(rPage)
+        , maOldName(std::move(aOldName))
+        , maNewName(std::move(aNewName))
+    {
+    }
+
+    void Undo() override { apply(maOldName); }
+    void Redo() override { apply(maNewName); }
+
+private:
+    void apply(const OUString& rName)
+    {
+        mrPage.SetName(rName);
+        if (mrPage.GetPageKind() == PageKind::Standard)
+        {
+            const sal_uInt16 nNotesPage = (mrPage.GetPageNum() - 1) >> 1;
+            if (SdPage* pNotes = mpDoc->GetSdPage(nNotesPage, PageKind::Notes))
+                pNotes->SetName(rName);
+        }
+        mpDoc->SetChanged();
+    }
+
+    SdPage& mrPage;
+    OUString maOldName;
+    OUString maNewName;
+};
