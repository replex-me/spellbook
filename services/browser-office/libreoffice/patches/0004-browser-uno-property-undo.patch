+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPagePropertiesUseNativeUnoUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<container::XNamed> xNamed(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xProperties(xPage, uno::UNO_QUERY_THROW);
+    const OUString aOriginalName = xNamed->getName();
+    double fOriginalDuration = 0.0;
+    xProperties->getPropertyValue("TransitionDuration") >>= fOriginalDuration;
+
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser page properties");
+    xNamed->setName("Browser page");
+    xProperties->setPropertyValue("Visible", uno::Any(false));
+    xProperties->setPropertyValue("TransitionType", uno::Any(sal_Int16(37)));
+    xProperties->setPropertyValue("TransitionSubtype", uno::Any(sal_Int16(101)));
+    xProperties->setPropertyValue("TransitionDirection", uno::Any(true));
+    xProperties->setPropertyValue("TransitionFadeColor", uno::Any(sal_Int32(0)));
+    xProperties->setPropertyValue("TransitionDuration", uno::Any(1.75));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    CPPUNIT_ASSERT_EQUAL(OUString("Browser page"), xNamed->getName());
+    bool bVisible = true;
+    xProperties->getPropertyValue("Visible") >>= bVisible;
+    CPPUNIT_ASSERT(!bVisible);
+    sal_Int16 nTransitionType = 0;
+    sal_Int16 nTransitionSubtype = 0;
+    bool bTransitionDirection = false;
+    sal_Int32 nTransitionFadeColor = -1;
+    xProperties->getPropertyValue("TransitionType") >>= nTransitionType;
+    xProperties->getPropertyValue("TransitionSubtype") >>= nTransitionSubtype;
+    xProperties->getPropertyValue("TransitionDirection") >>= bTransitionDirection;
+    xProperties->getPropertyValue("TransitionFadeColor") >>= nTransitionFadeColor;
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(37), nTransitionType);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(101), nTransitionSubtype);
+    CPPUNIT_ASSERT(bTransitionDirection);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), nTransitionFadeColor);
+    double fDuration = 0.0;
+    xProperties->getPropertyValue("TransitionDuration") >>= fDuration;
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.75, fDuration, 0.001);
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(aOriginalName, xNamed->getName());
+    xProperties->getPropertyValue("Visible") >>= bVisible;
+    CPPUNIT_ASSERT(bVisible);
+    xProperties->getPropertyValue("TransitionDuration") >>= fDuration;
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(fOriginalDuration, fDuration, 0.001);
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(OUString("Browser page"), xNamed->getName());
+    xProperties->getPropertyValue("Visible") >>= bVisible;
+    CPPUNIT_ASSERT(!bVisible);
+    xProperties->getPropertyValue("TransitionDuration") >>= fDuration;
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.75, fDuration, 0.001);
+
+    saveAndReload("Impress Office Open XML");
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPage.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xNamed.set(xPage, uno::UNO_QUERY_THROW);
+    xProperties.set(xPage, uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(OUString("Browser page"), xNamed->getName());
+    xProperties->getPropertyValue("Visible") >>= bVisible;
+    xProperties->getPropertyValue("TransitionType") >>= nTransitionType;
+    xProperties->getPropertyValue("TransitionSubtype") >>= nTransitionSubtype;
+    xProperties->getPropertyValue("TransitionDirection") >>= bTransitionDirection;
+    xProperties->getPropertyValue("TransitionFadeColor") >>= nTransitionFadeColor;
+    xProperties->getPropertyValue("TransitionDuration") >>= fDuration;
+    CPPUNIT_ASSERT(!bVisible);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(37), nTransitionType);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(101), nTransitionSubtype);
+    CPPUNIT_ASSERT(bTransitionDirection);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), nTransitionFadeColor);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.75, fDuration, 0.001);
+}
