+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookShapePropertiesUseNativeUnoUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent,
+                                                        uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.RectangleShape"),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(5000, 3000));
+    xShapes->add(xShape);
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    pUndoManager->Clear();
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+    sal_Int32 nOriginalMargin = 0;
+    bool bOriginalShadow = false;
+    bool bOriginalMoveProtect = false;
+    OUString aOriginalName;
+    OUString aOriginalTitle;
+    OUString aOriginalDescription;
+    bool bOriginalDecorative = false;
+    xProperties->getPropertyValue("Name") >>= aOriginalName;
+    xProperties->getPropertyValue("Title") >>= aOriginalTitle;
+    xProperties->getPropertyValue("Description") >>= aOriginalDescription;
+    xProperties->getPropertyValue("Decorative") >>= bOriginalDecorative;
+    xProperties->getPropertyValue("TextLeftDistance") >>= nOriginalMargin;
+    xProperties->getPropertyValue("Shadow") >>= bOriginalShadow;
+    xProperties->getPropertyValue("MoveProtect") >>= bOriginalMoveProtect;
+
+    pDrawDocument->BegUndo("Browser object properties");
+    xProperties->setPropertyValue("Name", uno::Any(OUString("Browser shape")));
+    xProperties->setPropertyValue("Title", uno::Any(OUString("Browser title")));
+    xProperties->setPropertyValue("Description", uno::Any(OUString("Browser description")));
+    xProperties->setPropertyValue("Decorative", uno::Any(true));
+    xProperties->setPropertyValue("TextLeftDistance", uno::Any(sal_Int32(420)));
+    xProperties->setPropertyValue("Shadow", uno::Any(true));
+    xProperties->setPropertyValue("MoveProtect", uno::Any(true));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+
+    auto assertProperties = [&](const OUString& rName, const OUString& rTitle,
+                                const OUString& rDescription, bool bDecorative,
+                                sal_Int32 nMargin, bool bShadow, bool bMoveProtect) {
+        OUString aActualName;
+        OUString aActualTitle;
+        OUString aActualDescription;
+        bool bActualDecorative = false;
+        sal_Int32 nActualMargin = 0;
+        bool bActualShadow = false;
+        bool bActualMoveProtect = false;
+        xProperties->getPropertyValue("Name") >>= aActualName;
+        xProperties->getPropertyValue("Title") >>= aActualTitle;
+        xProperties->getPropertyValue("Description") >>= aActualDescription;
+        xProperties->getPropertyValue("Decorative") >>= bActualDecorative;
+        xProperties->getPropertyValue("TextLeftDistance") >>= nActualMargin;
+        xProperties->getPropertyValue("Shadow") >>= bActualShadow;
+        xProperties->getPropertyValue("MoveProtect") >>= bActualMoveProtect;
+        CPPUNIT_ASSERT_EQUAL(rName, aActualName);
+        CPPUNIT_ASSERT_EQUAL(rTitle, aActualTitle);
+        CPPUNIT_ASSERT_EQUAL(rDescription, aActualDescription);
+        CPPUNIT_ASSERT_EQUAL(bDecorative, bActualDecorative);
+        CPPUNIT_ASSERT_EQUAL(nMargin, nActualMargin);
+        CPPUNIT_ASSERT_EQUAL(bShadow, bActualShadow);
+        CPPUNIT_ASSERT_EQUAL(bMoveProtect, bActualMoveProtect);
+    };
+    assertProperties("Browser shape", "Browser title", "Browser description", true,
+                     420, true, true);
+    pUndoManager->Undo();
+    assertProperties(aOriginalName, aOriginalTitle, aOriginalDescription,
+                     bOriginalDecorative, nOriginalMargin, bOriginalShadow,
+                     bOriginalMoveProtect);
+    pUndoManager->Redo();
+    assertProperties("Browser shape", "Browser title", "Browser description", true,
+                     420, true, true);
+
+    saveAndReload("Impress Office Open XML");
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPage.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xShapes.set(xPage, uno::UNO_QUERY_THROW);
+    xShape.set(xShapes->getByIndex(0), uno::UNO_QUERY_THROW);
+    xProperties.set(xShape, uno::UNO_QUERY_THROW);
+    assertProperties("Browser shape", "Browser title", "Browser description", true,
+                     420, true, true);
+}
