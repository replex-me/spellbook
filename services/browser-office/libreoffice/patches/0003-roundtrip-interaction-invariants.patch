+    uno::Reference<drawing::XShapes> xShapes(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+
+    auto addShape = [&](const OUString& rName, const awt::Point& rPosition) {
+        uno::Reference<drawing::XShape> xShape(
+            xFactory->createInstance("com.sun.star.drawing.RectangleShape"),
+            uno::UNO_QUERY_THROW);
+        xShape->setPosition(rPosition);
+        xShape->setSize(awt::Size(5000, 3000));
+        uno::Reference<container::XNamed>(xShape, uno::UNO_QUERY_THROW)->setName(rName);
+        xShapes->add(xShape);
+        return xShape;
+    };
+
+    uno::Reference<drawing::XShape> xMoveLocked
+        = addShape("Move locked", awt::Point(1000, 1000));
+    uno::Reference<beans::XPropertySet> xMoveProperties(xMoveLocked, uno::UNO_QUERY_THROW);
+    xMoveProperties->setPropertyValue("MoveProtect", uno::Any(true));
+    xMoveProperties->setPropertyValue("SizeProtect", uno::Any(false));
+
+    uno::Reference<drawing::XShape> xSizeLocked
+        = addShape("Size locked", awt::Point(7000, 1000));
+    uno::Reference<beans::XPropertySet> xSizeProperties(xSizeLocked, uno::UNO_QUERY_THROW);
+    xSizeProperties->setPropertyValue("MoveProtect", uno::Any(false));
+    xSizeProperties->setPropertyValue("SizeProtect", uno::Any(true));
+
+    saveAndReload("Impress Office Open XML");
+    xmlDocUniquePtr pXmlDoc = parseExport("ppt/slides/slide1.xml");
+    assertXPath(pXmlDoc, "//a:spLocks[@noMove='1' and not(@noResize)]", 1);
+    assertXPath(pXmlDoc, "//a:spLocks[@noResize='1' and not(@noMove)]", 1);
+
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPage.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    auto lockState = [&](const OUString& rName, const OUString& rProperty) {
+        for (sal_Int32 nIndex = 0; nIndex < xPage->getCount(); ++nIndex)
+        {
+            uno::Reference<drawing::XShape> xShape(xPage->getByIndex(nIndex),
+                                                   uno::UNO_QUERY_THROW);
+            uno::Reference<container::XNamed> xNamed(xShape, uno::UNO_QUERY);
+            if (!xNamed.is() || xNamed->getName() != rName)
+                continue;
+            bool bValue = false;
+            uno::Reference<beans::XPropertySet>(xShape, uno::UNO_QUERY_THROW)
+                ->getPropertyValue(rProperty) >>= bValue;
+            return bValue;
+        }
+        CPPUNIT_FAIL("Expected named shape after PPTX reload");
+        return false;
+    };
+    CPPUNIT_ASSERT(lockState("Move locked", "MoveProtect"));
+    CPPUNIT_ASSERT(!lockState("Move locked", "SizeProtect"));
+    CPPUNIT_ASSERT(!lockState("Size locked", "MoveProtect"));
+    CPPUNIT_ASSERT(lockState("Size locked", "SizeProtect"));
+}
