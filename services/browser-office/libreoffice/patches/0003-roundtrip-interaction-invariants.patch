+void SdMiscTest::testSpellbookTableCellPropertyUnoUndo()
+{
+    createSdImpressDoc("tdf99396.odp");
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdPage* pPage = pDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    auto pTableObject = dynamic_cast<sdr::table::SdrTableObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTableObject);
+    uno::Reference<table::XTable> xTable = pTableObject->getTable();
+    uno::Reference<beans::XPropertySet> xCell(
+        xTable->getCellByPosition(0, 0), uno::UNO_QUERY_THROW);
+    sal_Int32 nOriginalColor = 0;
+    xCell->getPropertyValue("FillColor") >>= nOriginalColor;
+    const sal_Int32 nChangedColor
+        = nOriginalColor == sal_Int32(0x00ff00) ? sal_Int32(0x0000ff)
+                                                : sal_Int32(0x00ff00);
+    SfxUndoManager* pUndoManager = pDocument->GetDoc()->GetUndoManager();
+    pUndoManager->Clear();
+
+    xCell->setPropertyValue("FillColor", uno::Any(nChangedColor));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    sal_Int32 nCurrentColor = 0;
+    xCell->getPropertyValue("FillColor") >>= nCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nChangedColor, nCurrentColor);
+
+    pUndoManager->Undo();
+    xCell->getPropertyValue("FillColor") >>= nCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nOriginalColor, nCurrentColor);
+    pUndoManager->Redo();
+    xCell->getPropertyValue("FillColor") >>= nCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nChangedColor, nCurrentColor);
+}
