+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.RectangleShape"),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(5000, 3000));
+    uno::Reference<container::XNamed>(xShape, uno::UNO_QUERY_THROW)
+        ->setName("Interactive shape");
+    xShapes->add(xShape);
+
+    SdrObject* pObject = SdrObject::getSdrObjectFromXShape(xShape);
+    CPPUNIT_ASSERT(pObject);
+    SdAnimationInfo* pInfo = SdDrawDocument::GetShapeUserData(*pObject, true);
+    pInfo->mbDimHide = true;
+    pInfo->mnVerb = 42;
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    pUndoManager->Clear();
+
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+    pDrawDocument->BegUndo("Set object interaction");
+    xProperties->setPropertyValue(
+        "OnClick", uno::Any(presentation::ClickAction_DOCUMENT));
+    xProperties->setPropertyValue(
+        "Bookmark", uno::Any(OUString("https://example.invalid/presentation")));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+
+    auto assertInteraction = [&](presentation::ClickAction eExpected,
+                                 const OUString& rExpectedBookmark) {
+        presentation::ClickAction eActual = presentation::ClickAction_NONE;
+        OUString aActualBookmark;
+        xProperties->getPropertyValue("OnClick") >>= eActual;
+        xProperties->getPropertyValue("Bookmark") >>= aActualBookmark;
