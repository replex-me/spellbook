+void ShapeExport::WriteShapeLocks(const Reference<XShape>& xShape, sal_Int32 nLockToken)
+{
+    if (GetDocumentType() != DOCUMENT_PPTX)
+        return;
+
+    Reference<XPropertySet> xProperties(xShape, UNO_QUERY);
+    if (!xProperties.is())
+        return;
+
+    bool bMoveProtected = false;
+    if (GetProperty(xProperties, u"MoveProtect"_ustr))
+        mAny >>= bMoveProtected;
+    bool bSizeProtected = false;
+    if (GetProperty(xProperties, u"SizeProtect"_ustr))
+        mAny >>= bSizeProtected;
+    if (!bMoveProtected && !bSizeProtected)
+        return;
+
+    GetFS()->singleElementNS(XML_a, nLockToken,
+                             XML_noMove, sax_fastparser::UseIf("1", bMoveProtected),
+                             XML_noResize, sax_fastparser::UseIf("1", bSizeProtected));
+}
