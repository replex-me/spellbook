+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxObjectLocksRoundTrip)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
