+class ObjectInteractionUndoAction final : public SdUndoAction
+{
+public:
+    ObjectInteractionUndoAction(
+        SdDrawDocument& rDocument, SdrObject& rObject, bool bHadOldInfo,
+        presentation::ClickAction eOldAction, const OUString& rOldBookmark,
+        presentation::ClickAction eNewAction, const OUString& rNewBookmark)
+        : SdUndoAction(&rDocument)
+        , mrObject(rObject)
+        , mbHadOldInfo(bHadOldInfo)
+        , meOldAction(eOldAction)
+        , maOldBookmark(rOldBookmark)
+        , meNewAction(eNewAction)
+        , maNewBookmark(rNewBookmark)
+    {
+    }
+
+    void Undo() override
+    {
+        if (mbHadOldInfo)
+            apply(meOldAction, maOldBookmark);
+        else
+            removeCreatedInfo();
+    }
+
+    void Redo() override { apply(meNewAction, maNewBookmark); }
+
+private:
+    void apply(presentation::ClickAction eAction, const OUString& rBookmark)
+    {
+        SdAnimationInfo* pInfo = SdDrawDocument::GetShapeUserData(mrObject, true);
+        pInfo->meClickAction = eAction;
+        pInfo->SetBookmark(rBookmark);
+        mrObject.SetChanged();
+        mrObject.BroadcastObjectChange();
+    }
+
+    void removeCreatedInfo()
+    {
+        if (SdAnimationInfo* pInfo = SdDrawDocument::GetShapeUserData(mrObject, false))
+            pInfo->SetBookmark(OUString());
+        for (sal_uInt16 nIndex = 0; nIndex < mrObject.GetUserDataCount(); ++nIndex)
+        {
+            SdrObjUserData* pData = mrObject.GetUserData(nIndex);
+            if (pData->GetInventor() == SdrInventor::StarDrawUserData
+                && pData->GetId() == SD_ANIMATIONINFO_ID)
+            {
+                mrObject.DeleteUserData(nIndex);
+                break;
+            }
+        }
+        mrObject.SetChanged();
+        mrObject.BroadcastObjectChange();
+    }
+
+    SdrObject& mrObject;
+    bool mbHadOldInfo;
+    presentation::ClickAction meOldAction;
+    OUString maOldBookmark;
+    presentation::ClickAction meNewAction;
+    OUString maNewBookmark;
+};
+
+void addObjectInteractionUndo(
+    SdDrawDocument* pDocument, SdrObject& rObject, bool bHadOldInfo,
+    presentation::ClickAction eOldAction, const OUString& rOldBookmark,
+    presentation::ClickAction eNewAction, const OUString& rNewBookmark)
+{
+    if (!pDocument || !pDocument->IsUndoEnabled()
+        || (eOldAction == eNewAction && rOldBookmark == rNewBookmark))
+        return;
+    pDocument->GetDocSh()->GetUndoManager()->AddUndoAction(
+        std::make_unique<ObjectInteractionUndoAction>(*pDocument, rObject, bHadOldInfo,
+            eOldAction, rOldBookmark, eNewAction, rNewBookmark), true);
+}
+}
