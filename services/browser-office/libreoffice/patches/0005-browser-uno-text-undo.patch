+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookUnoTextWritesUseNativeUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent,
+                                                        uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.TextShape"),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(8000, 3000));
+    xShapes->add(xShape);
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString("Alpha Beta");
+    pUndoManager->Clear();
+
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+    xCursor->gotoStart(false);
+    CPPUNIT_ASSERT(xCursor->goRight(5, true));
+    pDrawDocument->BegUndo("Browser text range");
+    xCursor->setString("Gamma");
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    CPPUNIT_ASSERT_EQUAL(OUString("Gamma Beta"), xText->getString());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(OUString("Alpha Beta"), xText->getString());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(OUString("Gamma Beta"), xText->getString());
+
+    pUndoManager->Clear();
+    xCursor = xText->createTextCursor();
+    xCursor->gotoStart(false);
+    xCursor->gotoEnd(true);
+    uno::Reference<beans::XPropertySet> xCursorProperties(xCursor,
+                                                          uno::UNO_QUERY_THROW);
+    sal_Int16 nOriginalKerning = 0;
+    float fOriginalWeight = 0.0;
+    xCursorProperties->getPropertyValue("CharKerning") >>= nOriginalKerning;
+    xCursorProperties->getPropertyValue("CharWeight") >>= fOriginalWeight;
+    pDrawDocument->BegUndo("Browser text properties");
+    xCursorProperties->setPropertyValue("CharKerning", uno::Any(sal_Int16(20)));
+    xCursorProperties->setPropertyValue("CharWeight", uno::Any(float(150.0)));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+
+    auto assertTextProperties = [&](sal_Int16 nExpectedKerning, float fExpectedWeight) {
+        xCursor = xText->createTextCursor();
+        xCursor->gotoStart(false);
+        xCursor->gotoEnd(true);
+        xCursorProperties.set(xCursor, uno::UNO_QUERY_THROW);
+        sal_Int16 nKerning = 0;
+        float fWeight = 0.0;
+        xCursorProperties->getPropertyValue("CharKerning") >>= nKerning;
+        xCursorProperties->getPropertyValue("CharWeight") >>= fWeight;
+        CPPUNIT_ASSERT_EQUAL(nExpectedKerning, nKerning);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(fExpectedWeight, fWeight, 0.01);
+    };
+    assertTextProperties(20, 150.0);
+    pUndoManager->Undo();
+    assertTextProperties(nOriginalKerning, fOriginalWeight);
+    pUndoManager->Redo();
+    assertTextProperties(20, 150.0);
+
+    auto getNotesText = [](const uno::Reference<drawing::XDrawPage>& xSlide) {
+        uno::Reference<presentation::XPresentationPage> xPresentationPage(
+            xSlide, uno::UNO_QUERY_THROW);
+        uno::Reference<drawing::XDrawPage> xNotesPage(
+            xPresentationPage->getNotesPage(), uno::UNO_SET_THROW);
+        uno::Reference<drawing::XShapes> xNotesShapes(xNotesPage, uno::UNO_QUERY_THROW);
+        for (sal_Int32 nShape = 0; nShape < xNotesShapes->getCount(); ++nShape)
+        {
+            uno::Reference<drawing::XShape> xNotesShape(
+                xNotesShapes->getByIndex(nShape), uno::UNO_QUERY_THROW);
+            if (xNotesShape->getShapeType().endsWith("NotesShape"))
+                return uno::Reference<text::XText>(xNotesShape, uno::UNO_QUERY_THROW);
+        }
+        return uno::Reference<text::XText>();
+    };
+    uno::Reference<text::XText> xNotesText = getNotesText(xPage);
+    CPPUNIT_ASSERT(xNotesText.is());
+    const OUString aOriginalNotes = xNotesText->getString();
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser speaker notes");
+    xNotesText->setString("Updated speaker notes");
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    CPPUNIT_ASSERT_EQUAL(OUString("Updated speaker notes"), xNotesText->getString());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(aOriginalNotes, xNotesText->getString());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(OUString("Updated speaker notes"), xNotesText->getString());
+
+    saveAndReload("Impress Office Open XML");
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPage.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xShapes.set(xPage, uno::UNO_QUERY_THROW);
+    xShape.set(xShapes->getByIndex(0), uno::UNO_QUERY_THROW);
+    xText.set(xShape, uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(OUString("Gamma Beta"), xText->getString());
+    assertTextProperties(20, 150.0);
+    xNotesText = getNotesText(xPage);
+    CPPUNIT_ASSERT(xNotesText.is());
+    CPPUNIT_ASSERT_EQUAL(OUString("Updated speaker notes"), xNotesText->getString());
+}
