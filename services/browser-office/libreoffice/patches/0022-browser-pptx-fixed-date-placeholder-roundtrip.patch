@@ -251,6 +251,21 @@ void PPTShape::addShape(
                                     return;
                                 }
                             }
                         }
+                        else
+                        {
+                            // A fixed date is serialized as a text run in a
+                            // slide-level date placeholder. Preserve its page
+                            // metadata just as the dynamic date field above is.
+                            const OUString aDateTimeText = getTextBody()->toString();
+                            if (!aDateTimeText.isEmpty())
+                            {
+                                Reference<XPropertySet> xPropertySet(rSlidePersist.getPage(), UNO_QUERY);
+                                xPropertySet->setPropertyValue("IsDateTimeVisible", Any(true));
+                                xPropertySet->setPropertyValue("IsDateTimeFixed", Any(true));
+                                xPropertySet->setPropertyValue("DateTimeText", Any(aDateTimeText));
+                                return;
+                            }
+                        }
                     }
                     sServiceName = "com.sun.star.presentation.DateTimeShape";
