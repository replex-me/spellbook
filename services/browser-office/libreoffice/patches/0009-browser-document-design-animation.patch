+class PageThemeUndoAction final : public SdUndoAction
+{
+public:
+    PageThemeUndoAction(SdDrawDocument& rDocument, SdPage& rMaster,
+                        std::shared_ptr<model::Theme> pOldTheme,
+                        std::shared_ptr<model::Theme> pNewTheme)
+        : SdUndoAction(&rDocument)
+        , mrMaster(rMaster)
+        , mpOldTheme(std::move(pOldTheme))
+        , mpNewTheme(std::move(pNewTheme))
+    {
+    }
+
+    void Undo() override { apply(mpOldTheme); }
+    void Redo() override { apply(mpNewTheme); }
+
+private:
+    void apply(const std::shared_ptr<model::Theme>& pTheme)
+    {
+        mrMaster.getSdrPageProperties().setTheme(
+            pTheme ? std::make_shared<model::Theme>(*pTheme) : nullptr);
+        mrMaster.ActionChanged();
+        for (sal_uInt16 nSlide = 0;
+             nSlide < mpDoc->GetSdPageCount(PageKind::Standard); ++nSlide)
+        {
+            SdPage* pSlide = mpDoc->GetSdPage(nSlide, PageKind::Standard);
+            if (pSlide && pSlide->TRG_HasMasterPage()
+                && &pSlide->TRG_GetMasterPage() == &mrMaster)
+                pSlide->ActionChanged();
+        }
+        mpDoc->SetChanged();
+    }
+
+    SdPage& mrMaster;
+    std::shared_ptr<model::Theme> mpOldTheme;
+    std::shared_ptr<model::Theme> mpNewTheme;
+};
+
+template <typename T>
+T requiredCommandValue(const comphelper::SequenceAsHashMap& rValues,
+                       std::u16string_view rName)
+{
+    const auto it = rValues.find(OUString(rName));
+    T aValue{};
+    if (it == rValues.end() || !(it->second >>= aValue))
+        throw lang::IllegalArgumentException(
+            u"Spellbook command field is missing or has the wrong type"_ustr,
+            nullptr, 0);
+    return aValue;
+}
+
+SdrObject* resolveCommandObject(SdPage& rPage, const OUString& rPath)
+{
+    if (rPath.isEmpty() || rPath.getLength() > 128)
+        throw lang::IllegalArgumentException(u"Invalid Spellbook object path"_ustr,
+                                              nullptr, 0);
+    SdrObjList* pList = &rPage;
+    SdrObject* pObject = nullptr;
+    sal_Int32 nTokenIndex = 0;
+    do
+    {
+        const OUString aToken = rPath.getToken(0, '/', nTokenIndex);
+        if (aToken.isEmpty())
+            throw lang::IllegalArgumentException(u"Invalid Spellbook object path"_ustr,
+                                                  nullptr, 0);
+        for (sal_Int32 nChar = 0; nChar < aToken.getLength(); ++nChar)
+            if (aToken[nChar] < '0' || aToken[nChar] > '9')
+                throw lang::IllegalArgumentException(
+                    u"Invalid Spellbook object path"_ustr, nullptr, 0);
+        const sal_Int64 nObjectIndex = aToken.toInt64();
+        if (nObjectIndex < 0
+            || nObjectIndex >= static_cast<sal_Int64>(pList->GetObjCount()))
+            throw lang::IllegalArgumentException(
+                u"Spellbook object path is out of range"_ustr, nullptr, 0);
+        pObject = pList->GetObj(static_cast<sal_uInt32>(nObjectIndex));
+        if (nTokenIndex >= 0)
+        {
+            pList = pObject->GetSubList();
+            if (!pList)
+                throw lang::IllegalArgumentException(
+                    u"Spellbook object path does not resolve through a group"_ustr,
+                    nullptr, 0);
+        }
+    } while (nTokenIndex >= 0);
+    return pObject;
+}
+
+sal_Int16 animationStartMode(const OUString& rStart)
+{
+    if (rStart == u"on-click")
+        return presentation::EffectNodeType::ON_CLICK;
+    if (rStart == u"with-previous")
+        return presentation::EffectNodeType::WITH_PREVIOUS;
+    if (rStart == u"after-previous")
+        return presentation::EffectNodeType::AFTER_PREVIOUS;
+    throw lang::IllegalArgumentException(u"Unsupported animation start mode"_ustr,
+                                          nullptr, 0);
+}
+
+sd::CustomAnimationEffectPtr animationEffectAt(
+    const std::shared_ptr<sd::MainSequence>& pSequence, sal_Int32 nIndex)
+{
+    if (!pSequence || nIndex < 0 || nIndex >= pSequence->getCount())
+        return {};
+    sal_Int32 nCurrent = 0;
+    for (auto it = pSequence->getBegin(); it != pSequence->getEnd(); ++it, ++nCurrent)
+        if (nCurrent == nIndex)
+            return *it;
+    return {};
+}
+
+sd::CustomAnimationPresetPtr animationPreset(const OUString& rPresetId)
+{
+    if (rPresetId.isEmpty() || rPresetId.getLength() > 128
+        || !(rPresetId.startsWith(u"ooo-entrance-")
+             || rPresetId.startsWith(u"ooo-emphasis-")
+             || rPresetId.startsWith(u"ooo-exit-")
+             || rPresetId.startsWith(u"ooo-motionpath-")))
+        throw lang::IllegalArgumentException(u"Invalid animation preset"_ustr,
+                                              nullptr, 0);
+    auto pPreset
+        = sd::CustomAnimationPresets::getCustomAnimationPresets()
+              .getEffectDescriptor(rPresetId);
+    if (!pPreset)
+        throw lang::IllegalArgumentException(u"Unknown animation preset"_ustr,
+                                              nullptr, 0);
+    return pPreset;
+}
+
+sd::CustomAnimationEffectPtr validatedAnimationEffect(
+    const std::shared_ptr<sd::MainSequence>& pSequence, sal_Int32 nIndex,
+    const uno::Reference<drawing::XShape>& xTarget,
+    const OUString& rExpectedPresetId)
+{
+    auto pEffect = animationEffectAt(pSequence, nIndex);
+    if (!pEffect || pEffect->getTargetShape() != xTarget
+        || pEffect->getPresetId() != rExpectedPresetId)
+        throw lang::IllegalArgumentException(
+            u"Animation effect no longer matches observation"_ustr, nullptr, 0);
+    return pEffect;
+}
