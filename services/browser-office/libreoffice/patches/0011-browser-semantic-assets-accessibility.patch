+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookMediaReplacementUsesOneNativeUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    SdPage* pPage = pDrawDocument->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    const size_t nInitialCount = pPage->GetObjCount();
+
+    pDrawDocument->EnableUndo(false);
+    rtl::Reference<SdrMediaObj> pOriginal = new SdrMediaObj(
+        *pDrawDocument, tools::Rectangle(1100, 1200, 4100, 3200));
+    rtl::Reference<SdrMediaObj> pInserted = new SdrMediaObj(
+        *pDrawDocument, tools::Rectangle(8000, 7000, 9000, 8000));
+    avmedia::MediaItem aOldMedia(pOriginal->getMediaProperties());
+    aOldMedia.setURL(u"file:///old.wav"_ustr, OUString(), OUString());
+    aOldMedia.setLoop(true);
+    aOldMedia.setMute(true);
+    aOldMedia.setVolumeDB(-1200);
+    pOriginal->setMediaProperties(aOldMedia);
+    avmedia::MediaItem aNewMedia(pInserted->getMediaProperties());
+    aNewMedia.setURL(u"file:///new.wav"_ustr, OUString(), OUString());
+    pInserted->setMediaProperties(aNewMedia);
+    pOriginal->SetName(u"Original media"_ustr);
+    pOriginal->SetTitle(u"Accessible media"_ustr);
+    const tools::Rectangle aOriginalRectangle = pOriginal->GetLogicRect();
+    pPage->NbcInsertObject(pOriginal.get());
+    pPage->NbcInsertObject(pInserted.get());
+    pDrawDocument->EnableUndo(true);
+
+    uno::Reference<beans::XPropertySet> xInsertedProperties(
+        pInserted->getUnoShape(), uno::UNO_QUERY_THROW);
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser media replacement");
+    xInsertedProperties->setPropertyValue("SpellbookReplaceObject",
+                                          uno::Any(sal_Int32(nInitialCount)));
+    pDrawDocument->EndUndo();
+
+    CPPUNIT_ASSERT_EQUAL(nInitialCount + 1, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    CPPUNIT_ASSERT_EQUAL(pOriginal.get(), pPage->GetObj(nInitialCount));
+    CPPUNIT_ASSERT_EQUAL(u"Original media"_ustr, pOriginal->GetName());
+    CPPUNIT_ASSERT_EQUAL(u"Accessible media"_ustr, pOriginal->GetTitle());
+    CPPUNIT_ASSERT_EQUAL(aOriginalRectangle, pOriginal->GetLogicRect());
+    CPPUNIT_ASSERT_EQUAL(u"file:///new.wav"_ustr,
+                         pOriginal->getMediaProperties().getURL());
+    CPPUNIT_ASSERT(pOriginal->getMediaProperties().isLoop());
+    CPPUNIT_ASSERT(pOriginal->getMediaProperties().isMute());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(-1200),
+                         pOriginal->getMediaProperties().getVolumeDB());
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nInitialCount + 2, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(pOriginal.get(), pPage->GetObj(nInitialCount));
+    CPPUNIT_ASSERT_EQUAL(pInserted.get(), pPage->GetObj(nInitialCount + 1));
+    CPPUNIT_ASSERT_EQUAL(aOriginalRectangle, pOriginal->GetLogicRect());
+    CPPUNIT_ASSERT_EQUAL(u"file:///old.wav"_ustr,
+                         pOriginal->getMediaProperties().getURL());
+
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nInitialCount + 1, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(pOriginal.get(), pPage->GetObj(nInitialCount));
+    CPPUNIT_ASSERT_EQUAL(aOriginalRectangle, pOriginal->GetLogicRect());
+    CPPUNIT_ASSERT_EQUAL(u"file:///new.wav"_ustr,
+                         pOriginal->getMediaProperties().getURL());
+    CPPUNIT_ASSERT(pOriginal->getMediaProperties().isLoop());
+    CPPUNIT_ASSERT(pOriginal->getMediaProperties().isMute());
+}
