+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookSemanticDiagramUsesOneNativeUndo)
+{
+    createSdImpressDoc("pptx/smartart-children.pptx");
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    SdPage* pPage = pDrawDocument->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    SdrObject* pDiagram = pPage->GetObj(0);
+    CPPUNIT_ASSERT(pDiagram);
+    CPPUNIT_ASSERT(pDiagram->isDiagram());
+    const auto xHelper = pDiagram->getDiagramHelper();
+    CPPUNIT_ASSERT(xHelper);
+
+    OUString aParentId;
+    for (const auto& [rId, rText] : xHelper->getChildren(OUString()))
+        if (rText == u"a"_ustr)
+            aParentId = rId;
+    CPPUNIT_ASSERT(!aParentId.isEmpty());
+    auto findChildText = [&]() {
+        OUString aResult;
+        for (const auto& rChild : xHelper->getChildren(aParentId))
+            if (rChild.second == u"b"_ustr
+                || rChild.second == u"Updated child"_ustr)
+                aResult = rChild.second;
+        return aResult;
+    };
+    CPPUNIT_ASSERT_EQUAL(u"b"_ustr, findChildText());
+
+    uno::Reference<beans::XPropertySet> xProperties(pDiagram->getUnoShape(),
+                                                    uno::UNO_QUERY_THROW);
+    OUString aState;
+    xProperties->getPropertyValue("SpellbookDiagramState") >>= aState;
+    CPPUNIT_ASSERT(aState.indexOf(u"\"text\":\"b\""_ustr) >= 0);
+    CPPUNIT_ASSERT(aState.indexOf(u"parentId"_ustr) >= 0);
+    static constexpr OUString aMutation
+        = uR"json({"Action":"set","ExpectedText":"b","Occurrence":0,"Text":"Updated child"})json"_ustr;
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser semantic diagram");
+    xProperties->setPropertyValue("SpellbookDiagramMutation", uno::Any(aMutation));
+    pDrawDocument->EndUndo();
+
+    CPPUNIT_ASSERT_EQUAL(u"Updated child"_ustr, findChildText());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(u"b"_ustr, findChildText());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(u"Updated child"_ustr, findChildText());
+
+    pUndoManager->Undo();
+    pUndoManager->Clear();
+    const size_t nTopLevelBefore = xHelper->getChildren(OUString()).size();
+    auto hasTopLevelText = [&](const OUString& rExpected) {
+        const auto aNodes = xHelper->getChildren(OUString());
+        return std::any_of(aNodes.begin(), aNodes.end(),
+                           [&](const auto& rNode) { return rNode.second == rExpected; });
+    };
+    static constexpr OUString aAddMutation
+        = uR"json({"Action":"add","ExpectedText":"","Occurrence":0,"Text":"Added top"})json"_ustr;
+    pDrawDocument->BegUndo("Browser semantic diagram add");
+    xProperties->setPropertyValue("SpellbookDiagramMutation", uno::Any(aAddMutation));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(nTopLevelBefore + 1, xHelper->getChildren(OUString()).size());
+    CPPUNIT_ASSERT(hasTopLevelText(u"Added top"_ustr));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nTopLevelBefore, xHelper->getChildren(OUString()).size());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT(hasTopLevelText(u"Added top"_ustr));
+
+    pUndoManager->Clear();
+    static constexpr OUString aDeleteMutation
+        = uR"json({"Action":"delete","ExpectedText":"Added top","Occurrence":0,"Text":""})json"_ustr;
+    pDrawDocument->BegUndo("Browser semantic diagram delete");
+    xProperties->setPropertyValue("SpellbookDiagramMutation", uno::Any(aDeleteMutation));
+    pDrawDocument->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(nTopLevelBefore, xHelper->getChildren(OUString()).size());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT(hasTopLevelText(u"Added top"_ustr));
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT(!hasTopLevelText(u"Added top"_ustr));
+}
