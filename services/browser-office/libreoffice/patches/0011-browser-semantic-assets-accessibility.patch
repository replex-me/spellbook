+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxTextShadowRoundTrip)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent,
+                                                        uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.TextShape"),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(10000, 3000));
+    xShapes->add(xShape);
+
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString("Shadow text");
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+    xCursor->gotoStart(false);
+    xCursor->gotoEnd(true);
+    uno::Reference<beans::XPropertySet> xCursorProperties(xCursor,
+                                                          uno::UNO_QUERY_THROW);
+    xCursorProperties->setPropertyValue("CharShadowed", uno::Any(true));
+    bool bShadowed = false;
+    CPPUNIT_ASSERT(xCursorProperties->getPropertyValue("CharShadowed") >>= bShadowed);
+    CPPUNIT_ASSERT(bShadowed);
+
+    saveAndReload("Impress Office Open XML");
+    xmlDocUniquePtr pXmlDoc = parseExport("ppt/slides/slide1.xml");
+    assertXPath(pXmlDoc, "//a:outerShdw", 1);
+
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPage.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xShapes.set(xPage, uno::UNO_QUERY_THROW);
+    xShape.set(xShapes->getByIndex(xShapes->getCount() - 1), uno::UNO_QUERY_THROW);
+    xText.set(xShape, uno::UNO_QUERY_THROW);
+    xCursor = xText->createTextCursor();
+    xCursor->gotoStart(false);
+    xCursor->gotoEnd(true);
+    xCursorProperties.set(xCursor, uno::UNO_QUERY_THROW);
+    bShadowed = false;
+    CPPUNIT_ASSERT(xCursorProperties->getPropertyValue("CharShadowed") >>= bShadowed);
+    CPPUNIT_ASSERT(bShadowed);
+}
