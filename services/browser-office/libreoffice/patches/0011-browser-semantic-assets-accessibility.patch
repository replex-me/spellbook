+boost::property_tree::ptree parseSpellbookMutation(const uno::Any& rValue)
+{
+    OUString aJson;
+    if (!(rValue >>= aJson) || aJson.getLength() > 50000)
+        throw lang::IllegalArgumentException(u"Invalid Spellbook mutation payload"_ustr,
+                                              nullptr, 0);
+    std::stringstream aStream(OUStringToOString(aJson, RTL_TEXTENCODING_UTF8).getStr());
+    boost::property_tree::ptree aTree;
+    try
+    {
+        boost::property_tree::read_json(aStream, aTree);
+    }
+    catch (...)
+    {
+        throw lang::IllegalArgumentException(u"Malformed Spellbook mutation payload"_ustr,
+                                              nullptr, 0);
+    }
+    return aTree;
+}
+
+OUString spellbookDiagramState(SdrObject* pObject)
+{
+    if (!pObject || !pObject->isDiagram())
+        return OUString();
+    boost::property_tree::ptree aRoot;
+    boost::property_tree::ptree aNodes;
+    const auto xHelper = pObject->getDiagramHelper();
+    std::vector<OUString> aParents{ OUString() };
+    std::set<OUString> aVisited;
+    for (size_t nParent = 0; nParent < aParents.size() && aVisited.size() < 1000;
+         ++nParent)
+    {
+        for (const auto& [rId, rText] : xHelper->getChildren(aParents[nParent]))
+        {
+            if (rId.isEmpty() || !aVisited.insert(rId).second)
+                continue;
+            boost::property_tree::ptree aNode;
+            aNode.put("id", OUStringToOString(rId, RTL_TEXTENCODING_UTF8).getStr());
+            aNode.put("text", OUStringToOString(rText, RTL_TEXTENCODING_UTF8).getStr());
+            aNode.put("parentId",
+                      OUStringToOString(aParents[nParent], RTL_TEXTENCODING_UTF8).getStr());
+            aNodes.push_back(std::make_pair("", aNode));
+            aParents.push_back(rId);
+        }
+    }
+    aRoot.add_child("nodes", aNodes);
+    std::ostringstream aJson;
+    boost::property_tree::write_json(aJson, aRoot, false);
+    return OUString::fromUtf8(aJson.str());
+}
+
+void applySpellbookDiagramMutation(SdrObject* pObject, SdDrawDocument* pDocument,
+                                   const uno::Any& rValue)
+{
+    if (!pObject || !pDocument || !pObject->isDiagram())
+        throw lang::IllegalArgumentException(u"Object is not a semantic diagram"_ustr,
+                                              nullptr, 0);
+    const auto aTree = parseSpellbookMutation(rValue);
+    static const std::set<std::string> aAllowedKeys = {
+        "Action", "ExpectedText", "Occurrence", "Text"
+    };
+    for (const auto& rEntry : aTree)
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(u"Unsupported diagram mutation field"_ustr,
+                                                  nullptr, 0);
+    const std::string aAction = aTree.get<std::string>("Action");
+    const OUString aExpectedText
+        = OUString::fromUtf8(aTree.get<std::string>("ExpectedText"));
+    const sal_Int32 nOccurrence = aTree.get<sal_Int32>("Occurrence");
+    const OUString aText = OUString::fromUtf8(aTree.get<std::string>("Text"));
+    if ((aAction != "set" && aAction != "add" && aAction != "delete")
+        || nOccurrence < 0 || nOccurrence > 999 || aExpectedText.getLength() > 4000
+        || aText.getLength() > 4000)
+        throw lang::IllegalArgumentException(u"Invalid diagram mutation"_ustr, nullptr, 0);
+
+    auto xHelper = pObject->getDiagramHelper();
+    if (!xHelper)
+        throw lang::IllegalArgumentException(u"Diagram model is unavailable"_ustr, nullptr, 0);
+    if (aAction == "set" && aExpectedText == aText)
+        return;
+    OUString aNodeId;
+    if (aAction != "add")
+    {
+        sal_Int32 nMatch = 0;
+        std::vector<OUString> aParents{ OUString() };
+        std::set<OUString> aVisited;
+        for (size_t nParent = 0;
+             nParent < aParents.size() && aVisited.size() < 1000 && aNodeId.isEmpty();
+             ++nParent)
+        {
+            for (const auto& [rId, rText] : xHelper->getChildren(aParents[nParent]))
+            {
+                if (rId.isEmpty() || !aVisited.insert(rId).second)
+                    continue;
+                if (rText == aExpectedText && nMatch++ == nOccurrence)
+                {
+                    aNodeId = rId;
+                    break;
+                }
+                aParents.push_back(rId);
+            }
+        }
+        if (aNodeId.isEmpty())
+            throw lang::IllegalArgumentException(u"Diagram node changed"_ustr, nullptr, 0);
+    }
+
+    auto xStartState = xHelper->extractDiagramDataState();
+    try
+    {
+        if (aAction == "add")
+        {
+            if (xHelper->addNode(aText).isEmpty())
+                throw lang::IllegalArgumentException(u"Diagram node could not be added"_ustr,
+                                                      nullptr, 0);
+        }
+        else if (aAction == "delete")
+        {
+            if (!xHelper->removeNode(aNodeId))
+                throw lang::IllegalArgumentException(u"Diagram node cannot be deleted"_ustr,
+                                                      nullptr, 0);
+        }
+        else
+        {
+            auto xNextState = xHelper->extractDiagramDataState();
+            bool bChanged = false;
+            for (auto& rPoint : xNextState->getPoints())
+            {
+                if (rPoint.msModelId != aNodeId)
+                    continue;
+                if (!rPoint.msTextBody)
+                    rPoint.msTextBody = std::make_shared<svx::diagram::TextBody>();
+                else
+                    rPoint.msTextBody
+                        = std::make_shared<svx::diagram::TextBody>(*rPoint.msTextBody);
+                rPoint.msTextBody->msText = aText;
+                bChanged = true;
+                break;
+            }
+            if (!bChanged)
+                throw lang::IllegalArgumentException(u"Diagram node data is unavailable"_ustr,
+                                                      nullptr, 0);
+            xHelper->applyDiagramDataState(xNextState);
+        }
+        xHelper->reLayout(*static_cast<SdrObjGroup*>(pObject));
+    }
+    catch (...)
+    {
+        xHelper->applyDiagramDataState(xStartState);
+        xHelper->reLayout(*static_cast<SdrObjGroup*>(pObject));
+        throw;
+    }
+    if (pDocument->IsUndoEnabled())
+        pDocument->AddUndo(pDocument->GetSdrUndoFactory().CreateUndoDiagramModelData(
+            *pObject, xStartState));
+    pObject->SetChanged();
+    pObject->BroadcastObjectChange();
+}
+
+void applySpellbookEquationMutation(SdrObject* pObject, SdDrawDocument* pDocument,
+                                    const uno::Any& rValue)
+{
+    SdrOle2Obj* pOleObject = dynamic_cast<SdrOle2Obj*>(pObject);
+    if (!pOleObject || !pDocument)
+        throw lang::IllegalArgumentException(u"Object is not an embedded equation"_ustr,
+                                              nullptr, 0);
+    const auto aTree = parseSpellbookMutation(rValue);
+    if (aTree.size() != 2 || !aTree.get_optional<std::string>("ExpectedSource")
+        || !aTree.get_optional<std::string>("Source"))
+        throw lang::IllegalArgumentException(u"Invalid equation mutation"_ustr, nullptr, 0);
+    const OUString aExpectedSource
+        = OUString::fromUtf8(aTree.get<std::string>("ExpectedSource"));
+    const OUString aSource = OUString::fromUtf8(aTree.get<std::string>("Source"));
+    if (aExpectedSource.getLength() > 20000 || aSource.getLength() > 20000)
+        throw lang::IllegalArgumentException(u"Equation source is too long"_ustr, nullptr, 0);
+    uno::Reference<frame::XModel> xModel = pOleObject->getXModel();
+    uno::Reference<lang::XServiceInfo> xServiceInfo(xModel, uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xProperties(xModel, uno::UNO_QUERY);
+    if (!xServiceInfo.is() || !xProperties.is()
+        || !xServiceInfo->supportsService(u"com.sun.star.formula.FormulaProperties"_ustr))
+        throw lang::IllegalArgumentException(u"Embedded object is not a Math equation"_ustr,
+                                              nullptr, 0);
+    OUString aCurrentSource;
+    xProperties->getPropertyValue(u"Formula"_ustr) >>= aCurrentSource;
+    if (aCurrentSource != aExpectedSource)
+        throw lang::IllegalArgumentException(u"Equation source changed"_ustr, nullptr, 0);
+    if (aCurrentSource == aSource)
+        return;
+    if (pDocument->IsUndoEnabled())
+        pDocument->GetDocSh()->GetUndoManager()->AddUndoAction(
+            std::make_unique<EquationSourceUndoAction>(*pDocument, *pObject, aCurrentSource, aSource), true);
+    xProperties->setPropertyValue(u"Formula"_ustr, uno::Any(aSource));
+    pObject->SetChanged();
+    pObject->BroadcastObjectChange();
+}
+
+void applySpellbookObjectReplacement(SdrObject* pNewObject, SdDrawDocument* pDocument,
+                                     const uno::Any& rValue)
+{
+    sal_Int32 nOldOrder = -1;
+    if (!(rValue >>= nOldOrder) || nOldOrder < 0)
+        throw lang::IllegalArgumentException(u"Invalid replacement target"_ustr, nullptr, 0);
+    SdrObjList* pList = pNewObject ? pNewObject->getParentSdrObjListFromSdrObject() : nullptr;
+    if (!pNewObject || !pDocument || !pList
+        || static_cast<size_t>(nOldOrder) >= pList->GetObjCount())
+        throw lang::IllegalArgumentException(u"Replacement target is unavailable"_ustr,
+                                              nullptr, 0);
+    SdrObject* pOldObject = pList->GetObj(nOldOrder);
+    if (!pOldObject || pOldObject == pNewObject)
+        throw lang::IllegalArgumentException(u"Replacement targets are identical"_ustr,
+                                              nullptr, 0);
+
+    if (auto* pOldGraphic = dynamic_cast<SdrGrafObj*>(pOldObject))
+    {
+        auto* pNewGraphic = dynamic_cast<SdrGrafObj*>(pNewObject);
+        if (!pNewGraphic)
+            throw lang::IllegalArgumentException(u"Replacement asset type changed"_ustr,
+                                                  nullptr, 0);
+        if (pDocument->IsUndoEnabled())
+            pDocument->GetDocSh()->GetUndoManager()->AddUndoAction(
+                std::make_unique<GraphicContentUndoAction>(*pDocument, *pOldGraphic,
+                    pOldGraphic->GetGraphic(), pNewGraphic->GetGraphic()), true);
+        pOldGraphic->SetGraphic(pNewGraphic->GetGraphic());
+    }
+    else if (auto* pOldMedia = dynamic_cast<SdrMediaObj*>(pOldObject))
+    {
+        auto* pNewMedia = dynamic_cast<SdrMediaObj*>(pNewObject);
+        if (!pNewMedia)
+            throw lang::IllegalArgumentException(u"Replacement asset type changed"_ustr,
+                                                  nullptr, 0);
+        const avmedia::MediaItem aReplacement = mediaReplacementState(
+            pOldMedia->getMediaProperties(), pNewMedia->getMediaProperties());
+        if (pDocument->IsUndoEnabled())
+            pDocument->GetDocSh()->GetUndoManager()->AddUndoAction(
+                std::make_unique<MediaContentUndoAction>(*pDocument, *pOldMedia,
+                    pOldMedia->getMediaProperties(), aReplacement), true);
+        pOldMedia->setMediaProperties(aReplacement);
+    }
+    else
+        throw lang::IllegalArgumentException(u"Replacement target is not an image or media asset"_ustr,
+                                              nullptr, 0);
+
+    if (pDocument->IsUndoEnabled())
+        pDocument->AddUndo(
+            pDocument->GetSdrUndoFactory().CreateUndoDeleteObject(*pNewObject, true));
+    pList->RemoveObject(pNewObject->GetOrdNum());
+    pOldObject->SetChanged();
+    pOldObject->BroadcastObjectChange();
+}
 }
 
