+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookMediaPlaybackUsesNativeUndo)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    SdPage* pPage = pDrawDocument->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    pDrawDocument->EnableUndo(false);
+    rtl::Reference<SdrMediaObj> pMedia = new SdrMediaObj(
+        *pDrawDocument, tools::Rectangle(1100, 1200, 4100, 3200));
+    pPage->NbcInsertObject(pMedia.get());
+    pDrawDocument->EnableUndo(true);
+    uno::Reference<beans::XPropertySet> xProperties(pMedia->getUnoShape(),
+                                                    uno::UNO_QUERY_THROW);
+    bool bOriginalLoop = false;
+    xProperties->getPropertyValue("Loop") >>= bOriginalLoop;
+    bool bOriginalMute = false;
+    xProperties->getPropertyValue("Mute") >>= bOriginalMute;
+    sal_Int16 nOriginalVolume = 0;
+    xProperties->getPropertyValue("VolumeDB") >>= nOriginalVolume;
+    const sal_Int16 nReplacementVolume = nOriginalVolume == -900 ? -1200 : -900;
+
+    auto* pUndoManager = pDrawDocument->GetUndoManager();
+    pUndoManager->Clear();
+    pDrawDocument->BegUndo("Browser media playback");
+    xProperties->setPropertyValue("Loop", uno::Any(!bOriginalLoop));
+    xProperties->setPropertyValue("Mute", uno::Any(!bOriginalMute));
+    xProperties->setPropertyValue("VolumeDB", uno::Any(nReplacementVolume));
+    pDrawDocument->EndUndo();
+
+    bool bLoop = bOriginalLoop;
+    bool bMute = bOriginalMute;
+    sal_Int16 nVolume = nOriginalVolume;
+    xProperties->getPropertyValue("Loop") >>= bLoop;
+    xProperties->getPropertyValue("Mute") >>= bMute;
+    xProperties->getPropertyValue("VolumeDB") >>= nVolume;
+    CPPUNIT_ASSERT_EQUAL(!bOriginalLoop, bLoop);
+    CPPUNIT_ASSERT_EQUAL(!bOriginalMute, bMute);
+    CPPUNIT_ASSERT_EQUAL(nReplacementVolume, nVolume);
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    xProperties->getPropertyValue("Loop") >>= bLoop;
+    xProperties->getPropertyValue("Mute") >>= bMute;
+    xProperties->getPropertyValue("VolumeDB") >>= nVolume;
+    CPPUNIT_ASSERT_EQUAL(bOriginalLoop, bLoop);
+    CPPUNIT_ASSERT_EQUAL(bOriginalMute, bMute);
+    CPPUNIT_ASSERT_EQUAL(nOriginalVolume, nVolume);
+    pUndoManager->Redo();
+    xProperties->getPropertyValue("Loop") >>= bLoop;
+    xProperties->getPropertyValue("Mute") >>= bMute;
+    xProperties->getPropertyValue("VolumeDB") >>= nVolume;
+    CPPUNIT_ASSERT_EQUAL(!bOriginalLoop, bLoop);
+    CPPUNIT_ASSERT_EQUAL(!bOriginalMute, bMute);
+    CPPUNIT_ASSERT_EQUAL(nReplacementVolume, nVolume);
+}
