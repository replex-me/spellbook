+void ShapeExport::WriteNonVisualDrawingProperties(
+    const Reference<XPropertySet>& xShapeProperties, sal_Int32 nShapeId,
+    const OUString& rName, bool bHidden, bool bMediaClickAction)
+{
+    rtl::Reference<sax_fastparser::FastAttributeList> xAttributes
+        = sax_fastparser::FastSerializerHelper::createAttrList();
+    xAttributes->add(XML_id, OString::number(nShapeId));
+    xAttributes->add(XML_name, rName);
+
+    if (xShapeProperties.is())
+    {
+        const Reference<XPropertySetInfo> xInfo = xShapeProperties->getPropertySetInfo();
+        OUString aDescription;
+        OUString aTitle;
+        if (xInfo.is() && xInfo->hasPropertyByName("Description"))
+            xShapeProperties->getPropertyValue("Description") >>= aDescription;
+        if (xInfo.is() && xInfo->hasPropertyByName("Title"))
+            xShapeProperties->getPropertyValue("Title") >>= aTitle;
+        if (!aDescription.isEmpty())
+            xAttributes->add(XML_descr, aDescription);
+        if (!aTitle.isEmpty())
+            xAttributes->add(XML_title, aTitle);
+    }
+    if (bHidden)
+        xAttributes->add(XML_hidden, "1");
+
+    FSHelperPtr pFS = GetFS();
+    pFS->startElementNS(mnXmlNamespace, XML_cNvPr, xAttributes);
+    WriteShapeClickAction(xShapeProperties, bMediaClickAction);
+    if (xShapeProperties.is())
+        AddExtLst(pFS, xShapeProperties);
+    pFS->endElementNS(mnXmlNamespace, XML_cNvPr);
+}
