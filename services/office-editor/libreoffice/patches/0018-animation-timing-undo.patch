+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureAnimationTimingUndoRedo)
+{
+    createSdImpressDoc("pptx/connector-shape-animations.pptx");
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdPage* pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+
+    sal_Int32 nTargetObject = -1;
+    sd::CustomAnimationEffectPtr pOriginalEffect;
+    std::shared_ptr<sd::MainSequence> pMainSequence = pPage->getMainSequence();
+    for (auto it = pMainSequence->getBegin(); it != pMainSequence->getEnd() && !pOriginalEffect;
+         ++it)
+    {
+        const sd::CustomAnimationEffectPtr& pEffect = *it;
+        if (!pEffect || pEffect->getPresetId() != u"ooo-entrance-wipe"_ustr)
+            continue;
+        uno::Reference<drawing::XShape> xTarget;
+        pEffect->getTarget() >>= xTarget;
+        for (sal_uInt32 nObject = 0; nObject < pPage->GetObjCount(); ++nObject)
+        {
+            if (xTarget == pPage->GetObj(nObject)->getUnoShape())
+            {
+                nTargetObject = static_cast<sal_Int32>(nObject);
+                pOriginalEffect = pEffect;
+                break;
+            }
+        }
+    }
+    CPPUNIT_ASSERT(pOriginalEffect);
+    CPPUNIT_ASSERT(nTargetObject >= 0);
+    const double fOldDuration = pOriginalEffect->getDuration();
+    const double fOldDelay = pOriginalEffect->getBegin();
+    const sal_Int16 nOldNodeType = pOriginalEffect->getNodeType();
+
+    const OUString aJson
+        = uR"json({"Transforms":{"SlideCommands":[{"JumpToSlide":0},{"SetAnimationTiming.)json"_ustr
+          + OUString::number(nTargetObject)
+          + uR"json(":{"EffectIndex":0,"ExpectedPresetId":"ooo-entrance-wipe","Duration":1.25,"Delay":0.25,"Start":"after-previous"}}]}})json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    auto getTargetEffect = [&]() {
+        std::shared_ptr<sd::MainSequence> pSequence = pPage->getMainSequence();
+        const uno::Reference<drawing::XShape> xTarget
+            = pPage->GetObj(nTargetObject)->getUnoShape();
+        CPPUNIT_ASSERT(xTarget.is());
+        for (auto it = pSequence->getBegin(); it != pSequence->getEnd(); ++it)
+        {
+            const sd::CustomAnimationEffectPtr& pEffect = *it;
+            if (pEffect && pEffect->getPresetId() == u"ooo-entrance-wipe"_ustr)
+            {
+                uno::Reference<drawing::XShape> xEffectTarget;
+                pEffect->getTarget() >>= xEffectTarget;
+                if (xEffectTarget == xTarget)
+                    return pEffect;
+            }
+        }
+        return sd::CustomAnimationEffectPtr();
+    };
+    auto pChangedEffect = getTargetEffect();
+    CPPUNIT_ASSERT(pChangedEffect);
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    CPPUNIT_ASSERT_EQUAL(1.25, pChangedEffect->getDuration());
+    CPPUNIT_ASSERT_EQUAL(0.25, pChangedEffect->getBegin());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(presentation::EffectNodeType::AFTER_PREVIOUS),
+                         pChangedEffect->getNodeType());
+
+    pUndoManager->Undo();
+    auto pUndoneEffect = getTargetEffect();
+    CPPUNIT_ASSERT(pUndoneEffect);
+    CPPUNIT_ASSERT_EQUAL(fOldDuration, pUndoneEffect->getDuration());
+    CPPUNIT_ASSERT_EQUAL(fOldDelay, pUndoneEffect->getBegin());
+    CPPUNIT_ASSERT_EQUAL(nOldNodeType, pUndoneEffect->getNodeType());
+
+    pUndoManager->Redo();
+    auto pRedoneEffect = getTargetEffect();
+    CPPUNIT_ASSERT(pRedoneEffect);
+    CPPUNIT_ASSERT_EQUAL(1.25, pRedoneEffect->getDuration());
+    CPPUNIT_ASSERT_EQUAL(0.25, pRedoneEffect->getBegin());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(presentation::EffectNodeType::AFTER_PREVIOUS),
+                         pRedoneEffect->getNodeType());
+}
