+void handleSetAnimationTiming(SlideCommandContext& rCtx, const std::string& rKey,
+                              const boost::property_tree::ptree& rValue)
+{
+    int nObjId;
+    try
+    {
+        nObjId = stoi(rKey.substr(19));
+    }
+    catch (const std::exception&)
+    {
+        throw lang::IllegalArgumentException(u"Invalid animation target index"_ustr, nullptr, 0);
+    }
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<int>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Animation target index out of range"_ustr,
+                                              nullptr, 0);
+
+    const sal_Int32 nEffectIndex = rValue.get<sal_Int32>("EffectIndex");
+    const OUString aExpectedPresetId
+        = OUString::fromUtf8(rValue.get<std::string>("ExpectedPresetId"));
+    const double fDuration = rValue.get<double>("Duration");
+    const double fDelay = rValue.get<double>("Delay");
+    const std::string aStart = rValue.get<std::string>("Start");
+    if (nEffectIndex < 0 || nEffectIndex > 99 || aExpectedPresetId.isEmpty()
+        || aExpectedPresetId.getLength() > 128 || fDuration < 0.001 || fDuration > 60.0
+        || fDelay < 0.0 || fDelay > 60.0)
+        throw lang::IllegalArgumentException(u"Animation timing value is out of range"_ustr,
+                                              nullptr, 0);
+
+    sal_Int16 nNodeType;
+    if (aStart == "on-click")
+        nNodeType = presentation::EffectNodeType::ON_CLICK;
+    else if (aStart == "with-previous")
+        nNodeType = presentation::EffectNodeType::WITH_PREVIOUS;
+    else if (aStart == "after-previous")
+        nNodeType = presentation::EffectNodeType::AFTER_PREVIOUS;
+    else
+        throw lang::IllegalArgumentException(u"Unsupported animation start mode"_ustr,
+                                              nullptr, 0);
+
+    const uno::Reference<drawing::XShape> xTarget
+        = pPage->GetObj(nObjId)->getUnoShape();
+    if (!xTarget.is())
+        throw lang::IllegalArgumentException(u"Animation target has no UNO shape"_ustr,
+                                              nullptr, 0);
+    std::shared_ptr<sd::MainSequence> pMainSequence = pPage->getMainSequence();
+    sd::CustomAnimationEffectPtr pTargetEffect;
+    sal_Int32 nMatchingEffect = 0;
+    for (auto it = pMainSequence->getBegin(); it != pMainSequence->getEnd(); ++it)
+    {
+        const sd::CustomAnimationEffectPtr& pEffect = *it;
+        if (pEffect && pEffect->getTargetShape() == xTarget)
+        {
+            if (nMatchingEffect == nEffectIndex)
+            {
+                pTargetEffect = pEffect;
+                break;
+            }
+            ++nMatchingEffect;
+        }
+    }
+    if (!pTargetEffect || pTargetEffect->getPresetId() != aExpectedPresetId)
+        throw lang::IllegalArgumentException(u"Animation effect no longer matches observation"_ustr,
+                                              nullptr, 0);
+
+    if (rtl::math::approxEqual(pTargetEffect->getDuration(), fDuration)
+        && rtl::math::approxEqual(pTargetEffect->getBegin(), fDelay)
+        && pTargetEffect->getNodeType() == nNodeType)
+        return;
+
+    if (rCtx.mbUndo)
+        rCtx.mpDrawView->AddUndo(
+            std::make_unique<sd::UndoAnimation>(rCtx.mpDoc, pPage));
+
+    {
+        sd::MainSequenceRebuildGuard aGuard(pMainSequence);
+        pTargetEffect->setDuration(fDuration);
+        pTargetEffect->setBegin(fDelay);
+        pTargetEffect->setNodeType(nNodeType);
+    }
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
