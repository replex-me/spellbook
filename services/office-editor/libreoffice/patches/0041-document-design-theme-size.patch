+void handleSetSlideSize(SlideCommandContext& rCtx, const std::string& /*rKey*/,
+                        const boost::property_tree::ptree& rValue)
+{
+    static const std::set<std::string> aAllowedKeys = { "Width", "Height", "ScaleContent" };
+    for (const auto& rEntry : rValue)
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(u"Unsupported slide size field"_ustr,
+                                                  nullptr, 0);
+    const sal_Int32 nWidth = rValue.get<sal_Int32>("Width");
+    const sal_Int32 nHeight = rValue.get<sal_Int32>("Height");
+    const bool bScaleContent = rValue.get<bool>("ScaleContent");
+    if (nWidth < 1000 || nWidth > 100000 || nHeight < 1000 || nHeight > 100000)
+        throw lang::IllegalArgumentException(u"Slide size is out of range"_ustr, nullptr, 0);
+    SdPage* pReference = rCtx.mpDoc->GetSdPage(0, PageKind::Standard);
+    if (!pReference)
+        throw lang::IllegalArgumentException(u"Presentation has no slide"_ustr, nullptr, 0);
+    const Size aNewSize(nWidth, nHeight);
+    if (pReference->GetSize() == aNewSize)
+        return;
+    std::unique_ptr<SdUndoGroup> pUndoGroup;
+    if (rCtx.mbUndo)
+        pUndoGroup = std::make_unique<SdUndoGroup>(*rCtx.mpDoc);
+    rCtx.mpDoc->AdaptPageSizeForAllPages(
+        aNewSize, PageKind::Standard, pUndoGroup.get(), 0, 0, 0, 0, bScaleContent,
+        nWidth >= nHeight ? Orientation::Landscape : Orientation::Portrait,
+        pReference->GetPaperBin(), pReference->IsBackgroundFullSize());
+    if (pUndoGroup)
+        rCtx.addUndo(std::move(pUndoGroup));
+    for (sal_uInt16 nSlide = 0;
+         nSlide < rCtx.mpDoc->GetSdPageCount(PageKind::Standard); ++nSlide)
+        rCtx.touch(rCtx.mpDoc->GetSdPage(nSlide, PageKind::Standard));
+    rCtx.mpDoc->SetChanged();
+}
+
+void handleSetMasterTheme(SlideCommandContext& rCtx, const std::string& /*rKey*/,
+                          const boost::property_tree::ptree& rValue)
+{
+    static const std::set<std::string> aAllowedKeys = {
+        "MasterIndex", "Name", "ColorSchemeName", "Colors", "FontSchemeName",
+        "MajorLatin", "MajorAsian", "MajorComplex", "MinorLatin", "MinorAsian",
+        "MinorComplex",
+    };
+    for (const auto& rEntry : rValue)
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(u"Unsupported master theme field"_ustr,
+                                                  nullptr, 0);
+    const sal_Int32 nMasterIndex = rValue.get<sal_Int32>("MasterIndex");
+    if (nMasterIndex < 0
+        || nMasterIndex >= rCtx.mpDoc->GetMasterSdPageCount(PageKind::Standard))
+        throw lang::IllegalArgumentException(u"Master theme target is out of range"_ustr,
+                                              nullptr, 0);
+    SdPage* pMaster
+        = rCtx.mpDoc->GetMasterSdPage(nMasterIndex, PageKind::Standard);
+    if (!pMaster)
+        throw lang::IllegalArgumentException(u"Master theme target is unavailable"_ustr,
+                                              nullptr, 0);
+    const auto readText = [&](const char* pName) {
+        const OUString aValue = OUString::fromUtf8(rValue.get<std::string>(pName));
+        if (aValue.isEmpty() || aValue.getLength() > 255)
+            throw lang::IllegalArgumentException(u"Master theme text is invalid"_ustr,
+                                                  nullptr, 0);
+        for (sal_Int32 nIndex = 0; nIndex < aValue.getLength(); ++nIndex)
+            if (aValue[nIndex] < 0x20 || aValue[nIndex] == 0x7f)
+                throw lang::IllegalArgumentException(
+                    u"Master theme text contains a control character"_ustr, nullptr, 0);
+        return aValue;
+    };
+    const OUString aThemeName = readText("Name");
+    const OUString aColorSchemeName = readText("ColorSchemeName");
+    const OUString aFontSchemeName = readText("FontSchemeName");
+    const auto oColors = rValue.get_child_optional("Colors");
+    if (!oColors || oColors->size() != 12)
+        throw lang::IllegalArgumentException(u"Master theme requires twelve colors"_ustr,
+                                              nullptr, 0);
+    auto pColorSet = std::make_shared<model::ColorSet>(aColorSchemeName);
+    sal_Int32 nColorIndex = 0;
+    for (const auto& rColor : *oColors)
+    {
+        const sal_Int32 nColor = rColor.second.get_value<sal_Int32>();
+        if (nColor < 0 || nColor > 0x00ffffff)
+            throw lang::IllegalArgumentException(u"Master theme color is invalid"_ustr,
+                                                  nullptr, 0);
+        pColorSet->add(static_cast<model::ThemeColorType>(nColorIndex++),
+                       Color(ColorTransparency, nColor));
+    }
+    const std::shared_ptr<model::Theme> pCurrent
+        = pMaster->getSdrPageProperties().getTheme();
+    auto pOldTheme = pCurrent ? std::make_shared<model::Theme>(*pCurrent) : nullptr;
+    auto pNewTheme = pCurrent ? std::make_shared<model::Theme>(*pCurrent)
+                              : std::make_shared<model::Theme>(aThemeName);
+    pNewTheme->SetName(aThemeName);
+    pNewTheme->setColorSet(pColorSet);
+    const model::FontScheme aCurrentFonts
+        = pCurrent ? pCurrent->getFontScheme() : model::FontScheme::getDefault();
+    model::FontScheme aNewFonts(aFontSchemeName);
+    const auto changedFont = [&](const model::ThemeFont& rCurrent, const char* pName) {
+        model::ThemeFont aFont(rCurrent);
+        aFont.maTypeface = readText(pName);
+        return aFont;
+    };
+    aNewFonts.setMajorLatin(changedFont(aCurrentFonts.getMajorLatin(), "MajorLatin"));
+    aNewFonts.setMajorAsian(changedFont(aCurrentFonts.getMajorAsian(), "MajorAsian"));
+    aNewFonts.setMajorComplex(changedFont(aCurrentFonts.getMajorComplex(), "MajorComplex"));
+    aNewFonts.setMinorLatin(changedFont(aCurrentFonts.getMinorLatin(), "MinorLatin"));
+    aNewFonts.setMinorAsian(changedFont(aCurrentFonts.getMinorAsian(), "MinorAsian"));
+    aNewFonts.setMinorComplex(changedFont(aCurrentFonts.getMinorComplex(), "MinorComplex"));
+    aNewFonts.setMajorSupplementalFontList(aCurrentFonts.getMajorSupplementalFontList());
+    aNewFonts.setMinorSupplementalFontList(aCurrentFonts.getMinorSupplementalFontList());
+    pNewTheme->setFontScheme(aNewFonts);
+
+    const auto updatePageColors = [&](SdrPage* pPage) {
+        SdrObjListIter aObjects(pPage, SdrIterMode::DeepWithGroups);
+        while (aObjects.IsMore())
+            svx::theme::updateSdrObject(*pColorSet, aObjects.Next(), rCtx.mpDrawView,
+                                        rCtx.mbUndo ? rCtx.mpUndoManager : nullptr);
+    };
+    updatePageColors(pMaster);
+    for (sal_uInt16 nSlide = 0;
+         nSlide < rCtx.mpDoc->GetSdPageCount(PageKind::Standard); ++nSlide)
+    {
+        SdPage* pSlide = rCtx.mpDoc->GetSdPage(nSlide, PageKind::Standard);
+        if (pSlide && pSlide->TRG_HasMasterPage()
+            && &pSlide->TRG_GetMasterPage() == pMaster)
+        {
+            updatePageColors(pSlide);
+            rCtx.touch(pSlide);
+        }
+    }
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<SetMasterThemeUndoAction>(
+            *rCtx.mpDoc, *pMaster, pOldTheme, pNewTheme));
+    pMaster->getSdrPageProperties().setTheme(pNewTheme);
+    pMaster->ActionChanged();
+    rCtx.mpDoc->SetChanged();
+}
