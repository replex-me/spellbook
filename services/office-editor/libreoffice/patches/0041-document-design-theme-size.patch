+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentDesignSizeAndThemeUndoRoundtrip)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    SdPage* pMaster = pDoc->GetMasterSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pMaster);
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const Size aOldSize = pPage->GetSize();
+
+    static constexpr OUString aSizeJson = uR"json(
+{"Transforms":{"SlideCommands":[{"SetSlideSize":{"Width":30000,"Height":17000,"ScaleContent":false}}]}}
+)json"_ustr;
+    size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aSizeJson) });
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    CPPUNIT_ASSERT_EQUAL(Size(30000, 17000), pPage->GetSize());
+    CPPUNIT_ASSERT_EQUAL(Size(30000, 17000), pMaster->GetSize());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(aOldSize, pPage->GetSize());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(Size(30000, 17000), pPage->GetSize());
+
+    const auto pOldTheme = pMaster->getSdrPageProperties().getTheme();
+    const OUString aOldThemeName = pOldTheme ? pOldTheme->GetName() : OUString();
+    static constexpr OUString aThemeJson = uR"json(
+{"Transforms":{"SlideCommands":[{"SetMasterTheme":{"MasterIndex":0,"Name":"Spellbook","ColorSchemeName":"Spellbook Colors","Colors":[0,16777215,2236962,15658734,3368703,16737894,3381708,16763904,6711039,13421823,255,8388736],"FontSchemeName":"Spellbook Fonts","MajorLatin":"Liberation Sans","MajorAsian":"Noto Sans CJK KR","MajorComplex":"Noto Sans Arabic","MinorLatin":"Liberation Sans","MinorAsian":"Noto Sans CJK KR","MinorComplex":"Noto Sans Arabic"}}]}}
+)json"_ustr;
+    nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aThemeJson) });
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    auto assertTheme = [&]() {
+        const auto pTheme = pMaster->getSdrPageProperties().getTheme();
+        CPPUNIT_ASSERT(pTheme);
+        CPPUNIT_ASSERT_EQUAL(u"Spellbook"_ustr, pTheme->GetName());
+        CPPUNIT_ASSERT_EQUAL(u"Spellbook Colors"_ustr, pTheme->getColorSet()->getName());
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(3368703),
+                             sal_Int32(pTheme->getColor(model::ThemeColorType::Accent1)));
+        CPPUNIT_ASSERT_EQUAL(u"Spellbook Fonts"_ustr, pTheme->getFontScheme().getName());
+        CPPUNIT_ASSERT_EQUAL(u"Liberation Sans"_ustr,
+                             pTheme->getFontScheme().getMajorLatin().maTypeface);
+        CPPUNIT_ASSERT_EQUAL(u"Noto Sans CJK KR"_ustr,
+                             pTheme->getFontScheme().getMinorAsian().maTypeface);
+    };
+    assertTheme();
+    pUndoManager->Undo();
+    const auto pUndoneTheme = pMaster->getSdrPageProperties().getTheme();
+    CPPUNIT_ASSERT_EQUAL(aOldThemeName,
+                         pUndoneTheme ? pUndoneTheme->GetName() : OUString());
+    pUndoManager->Redo();
+    assertTheme();
+
+    saveAndReload(TestFilter::PPTX);
+    pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    pDoc = pImpressDocument->GetDoc();
+    pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    pMaster = pDoc->GetMasterSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pMaster);
+    CPPUNIT_ASSERT_EQUAL(Size(30000, 17000), pPage->GetSize());
+    CPPUNIT_ASSERT_EQUAL(Size(30000, 17000), pMaster->GetSize());
+    assertTheme();
+}
