+class SetMasterThemeUndoAction final : public SdUndoAction
+{
+public:
+    SetMasterThemeUndoAction(SdDrawDocument& rDoc, SdPage& rMaster,
+                             std::shared_ptr<model::Theme> pOldTheme,
+                             std::shared_ptr<model::Theme> pNewTheme)
+        : SdUndoAction(rDoc)
+        , mrMaster(rMaster)
+        , mpOldTheme(std::move(pOldTheme))
+        , mpNewTheme(std::move(pNewTheme))
+    {
+    }
+
+    void Undo() override { apply(mpOldTheme); }
+    void Redo() override { apply(mpNewTheme); }
+
+private:
+    void apply(const std::shared_ptr<model::Theme>& pTheme)
+    {
+        mrMaster.getSdrPageProperties().setTheme(
+            pTheme ? std::make_shared<model::Theme>(*pTheme) : nullptr);
+        mrMaster.ActionChanged();
+        mrDoc.SetChanged();
+    }
+
+    SdPage& mrMaster;
+    std::shared_ptr<model::Theme> mpOldTheme;
+    std::shared_ptr<model::Theme> mpNewTheme;
+};
