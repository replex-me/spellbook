+void SdMiscTest::testApiTableCellPropertyUndo()
+{
+    createSdImpressDoc("tdf99396.odp");
+    auto pXImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pXImpressDocument);
+    SdPage* pPage = pXImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    auto pTableObject = dynamic_cast<sdr::table::SdrTableObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTableObject);
+
+    uno::Reference<table::XTable> xTable = pTableObject->getTable();
+    uno::Reference<table::XTableColumns> xColumns = xTable->getColumns();
+    pXImpressDocument->GetDoc()->EnableUndo(false);
+    xColumns->insertByIndex(xColumns->getCount(), 1);
+    pXImpressDocument->GetDoc()->EnableUndo(true);
+
+    uno::Reference<beans::XPropertySet> xCell(
+        xTable->getCellByPosition(0, 0), uno::UNO_QUERY_THROW);
+    sal_Int32 nOriginalColor = 0;
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nOriginalColor;
+    const sal_Int32 nChangedColor
+        = nOriginalColor == sal_Int32(0x00ff00) ? sal_Int32(0x0000ff) : sal_Int32(0x00ff00);
+    auto* pUndoManager = pXImpressDocument->GetDocShell()->GetUndoManager();
+    CPPUNIT_ASSERT_EQUAL(size_t(0), pUndoManager->GetUndoActionCount());
+
+    xCell->setPropertyValue(u"FillColor"_ustr, cpo::uno::Any(nChangedColor));
+    sal_Int32 nCurrentColor = 0;
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nChangedColor, nCurrentColor);
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+
+    pUndoManager->Undo();
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nOriginalColor, nCurrentColor);
+    pUndoManager->Redo();
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nChangedColor, nCurrentColor);
+
+    // The browser adapter formats a cell by setting several bounded UNO
+    // properties inside one document Undo group. Cover both multiple
+    // properties on one cell and multiple cells in the same transaction.
+    uno::Reference<beans::XPropertySet> xSecondCell(
+        xTable->getCellByPosition(1, 0), uno::UNO_QUERY_THROW);
+    sal_Int16 nOriginalTransparency = 0;
+    xCell->getPropertyValue(u"FillTransparence"_ustr) >>= nOriginalTransparency;
+    sal_Int32 nSecondOriginalColor = 0;
+    xSecondCell->getPropertyValue(u"FillColor"_ustr) >>= nSecondOriginalColor;
+    const sal_Int16 nChangedTransparency
+        = nOriginalTransparency == sal_Int16(42) ? sal_Int16(24) : sal_Int16(42);
+    const sal_Int32 nSecondChangedColor
+        = nSecondOriginalColor == sal_Int32(0xff00ff) ? sal_Int32(0x00ffff)
+                                                      : sal_Int32(0xff00ff);
+    pUndoManager->Clear();
+
+    pXImpressDocument->GetDoc()->BegUndo(u"Format table cells"_ustr);
+    xCell->setPropertyValue(u"FillColor"_ustr, cpo::uno::Any(nOriginalColor));
+    xCell->setPropertyValue(u"FillTransparence"_ustr,
+                            cpo::uno::Any(nChangedTransparency));
+    xSecondCell->setPropertyValue(u"FillColor"_ustr,
+                                  cpo::uno::Any(nSecondChangedColor));
+    pXImpressDocument->GetDoc()->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+
+    sal_Int16 nCurrentTransparency = 0;
+    sal_Int32 nSecondCurrentColor = 0;
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nCurrentColor;
+    xCell->getPropertyValue(u"FillTransparence"_ustr) >>= nCurrentTransparency;
+    xSecondCell->getPropertyValue(u"FillColor"_ustr) >>= nSecondCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nOriginalColor, nCurrentColor);
+    CPPUNIT_ASSERT_EQUAL(nChangedTransparency, nCurrentTransparency);
+    CPPUNIT_ASSERT_EQUAL(nSecondChangedColor, nSecondCurrentColor);
+
+    pUndoManager->Undo();
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nCurrentColor;
+    xCell->getPropertyValue(u"FillTransparence"_ustr) >>= nCurrentTransparency;
+    xSecondCell->getPropertyValue(u"FillColor"_ustr) >>= nSecondCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nChangedColor, nCurrentColor);
+    CPPUNIT_ASSERT_EQUAL(nOriginalTransparency, nCurrentTransparency);
+    CPPUNIT_ASSERT_EQUAL(nSecondOriginalColor, nSecondCurrentColor);
+
+    pUndoManager->Redo();
+    xCell->getPropertyValue(u"FillColor"_ustr) >>= nCurrentColor;
+    xCell->getPropertyValue(u"FillTransparence"_ustr) >>= nCurrentTransparency;
+    xSecondCell->getPropertyValue(u"FillColor"_ustr) >>= nSecondCurrentColor;
+    CPPUNIT_ASSERT_EQUAL(nOriginalColor, nCurrentColor);
+    CPPUNIT_ASSERT_EQUAL(nChangedTransparency, nCurrentTransparency);
+    CPPUNIT_ASSERT_EQUAL(nSecondChangedColor, nSecondCurrentColor);
+}
