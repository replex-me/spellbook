@@ -445,6 +447,49 @@ void SdMiscTest::testApiTableCellPropertyUndo()
     CPPUNIT_ASSERT_EQUAL(nOriginalColor, nCurrentColor);
     CPPUNIT_ASSERT_EQUAL(nChangedTransparency, nCurrentTransparency);
     CPPUNIT_ASSERT_EQUAL(nSecondChangedColor, nSecondCurrentColor);
+
+    // Character and paragraph formatting must be applied to the cell's text
+    // range so PPTX writes explicit run/paragraph properties. That UNO cursor
+    // uses SvxTextEditSourceImpl rather than Cell::setPropertyValue(), but it
+    // still belongs to the same document transaction and must be reversible.
+    uno::Reference<text::XText> xCellText(xCell, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextCursor> xTextCursor = xCellText->createTextCursor();
+    xTextCursor->gotoEnd(true);
+    uno::Reference<beans::XPropertySet> xTextProperties(xTextCursor, uno::UNO_QUERY_THROW);
+    sal_Int32 nOriginalTextColor = 0;
+    float fOriginalTextHeight = 0.0f;
+    xTextProperties->getPropertyValue(u"CharColor"_ustr) >>= nOriginalTextColor;
+    xTextProperties->getPropertyValue(u"CharHeight"_ustr) >>= fOriginalTextHeight;
+    const sal_Int32 nChangedTextColor
+        = nOriginalTextColor == sal_Int32(0xff0000) ? sal_Int32(0x0000ff)
+                                                     : sal_Int32(0xff0000);
+    const float fChangedTextHeight = fOriginalTextHeight == 22.0f ? 21.0f : 22.0f;
+    pUndoManager->Clear();
+
+    pXImpressDocument->GetDoc()->BegUndo(u"Format table cell text"_ustr);
+    xTextProperties->setPropertyValue(u"CharColor"_ustr,
+                                      cpo::uno::Any(nChangedTextColor));
+    xTextProperties->setPropertyValue(u"CharHeight"_ustr,
+                                      cpo::uno::Any(fChangedTextHeight));
+    pXImpressDocument->GetDoc()->EndUndo();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+
+    sal_Int32 nCurrentTextColor = 0;
+    float fCurrentTextHeight = 0.0f;
+    xTextProperties->getPropertyValue(u"CharColor"_ustr) >>= nCurrentTextColor;
+    xTextProperties->getPropertyValue(u"CharHeight"_ustr) >>= fCurrentTextHeight;
+    CPPUNIT_ASSERT_EQUAL(nChangedTextColor, nCurrentTextColor);
+    CPPUNIT_ASSERT_EQUAL(fChangedTextHeight, fCurrentTextHeight);
+    pUndoManager->Undo();
+    xTextProperties->getPropertyValue(u"CharColor"_ustr) >>= nCurrentTextColor;
+    xTextProperties->getPropertyValue(u"CharHeight"_ustr) >>= fCurrentTextHeight;
+    CPPUNIT_ASSERT_EQUAL(nOriginalTextColor, nCurrentTextColor);
+    CPPUNIT_ASSERT_EQUAL(fOriginalTextHeight, fCurrentTextHeight);
+    pUndoManager->Redo();
+    xTextProperties->getPropertyValue(u"CharColor"_ustr) >>= nCurrentTextColor;
+    xTextProperties->getPropertyValue(u"CharHeight"_ustr) >>= fCurrentTextHeight;
+    CPPUNIT_ASSERT_EQUAL(nChangedTextColor, nCurrentTextColor);
+    CPPUNIT_ASSERT_EQUAL(fChangedTextHeight, fCurrentTextHeight);
 }
 
