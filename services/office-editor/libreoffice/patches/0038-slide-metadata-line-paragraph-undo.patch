+                               SlideMetadataState aOldState,
+                               SlideMetadataState aNewState)
+        : SdUndoAction(rDoc)
+        , mrPage(rPage)
+        , maOldState(std::move(aOldState))
+        , maNewState(std::move(aNewState))
+    {
+    }
+
+    void Undo() override { lcl_SetSlideMetadata(mrDoc, mrPage, maOldState); }
+    void Redo() override { lcl_SetSlideMetadata(mrDoc, mrPage, maNewState); }
+
+private:
+    SdPage& mrPage;
+    SlideMetadataState maOldState;
+    SlideMetadataState maNewState;
+};
