+void handleSetSlideProperties(SlideCommandContext& rCtx, const std::string& /*rKey*/,
+                              const boost::property_tree::ptree& rValue)
+{
+    static const std::set<std::string> aAllowedKeys = {
+        "IsFooterVisible", "FooterText", "IsPageNumberVisible",
+        "IsDateTimeVisible", "IsDateTimeFixed", "DateTimeText",
+        "DateTimeFormat", "HighResDuration", "IsBackgroundObjectsVisible",
+    };
+    for (const auto& rEntry : rValue)
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(
+                u"Unsupported slide property: "_ustr + OUString::fromUtf8(rEntry.first),
+                nullptr, 0);
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Slide property target is unavailable"_ustr,
+                                              nullptr, 0);
+    SlideMetadataState aOldState = lcl_GetSlideMetadata(*rCtx.mpDoc, *pPage);
+    SlideMetadataState aNewState = aOldState;
+    bool bSupplied = false;
+    const auto setBoolean = [&](const char* pName, bool& rTarget) {
+        if (const auto oValue = rValue.get_optional<bool>(pName))
+        {
+            rTarget = *oValue;
+            bSupplied = true;
+        }
+    };
+    setBoolean("IsFooterVisible", aNewState.maHeaderFooter.mbFooterVisible);
+    setBoolean("IsPageNumberVisible", aNewState.maHeaderFooter.mbSlideNumberVisible);
+    setBoolean("IsDateTimeVisible", aNewState.maHeaderFooter.mbDateTimeVisible);
+    setBoolean("IsDateTimeFixed", aNewState.maHeaderFooter.mbDateTimeIsFixed);
+    setBoolean("IsBackgroundObjectsVisible", aNewState.mbBackgroundObjectsVisible);
+    const auto setText = [&](const char* pName, OUString& rTarget) {
+        if (const auto oValue = rValue.get_optional<std::string>(pName))
+        {
+            const OUString aText = OUString::fromUtf8(*oValue);
+            if (aText.getLength() > 1024)
+                throw lang::IllegalArgumentException(u"Slide metadata text is too long"_ustr,
+                                                      nullptr, 0);
+            for (sal_Int32 nIndex = 0; nIndex < aText.getLength(); ++nIndex)
+                if (aText[nIndex] < 0x20 && aText[nIndex] != '\t'
+                    && aText[nIndex] != '\n' && aText[nIndex] != '\r')
+                    throw lang::IllegalArgumentException(
+                        u"Slide metadata text contains a control character"_ustr, nullptr, 0);
+            rTarget = aText;
+            bSupplied = true;
+        }
+    };
+    setText("FooterText", aNewState.maHeaderFooter.maFooterText);
+    setText("DateTimeText", aNewState.maHeaderFooter.maDateTimeText);
+    if (const auto oFormat = rValue.get_optional<sal_Int32>("DateTimeFormat"))
+    {
+        if (*oFormat < 0 || *oFormat > 255)
+            throw lang::IllegalArgumentException(u"Date/time format is invalid"_ustr,
+                                                  nullptr, 0);
+        aNewState.maHeaderFooter.meDateFormat
+            = static_cast<SvxDateFormat>(*oFormat & 0x0f);
+        aNewState.maHeaderFooter.meTimeFormat
+            = static_cast<SvxTimeFormat>((*oFormat >> 4) & 0x0f);
+        bSupplied = true;
+    }
+    if (const auto oDuration = rValue.get_optional<double>("HighResDuration"))
+    {
+        if (!std::isfinite(*oDuration) || *oDuration < 0.0 || *oDuration > 86400.0)
+            throw lang::IllegalArgumentException(u"Slide duration is invalid"_ustr, nullptr, 0);
+        aNewState.mfHighResolutionDuration = *oDuration;
