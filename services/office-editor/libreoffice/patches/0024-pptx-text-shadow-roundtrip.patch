+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxTextShadowRoundTrip)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xDrawPagesSupplier(mxComponent,
+                                                                   uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xDrawPage(
+        xDrawPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xDrawPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance(u"com.sun.star.drawing.TextShape"_ustr),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(10000, 3000));
+    xShapes->add(xShape);
+
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString(u"Shadow text"_ustr);
+    uno::Reference<text::XTextCursor> xTextCursor = xText->createTextCursor();
+    xTextCursor->gotoEnd(true);
+    uno::Reference<beans::XPropertySet> xCursor(xTextCursor, uno::UNO_QUERY_THROW);
+    xCursor->setPropertyValue(u"CharShadowed"_ustr, cpo::uno::Any(true));
+    bool bShadowedBeforeSave = false;
+    xCursor->getPropertyValue(u"CharShadowed"_ustr) >>= bShadowedBeforeSave;
+    CPPUNIT_ASSERT(bShadowedBeforeSave);
+    uno::Reference<container::XEnumerationAccess> xParagraphs(xText, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XEnumeration> xParagraphEnumeration = xParagraphs->createEnumeration();
+    CPPUNIT_ASSERT(xParagraphEnumeration->hasMoreElements());
+    uno::Reference<container::XEnumerationAccess> xParagraph(
+        xParagraphEnumeration->nextElement(), uno::UNO_QUERY_THROW);
+    uno::Reference<container::XEnumeration> xPortionEnumeration = xParagraph->createEnumeration();
+    CPPUNIT_ASSERT(xPortionEnumeration->hasMoreElements());
+    uno::Reference<beans::XPropertySet> xPortion(
+        xPortionEnumeration->nextElement(), uno::UNO_QUERY_THROW);
+    bool bPortionShadowedBeforeSave = false;
+    xPortion->getPropertyValue(u"CharShadowed"_ustr) >>= bPortionShadowedBeforeSave;
+    CPPUNIT_ASSERT(bPortionShadowedBeforeSave);
+
+    saveAndReload(TestFilter::PPTX);
+    xmlDocUniquePtr pXmlDoc = parseExport(u"ppt/slides/slide1.xml"_ustr);
+    assertXPath(pXmlDoc, "//a:outerShdw", 1);
+    xDrawPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xDrawPage.set(xDrawPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xShape.set(xDrawPage->getByIndex(xDrawPage->getCount() - 1), uno::UNO_QUERY_THROW);
+    xText.set(xShape, uno::UNO_QUERY_THROW);
+    xTextCursor = xText->createTextCursor();
+    xTextCursor->gotoEnd(true);
+    xCursor.set(xTextCursor, uno::UNO_QUERY_THROW);
+    bool bShadowed = false;
+    xCursor->getPropertyValue(u"CharShadowed"_ustr) >>= bShadowed;
+    CPPUNIT_ASSERT(bShadowed);
+}
