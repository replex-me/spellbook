+void SdMiscTest::testApiTableInsertInheritsDimensions()
+{
+    createSdImpressDoc("tdf99396.odp");
+    auto pXImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pXImpressDocument);
+    SdPage* pPage = pXImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    auto pTableObject = dynamic_cast<sdr::table::SdrTableObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTableObject);
+
+    uno::Reference<table::XTable> xTable = pTableObject->getTable();
+    uno::Reference<table::XTableRows> xRows = xTable->getRows();
+    uno::Reference<table::XTableColumns> xColumns = xTable->getColumns();
+    const sal_Int32 nOriginalRows = xRows->getCount();
+    const sal_Int32 nOriginalColumns = xColumns->getCount();
+    CPPUNIT_ASSERT(nOriginalRows > 0);
+    CPPUNIT_ASSERT(nOriginalColumns > 0);
+
+    uno::Reference<beans::XPropertySet> xSourceRow(xRows->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xSourceColumn(xColumns->getByIndex(0),
+                                                      uno::UNO_QUERY_THROW);
+    pXImpressDocument->GetDoc()->EnableUndo(false);
+    xSourceRow->setPropertyValue(u"Height"_ustr, cpo::uno::Any(sal_Int32(2234)));
+    xSourceColumn->setPropertyValue(u"Width"_ustr, cpo::uno::Any(sal_Int32(4567)));
+    pXImpressDocument->GetDoc()->EnableUndo(true);
+    sal_Int32 nExpectedHeight = 0;
+    sal_Int32 nExpectedWidth = 0;
+    xSourceRow->getPropertyValue(u"Height"_ustr) >>= nExpectedHeight;
+    xSourceColumn->getPropertyValue(u"Width"_ustr) >>= nExpectedWidth;
+    auto* pUndoManager = pXImpressDocument->GetDocShell()->GetUndoManager();
+    CPPUNIT_ASSERT_EQUAL(size_t(0), pUndoManager->GetUndoActionCount());
+
+    xRows->insertByIndex(0, 1);
+    uno::Reference<beans::XPropertySet> xInsertedRow(xRows->getByIndex(0),
+                                                     uno::UNO_QUERY_THROW);
+    sal_Int32 nInsertedHeight = 0;
+    xInsertedRow->getPropertyValue(u"Height"_ustr) >>= nInsertedHeight;
+    CPPUNIT_ASSERT_EQUAL(nExpectedHeight, nInsertedHeight);
+    CPPUNIT_ASSERT_EQUAL(nOriginalRows + 1, xRows->getCount());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalRows, xRows->getCount());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalRows + 1, xRows->getCount());
+    xInsertedRow.set(xRows->getByIndex(0), uno::UNO_QUERY_THROW);
+    xInsertedRow->getPropertyValue(u"Height"_ustr) >>= nInsertedHeight;
+    CPPUNIT_ASSERT_EQUAL(nExpectedHeight, nInsertedHeight);
+    pUndoManager->Undo();
+
+    xColumns->insertByIndex(0, 1);
+    uno::Reference<beans::XPropertySet> xInsertedColumn(xColumns->getByIndex(0),
+                                                        uno::UNO_QUERY_THROW);
+    sal_Int32 nInsertedWidth = 0;
+    xInsertedColumn->getPropertyValue(u"Width"_ustr) >>= nInsertedWidth;
+    CPPUNIT_ASSERT_EQUAL(nExpectedWidth, nInsertedWidth);
+    CPPUNIT_ASSERT_EQUAL(nOriginalColumns + 1, xColumns->getCount());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalColumns, xColumns->getCount());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalColumns + 1, xColumns->getCount());
+    xInsertedColumn.set(xColumns->getByIndex(0), uno::UNO_QUERY_THROW);
+    xInsertedColumn->getPropertyValue(u"Width"_ustr) >>= nInsertedWidth;
+    CPPUNIT_ASSERT_EQUAL(nExpectedWidth, nInsertedWidth);
+}
