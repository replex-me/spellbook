+void handleSetDiagramNode(SlideCommandContext& rCtx, const std::string& rKey,
+                          const boost::property_tree::ptree& rValue)
+{
+    static const std::set<std::string> aAllowedKeys = {
+        "Action", "ExpectedText", "Occurrence", "Text"
+    };
+    for (const auto& rEntry : rValue)
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(u"Unsupported diagram node field"_ustr,
+                                                  nullptr, 0);
+
+    const std::string aAction = rValue.get<std::string>("Action");
+    const OUString aExpectedText = OUString::fromUtf8(rValue.get<std::string>("ExpectedText"));
+    const sal_Int32 nOccurrence = rValue.get<sal_Int32>("Occurrence");
+    const OUString aText = OUString::fromUtf8(rValue.get<std::string>("Text"));
+    if ((aAction != "set" && aAction != "add" && aAction != "delete")
+        || nOccurrence < 0 || nOccurrence > 999 || aExpectedText.getLength() > 4000
+        || aText.getLength() > 4000)
+        throw lang::IllegalArgumentException(u"Invalid diagram node mutation"_ustr, nullptr, 0);
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Diagram slide is unavailable"_ustr, nullptr, 0);
+    SdrObject* pObject = lcl_ResolveObjectPath(*pPage, rKey.substr(15));
+    if (!pObject->isDiagram())
+        throw lang::IllegalArgumentException(u"Object is not a semantic diagram"_ustr, nullptr, 0);
+    auto xHelper = pObject->getDiagramHelper();
+    if (!xHelper)
+        throw lang::IllegalArgumentException(u"Diagram model is unavailable"_ustr, nullptr, 0);
+    if (aAction == "set" && aExpectedText == aText)
+        return;
+
+    OUString aNodeId;
+    if (aAction != "add")
+    {
+        sal_Int32 nMatch = 0;
+        std::vector<OUString> aParents{ OUString() };
+        std::set<OUString> aVisited;
+        for (size_t nParent = 0;
+             nParent < aParents.size() && aVisited.size() < 1000 && aNodeId.isEmpty();
+             ++nParent)
+        {
+            for (const auto& [rId, rText] : xHelper->getDiagramChildren(aParents[nParent]))
+            {
+                if (rId.isEmpty() || !aVisited.insert(rId).second)
+                    continue;
+                if (rText == aExpectedText && nMatch++ == nOccurrence)
+                {
+                    aNodeId = rId;
+                    break;
+                }
+                aParents.push_back(rId);
+            }
+        }
+        if (aNodeId.isEmpty())
+            throw lang::IllegalArgumentException(u"Diagram node changed"_ustr, nullptr, 0);
+    }
+
+    auto xStartState = xHelper->extractDiagramDataState();
+    if (!xStartState)
+        throw lang::IllegalArgumentException(u"Diagram state is unavailable"_ustr, nullptr, 0);
+    SdrTextObj* pChangedTextObject = nullptr;
+    std::optional<OutlinerParaObject> oOldText;
+    try
+    {
+        if (aAction == "add")
+        {
+            if (xHelper
+                    ->addDiagramNode(aText, pObject->getSdrModelFromSdrObject(),
+                                     OUString(), false)
+                    .isEmpty())
+                throw lang::IllegalArgumentException(u"Diagram node could not be added"_ustr,
+                                                      nullptr, 0);
+            xHelper->reLayout();
+        }
+        else if (aAction == "delete")
+        {
+            if (!xHelper->removeDiagramNode(aNodeId,
+                                            pObject->getSdrModelFromSdrObject()))
+                throw lang::IllegalArgumentException(
+                    u"Diagram node cannot be deleted while it owns children or is the last node"_ustr,
+                    nullptr, 0);
+            xHelper->reLayout();
+        }
+        else
+        {
+            SdrTextObj* pFirstTextObject = nullptr;
+            sal_Int32 nFirstParagraph = -1;
+            sal_Int32 nChangedParagraph = -1;
+            for (const auto& rConnection : xStartState->getConnections())
+            {
+                if (!rConnection.is()
+                    || rConnection->mnXMLType != svx::diagram::TypeConstant::XML_presOf
+                    || rConnection->msSourceId != aNodeId)
+                    continue;
+                SdrTextObj* pCandidate = nullptr;
+                SdrObjListIter aIterator(*pObject, SdrIterMode::DeepNoGroups);
+                while (aIterator.IsMore())
+                {
+                    SdrObject* pDescendant = aIterator.Next();
+                    if (pDescendant && pDescendant->getDiagramDataModelID()
+                                           == rConnection->msDestId
+                        && pDescendant->IsSdrTextObj())
+                    {
+                        pCandidate = static_cast<SdrTextObj*>(pDescendant);
+                        break;
+                    }
+                }
+                if (!pCandidate || !pCandidate->GetOutlinerParaObject())
+                    continue;
+                const size_t nRepresentedNodes = std::count_if(
+                    xStartState->getConnections().begin(),
+                    xStartState->getConnections().end(), [&](const auto& rOther) {
+                        return rOther.is()
+                               && rOther->mnXMLType
+                                      == svx::diagram::TypeConstant::XML_presOf
+                               && rOther->msDestId == rConnection->msDestId;
+                    });
+                const sal_Int32 nParagraph
+                    = nRepresentedNodes > 1 ? rConnection->getParagraphIndex() : -1;
+                Outliner* pOutliner = rCtx.mpDoc->GetInternalOutliner();
+                const OutlinerMode eOldMode = pOutliner->GetOutlinerMode();
+                comphelper::ScopeGuard const aOutlinerGuard(
+                    [pOutliner, eOldMode]() { pOutliner->Init(eOldMode); });
+                pOutliner->Init(pCandidate->GetOutlinerParaObject()->GetOutlinerMode());
+                pOutliner->SetText(*pCandidate->GetOutlinerParaObject());
+                const sal_Int32 nParagraphCount = pOutliner->GetParagraphCount();
+                if (nParagraphCount <= 0 || nParagraph >= nParagraphCount)
+                    continue;
+                const OUString aCurrentText
+                    = nParagraph >= 0
+                          ? pOutliner->GetText(pOutliner->GetParagraph(nParagraph))
+                          : pOutliner->GetText(pOutliner->GetParagraph(0), nParagraphCount);
+                if (!pFirstTextObject)
+                {
+                    pFirstTextObject = pCandidate;
+                    nFirstParagraph = nParagraph;
+                }
+                if (aCurrentText == aExpectedText)
+                {
+                    pChangedTextObject = pCandidate;
+                    nChangedParagraph = nParagraph;
+                    break;
+                }
+            }
+            if (!pChangedTextObject && aExpectedText.isEmpty())
+            {
+                pChangedTextObject = pFirstTextObject;
+                nChangedParagraph = nFirstParagraph;
+            }
+            if (!pChangedTextObject || !pChangedTextObject->GetOutlinerParaObject())
+                throw lang::IllegalArgumentException(u"Diagram node data is unavailable"_ustr,
+                                                      nullptr, 0);
+            oOldText.emplace(*pChangedTextObject->GetOutlinerParaObject());
+            if (rCtx.mbUndo)
+                rCtx.addUndo(rCtx.mpDoc->GetSdrUndoFactory().CreateUndoObjectSetText(
+                    *pChangedTextObject, 0));
+            Outliner* pOutliner = rCtx.mpDoc->GetInternalOutliner();
+            const OutlinerMode eOldMode = pOutliner->GetOutlinerMode();
+            comphelper::ScopeGuard const aOutlinerGuard(
+                [pOutliner, eOldMode]() { pOutliner->Init(eOldMode); });
+            pOutliner->Init(oOldText->GetOutlinerMode());
+            pOutliner->SetText(*oOldText);
+            const sal_Int32 nLastParagraph = pOutliner->GetParagraphCount() - 1;
+            const ESelection aSelection
+                = nChangedParagraph >= 0
+                      ? ESelection(nChangedParagraph, 0, nChangedParagraph,
+                                   pOutliner->GetText(
+                                       pOutliner->GetParagraph(nChangedParagraph))
+                                       .getLength())
+                      : ESelection(0, 0, nLastParagraph,
+                                   pOutliner->GetText(pOutliner->GetParagraph(nLastParagraph))
+                                       .getLength());
+            pOutliner->QuickInsertText(aText, aSelection);
+            pChangedTextObject->SetOutlinerParaObject(pOutliner->CreateParaObject());
+            xHelper->TextInformationChange();
+        }
+    }
+    catch (...)
+    {
+        if (!rCtx.mbUndo && oOldText && pChangedTextObject)
+        {
+            pChangedTextObject->SetOutlinerParaObject(oOldText);
+            xHelper->TextInformationChange();
+        }
+        else if (!rCtx.mbUndo && aAction != "set")
+        {
+            xHelper->applyDiagramDataState(xStartState);
+            xHelper->reLayout();
+        }
+        throw;
+    }
+    pObject->SetChanged();
+    pObject->BroadcastObjectChange();
+    rCtx.touch(pPage);
+}
+
+void handleSetEquationSource(SlideCommandContext& rCtx, const std::string& rKey,
+                             const boost::property_tree::ptree& rValue)
+{
+    static const std::set<std::string> aAllowedKeys = { "ExpectedSource", "Source" };
+    for (const auto& rEntry : rValue)
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(u"Unsupported equation field"_ustr, nullptr, 0);
+
+    const OUString aExpectedSource
+        = OUString::fromUtf8(rValue.get<std::string>("ExpectedSource"));
+    const OUString aSource = OUString::fromUtf8(rValue.get<std::string>("Source"));
+    if (aExpectedSource.getLength() > 20000 || aSource.getLength() > 20000)
+        throw lang::IllegalArgumentException(u"Equation source is too large"_ustr, nullptr, 0);
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Equation slide is unavailable"_ustr, nullptr, 0);
+    SdrObject* pObject = lcl_ResolveObjectPath(*pPage, rKey.substr(18));
+    SdrOle2Obj* pOleObject = dynamic_cast<SdrOle2Obj*>(pObject);
+    if (!pOleObject)
+        throw lang::IllegalArgumentException(u"Object is not an embedded equation"_ustr,
+                                              nullptr, 0);
+    uno::Reference<frame::XModel> xModel = pOleObject->getXModel();
+    uno::Reference<lang::XServiceInfo> xServiceInfo(xModel, uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xProperties(xModel, uno::UNO_QUERY);
+    if (!xServiceInfo.is() || !xProperties.is()
+        || !xServiceInfo->supportsService(u"com.sun.star.formula.FormulaProperties"_ustr))
+        throw lang::IllegalArgumentException(u"Embedded object is not a Math equation"_ustr,
+                                              nullptr, 0);
+    OUString aCurrentSource;
+    xProperties->getPropertyValue(u"Formula"_ustr) >>= aCurrentSource;
+    if (aCurrentSource != aExpectedSource)
+        throw lang::IllegalArgumentException(u"Equation source changed"_ustr, nullptr, 0);
+    if (aCurrentSource == aSource)
+        return;
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<SetEquationSourceUndoAction>(
+            *rCtx.mpDoc, *pObject, aCurrentSource, aSource));
+    xProperties->setPropertyValue(u"Formula"_ustr, cpo::uno::Any(aSource));
+    pOleObject->SetChanged();
+    pOleObject->BroadcastObjectChange();
+    rCtx.touch(pPage);
+}
