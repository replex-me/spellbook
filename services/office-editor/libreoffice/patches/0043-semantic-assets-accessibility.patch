+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureAssetReplacementUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    const size_t nInitialCount = pPage->GetObjCount();
+
+    pDoc->EnableUndo(false);
+    Bitmap aOldBitmap(Size(4, 4), vcl::PixelFormat::N24_BPP);
+    aOldBitmap.Erase(COL_RED);
+    Bitmap aNewBitmap(Size(4, 4), vcl::PixelFormat::N24_BPP);
+    aNewBitmap.Erase(COL_BLUE);
+    rtl::Reference<SdrGrafObj> pOriginal = new SdrGrafObj(
+        *pDoc, Graphic(aOldBitmap), tools::Rectangle(1100, 1200, 4100, 3200));
+    rtl::Reference<SdrGrafObj> pInserted = new SdrGrafObj(
+        *pDoc, Graphic(aNewBitmap), tools::Rectangle(8000, 7000, 9000, 8000));
+    pOriginal->SetName(u"Original asset"_ustr);
+    pOriginal->SetTitle(u"Accessible asset"_ustr);
+    pInserted->SetName(u"Inserted asset"_ustr);
+    pPage->NbcInsertObject(pOriginal.get());
+    pPage->NbcInsertObject(pInserted.get());
+    pDoc->EnableUndo(true);
+
+    const OUString aJson
+        = uR"json({"Transforms":{"SlideCommands":[{"JumpToSlide":0},{"ReplaceWithInsertedObject.)json"_ustr
+          + OUString::number(nInitialCount) + uR"json(":")json"_ustr
+          + OUString::number(nInitialCount + 1) + uR"json("}]}})json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(nInitialCount + 1, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    CPPUNIT_ASSERT_EQUAL(pOriginal.get(), pPage->GetObj(nInitialCount));
+    CPPUNIT_ASSERT_EQUAL(u"Original asset"_ustr, pOriginal->GetName());
+    CPPUNIT_ASSERT_EQUAL(u"Accessible asset"_ustr, pOriginal->GetTitle());
+    CPPUNIT_ASSERT_EQUAL(Graphic(aNewBitmap).GetChecksum(),
+                         pOriginal->GetGraphic().GetChecksum());
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nInitialCount + 2, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(pOriginal.get(), pPage->GetObj(nInitialCount));
+    CPPUNIT_ASSERT_EQUAL(pInserted.get(), pPage->GetObj(nInitialCount + 1));
+    CPPUNIT_ASSERT_EQUAL(Graphic(aOldBitmap).GetChecksum(),
+                         pOriginal->GetGraphic().GetChecksum());
+
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nInitialCount + 1, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(pOriginal.get(), pPage->GetObj(nInitialCount));
+    CPPUNIT_ASSERT_EQUAL(Graphic(aNewBitmap).GetChecksum(),
+                         pOriginal->GetGraphic().GetChecksum());
+}
