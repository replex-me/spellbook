+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureSharedDiagramTextIsolation)
+{
+    createSdImpressDoc("pptx/Bar_List.pptx");
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    SdrObject* pDiagram = pPage->GetObj(0);
+    CPPUNIT_ASSERT(pDiagram);
+    CPPUNIT_ASSERT(pDiagram->isDiagram());
+    const auto xHelper = pDiagram->getDiagramHelper();
+    CPPUNIT_ASSERT(xHelper);
+
+    auto collectTexts = [&]() {
+        std::vector<OUString> aTexts;
+        std::function<void(const OUString&)> collectChildren = [&](const OUString& rParent) {
+            for (const auto& rNode : xHelper->getDiagramChildren(rParent))
+            {
+                aTexts.push_back(rNode.second);
+                collectChildren(rNode.first);
+            }
+        };
+        collectChildren(OUString());
+        return aTexts;
+    };
+    auto containsText = [](const std::vector<OUString>& rTexts, const OUString& rExpected) {
+        return std::find(rTexts.begin(), rTexts.end(), rExpected) != rTexts.end();
+    };
+    const auto aBefore = collectTexts();
+    CPPUNIT_ASSERT(containsText(aBefore, u"Eleven"_ustr));
+    CPPUNIT_ASSERT(containsText(aBefore, u"Twelve"_ustr));
+    CPPUNIT_ASSERT(containsText(aBefore, u"Thirteen"_ustr));
+
+    static constexpr OUString aJson
+        = uR"json({"Transforms":{"SlideCommands":[{"JumpToSlide":0},{"SetDiagramNode.0":{"Action":"set","ExpectedText":"Twelve","Occurrence":0,"Text":"Twelve updated"}}]}})json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    pUndoManager->Clear();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    const auto aAfter = collectTexts();
+    CPPUNIT_ASSERT(containsText(aAfter, u"Eleven"_ustr));
+    CPPUNIT_ASSERT(containsText(aAfter, u"Twelve updated"_ustr));
+    CPPUNIT_ASSERT(containsText(aAfter, u"Thirteen"_ustr));
+    CPPUNIT_ASSERT(!containsText(aAfter, u"Twelve"_ustr));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT(containsText(collectTexts(), u"Twelve"_ustr));
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT(containsText(collectTexts(), u"Twelve updated"_ustr));
 }
 
