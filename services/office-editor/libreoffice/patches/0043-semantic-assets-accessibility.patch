+class SetEquationSourceUndoAction final : public SdUndoAction
+{
+public:
+    SetEquationSourceUndoAction(SdDrawDocument& rDoc, SdrObject& rObject,
+                                OUString aOldSource, OUString aNewSource)
+        : SdUndoAction(rDoc)
+        , mxObject(&rObject)
+        , maOldSource(std::move(aOldSource))
+        , maNewSource(std::move(aNewSource))
+    {
+    }
+
+    void Undo() override { apply(maOldSource); }
+    void Redo() override { apply(maNewSource); }
+
+private:
+    void apply(const OUString& rSource)
+    {
+        SdrOle2Obj* pOleObject = dynamic_cast<SdrOle2Obj*>(mxObject.get());
+        if (!pOleObject)
+            return;
+        uno::Reference<frame::XModel> xModel = pOleObject->getXModel();
+        uno::Reference<lang::XServiceInfo> xServiceInfo(xModel, uno::UNO_QUERY);
+        uno::Reference<beans::XPropertySet> xProperties(xModel, uno::UNO_QUERY);
+        if (!xServiceInfo.is() || !xProperties.is()
+            || !xServiceInfo->supportsService(u"com.sun.star.formula.FormulaProperties"_ustr))
+            return;
+        xProperties->setPropertyValue(u"Formula"_ustr, uno::Any(rSource));
+        pOleObject->SetChanged();
+        pOleObject->BroadcastObjectChange();
+    }
+
+    rtl::Reference<SdrObject> mxObject;
+    OUString maOldSource;
+    OUString maNewSource;
+};
