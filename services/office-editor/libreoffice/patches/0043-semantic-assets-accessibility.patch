+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureMediaPlaybackUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    const size_t nObjectIndex = pPage->GetObjCount();
+
+    pDoc->EnableUndo(false);
+    rtl::Reference<SdrMediaObj> pMedia = new SdrMediaObj(
+        *pDoc, tools::Rectangle(1100, 1200, 4100, 3200));
+    pPage->NbcInsertObject(pMedia.get());
+    pDoc->EnableUndo(true);
+    uno::Reference<beans::XPropertySet> xProperties(pMedia->getUnoShape(),
+                                                    uno::UNO_QUERY_THROW);
+    bool bOldLoop = false;
+    xProperties->getPropertyValue(u"Loop"_ustr) >>= bOldLoop;
+    const bool bNewLoop = !bOldLoop;
+    bool bOldMute = false;
+    xProperties->getPropertyValue(u"Mute"_ustr) >>= bOldMute;
+    const bool bNewMute = !bOldMute;
+    sal_Int16 nOldVolume = 0;
+    xProperties->getPropertyValue(u"VolumeDB"_ustr) >>= nOldVolume;
+    const sal_Int16 nNewVolume = nOldVolume == -900 ? -1200 : -900;
+    const OUString aJson
+        = uR"json({"Transforms":{"SlideCommands":[{"JumpToSlide":0},{"SetObjectProperties.)json"_ustr
+          + OUString::number(nObjectIndex) + uR"json(":{"Loop":)json"_ustr
+          + (bNewLoop ? u"true"_ustr : u"false"_ustr) + uR"json(,"Mute":)json"_ustr
+          + (bNewMute ? u"true"_ustr : u"false"_ustr) + uR"json(,"VolumeDB":)json"_ustr
+          + OUString::number(nNewVolume) + uR"json(}}]}})json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    bool bLoop = bOldLoop;
+    bool bMute = bOldMute;
+    sal_Int16 nVolume = nOldVolume;
+    xProperties->getPropertyValue(u"Loop"_ustr) >>= bLoop;
+    xProperties->getPropertyValue(u"Mute"_ustr) >>= bMute;
+    xProperties->getPropertyValue(u"VolumeDB"_ustr) >>= nVolume;
+    CPPUNIT_ASSERT_EQUAL(bNewLoop, bLoop);
+    CPPUNIT_ASSERT_EQUAL(bNewMute, bMute);
+    CPPUNIT_ASSERT_EQUAL(nNewVolume, nVolume);
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+
+    pUndoManager->Undo();
+    xProperties->getPropertyValue(u"Loop"_ustr) >>= bLoop;
+    xProperties->getPropertyValue(u"Mute"_ustr) >>= bMute;
+    xProperties->getPropertyValue(u"VolumeDB"_ustr) >>= nVolume;
+    CPPUNIT_ASSERT_EQUAL(bOldLoop, bLoop);
+    CPPUNIT_ASSERT_EQUAL(bOldMute, bMute);
+    CPPUNIT_ASSERT_EQUAL(nOldVolume, nVolume);
+
+    pUndoManager->Redo();
+    xProperties->getPropertyValue(u"Loop"_ustr) >>= bLoop;
+    xProperties->getPropertyValue(u"Mute"_ustr) >>= bMute;
+    xProperties->getPropertyValue(u"VolumeDB"_ustr) >>= nVolume;
+    CPPUNIT_ASSERT_EQUAL(bNewLoop, bLoop);
+    CPPUNIT_ASSERT_EQUAL(bNewMute, bMute);
+    CPPUNIT_ASSERT_EQUAL(nNewVolume, nVolume);
 }
 
