+void handleReplaceWithInsertedObject(SlideCommandContext& rCtx, const std::string& rKey,
+                                     const boost::property_tree::ptree& rValue)
+{
+    const std::string aOldPath = rKey.substr(26);
+    const std::string aNewPath = rValue.get_value<std::string>();
+    if (aOldPath.find('/') != std::string::npos || aNewPath.find('/') != std::string::npos)
+        throw lang::IllegalArgumentException(u"Asset replacement supports top-level objects"_ustr,
+                                              nullptr, 0);
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Asset slide is unavailable"_ustr, nullptr, 0);
+    SdrObject* pOldObject = lcl_ResolveObjectPath(*pPage, aOldPath);
+    SdrObject* pNewObject = lcl_ResolveObjectPath(*pPage, aNewPath);
+    if (pOldObject == pNewObject)
+        throw lang::IllegalArgumentException(u"Asset replacement targets are identical"_ustr,
+                                              nullptr, 0);
+
+    if (auto* pOldGraphic = dynamic_cast<SdrGrafObj*>(pOldObject))
+    {
+        auto* pNewGraphic = dynamic_cast<SdrGrafObj*>(pNewObject);
+        if (!pNewGraphic)
+            throw lang::IllegalArgumentException(u"Replacement asset type changed"_ustr,
+                                                  nullptr, 0);
+        if (rCtx.mbUndo)
+            rCtx.addUndo(std::make_unique<SetGraphicContentUndoAction>(
+                *rCtx.mpDoc, *pOldGraphic, pOldGraphic->GetGraphic(),
+                pNewGraphic->GetGraphic()));
+        pOldGraphic->SetGraphic(pNewGraphic->GetGraphic());
+    }
+    else if (auto* pOldMedia = dynamic_cast<SdrMediaObj*>(pOldObject))
+    {
+        auto* pNewMedia = dynamic_cast<SdrMediaObj*>(pNewObject);
+        if (!pNewMedia)
+            throw lang::IllegalArgumentException(u"Replacement asset type changed"_ustr,
+                                                  nullptr, 0);
