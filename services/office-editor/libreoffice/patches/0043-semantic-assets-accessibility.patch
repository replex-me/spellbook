+avmedia::MediaItem lcl_MediaReplacementState(const avmedia::MediaItem& rCurrent,
+                                              const avmedia::MediaItem& rReplacement)
+{
+    avmedia::MediaItem aResult(rCurrent);
+    aResult.setURL(rReplacement.getURL(), rReplacement.getTempURL(),
+                   rReplacement.getReferer());
+    aResult.setMimeType(rReplacement.getMimeType());
+    aResult.setGraphic(rReplacement.getGraphic());
+    aResult.setCrop(rReplacement.getCrop());
+    return aResult;
+}
