+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureInsertSlidePreservesSparseMaster)
+{
+    createSdImpressDoc();
+
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDoc = pDocument->GetDoc();
+    SdPage* pSource = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pSource);
+    SdPage* pMaster = static_cast<SdPage*>(&pSource->TRG_GetMasterPage());
+    CPPUNIT_ASSERT(pMaster);
+    uno::Reference<drawing::XMasterPagesSupplier> xMasterPagesSupplier(
+        mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xMasterPage(
+        xMasterPagesSupplier->getMasterPages()->getByIndex(0),
+        uno::UNO_QUERY_THROW);
+
+    // Imported blank layouts can intentionally omit title and body
+    // placeholders. Creating a slide with a concrete layout must add the
+    // required placeholders to that new slide, never to the reusable master.
+    for (PresObjKind eKind : { PresObjKind::Title, PresObjKind::Outline,
+                              PresObjKind::Text })
+    {
+        while (SdrObject* pObject = pMaster->GetPresObj(eKind))
+        {
+            uno::Reference<drawing::XShape> xShape = pObject->getUnoShape();
+            CPPUNIT_ASSERT(xShape.is());
+            xMasterPage->remove(xShape);
+        }
+    }
+    pMaster->SetAutoLayout(AUTOLAYOUT_NONE, false, false, true);
+    pSource->SetAutoLayout(AUTOLAYOUT_TITLE_CONTENT, true, false, true);
+    CPPUNIT_ASSERT(pSource->GetPresObj(PresObjKind::Title));
+    CPPUNIT_ASSERT(pSource->GetPresObj(PresObjKind::Outline));
+    const size_t nMasterObjectCount = pMaster->GetObjCount();
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"InsertMasterSlide": 0}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(2), pDoc->GetSdPageCount(PageKind::Standard));
+    SdPage* pInserted = pDoc->GetSdPage(1, PageKind::Standard);
+    CPPUNIT_ASSERT(pInserted);
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_TITLE_CONTENT, pInserted->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(pMaster,
+                         static_cast<SdPage*>(&pInserted->TRG_GetMasterPage()));
+    CPPUNIT_ASSERT(pInserted->GetPresObj(PresObjKind::Title));
+    CPPUNIT_ASSERT(pInserted->GetPresObj(PresObjKind::Outline));
+    CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, pMaster->GetObjCount());
+
+    pDocument->GetDocShell()->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(1), pDoc->GetSdPageCount(PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, pMaster->GetObjCount());
+    pDocument->GetDocShell()->GetUndoManager()->Redo();
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(2), pDoc->GetSdPageCount(PageKind::Standard));
+    pInserted = pDoc->GetSdPage(1, PageKind::Standard);
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_TITLE_CONTENT, pInserted->GetAutoLayout());
+    CPPUNIT_ASSERT(pInserted->GetPresObj(PresObjKind::Title));
+    CPPUNIT_ASSERT(pInserted->GetPresObj(PresObjKind::Outline));
+    CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, pMaster->GetObjCount());
+}
