+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTypedTextFormattingAppliesToAllScripts)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    auto* pTextObject = dynamic_cast<SdrTextObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTextObject);
+
+    pDoc->EnableUndo(false);
+    pTextObject->SetText(u"Latin 한글 عربي"_ustr);
+    pDoc->EnableUndo(true);
+    const OutlinerParaObject aOriginal(*pTextObject->GetOutlinerParaObject());
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetTextProperties.0": {
+                "FontHeightTwips": 420,
+                "FontFamily": "Liberation Sans",
+                "Bold": true,
+                "Italic": true
+            }}
+        ]
+    }
 }
+)json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
 
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    const OutlinerParaObject aChanged(*pTextObject->GetOutlinerParaObject());
+    CPPUNIT_ASSERT(aChanged != aOriginal);
+    const EditTextObject& rChangedText = aChanged.GetTextObject();
+    std::vector<EECharAttrib> aAttributes;
+    rChangedText.GetCharAttribs(0, aAttributes);
+    const sal_Int32 nTextLength = rChangedText.GetTextLen(0);
+    const auto isFullRange = [nTextLength](const EECharAttrib& rAttribute) {
+        return rAttribute.nStart == 0 && rAttribute.nEnd == nTextLength;
+    };
+
+    for (const sal_uInt16 nWhich : { EE_CHAR_FONTHEIGHT, EE_CHAR_FONTHEIGHT_CJK,
+                                    EE_CHAR_FONTHEIGHT_CTL })
+        CPPUNIT_ASSERT(std::any_of(
+            aAttributes.begin(), aAttributes.end(), [&](const EECharAttrib& rAttribute) {
+                const auto* pHeight = dynamic_cast<const SvxFontHeightItem*>(rAttribute.pAttr);
+                return rAttribute.pAttr->Which() == nWhich && isFullRange(rAttribute)
+                       && pHeight && pHeight->GetHeight() == 420;
+            }));
+    for (const sal_uInt16 nWhich : { EE_CHAR_FONTINFO, EE_CHAR_FONTINFO_CJK,
+                                    EE_CHAR_FONTINFO_CTL })
+        CPPUNIT_ASSERT(std::any_of(
+            aAttributes.begin(), aAttributes.end(), [&](const EECharAttrib& rAttribute) {
+                const auto* pFont = dynamic_cast<const SvxFontItem*>(rAttribute.pAttr);
+                return rAttribute.pAttr->Which() == nWhich && isFullRange(rAttribute)
+                       && pFont && pFont->GetFamilyName() == u"Liberation Sans"_ustr;
+            }));
+    for (const sal_uInt16 nWhich : { EE_CHAR_WEIGHT, EE_CHAR_WEIGHT_CJK,
+                                    EE_CHAR_WEIGHT_CTL })
+        CPPUNIT_ASSERT(std::any_of(
+            aAttributes.begin(), aAttributes.end(), [&](const EECharAttrib& rAttribute) {
+                const auto* pWeight = dynamic_cast<const SvxWeightItem*>(rAttribute.pAttr);
+                return rAttribute.pAttr->Which() == nWhich && isFullRange(rAttribute)
+                       && pWeight && pWeight->GetWeight() == WEIGHT_BOLD;
+            }));
+    for (const sal_uInt16 nWhich : { EE_CHAR_ITALIC, EE_CHAR_ITALIC_CJK,
+                                    EE_CHAR_ITALIC_CTL })
+        CPPUNIT_ASSERT(std::any_of(
+            aAttributes.begin(), aAttributes.end(), [&](const EECharAttrib& rAttribute) {
+                const auto* pPosture = dynamic_cast<const SvxPostureItem*>(rAttribute.pAttr);
+                return rAttribute.pAttr->Which() == nWhich && isFullRange(rAttribute)
+                       && pPosture && pPosture->GetPosture() == ITALIC_NORMAL;
+            }));
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT(aOriginal == *pTextObject->GetOutlinerParaObject());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT(aChanged == *pTextObject->GetOutlinerParaObject());
+}
