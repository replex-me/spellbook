+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testUnoShapeCreationRegistersNativeUndo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    CPPUNIT_ASSERT(pDoc && pUndoManager);
+
+    uno::Reference<drawing::XDrawPagesSupplier> xDrawPagesSupplier(mxComponent,
+                                                                   uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xDrawPage(
+        xDrawPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xDrawPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance(u"com.sun.star.drawing.TextShape"_ustr),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1234, 2345));
+    xShape->setSize(awt::Size(6789, 3456));
+    uno::Reference<container::XNamed>(xShape, uno::UNO_QUERY_THROW)
+        ->setName(u"AI text box"_ustr);
+    uno::Reference<beans::XPropertySet>(xShape, uno::UNO_QUERY_THROW)
+        ->setPropertyValue(u"FillColor"_ustr, cpo::uno::Any(sal_Int32(0x246B5B)));
+    uno::Reference<document::XUndoManager> xUndoManager
+        = uno::Reference<document::XUndoManagerSupplier>(mxComponent,
+                                                          uno::UNO_QUERY_THROW)
+              ->getUndoManager();
+    CPPUNIT_ASSERT(xUndoManager.is());
+
+    const sal_Int32 nShapeCountBefore = xShapes->getCount();
+    const size_t nUndoBefore
+        = pUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel);
+    xUndoManager->enterUndoContext(u"Create browser shape"_ustr);
+    xShapes->add(xShape);
+    uno::Reference<text::XText>(xShape, uno::UNO_QUERY_THROW)
+        ->setString(u"Exact browser creation"_ustr);
+    xUndoManager->leaveUndoContext();
+    CPPUNIT_ASSERT_EQUAL(nShapeCountBefore + 1, xShapes->getCount());
+    CPPUNIT_ASSERT_EQUAL(
+        size_t(1),
+        pUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel) - nUndoBefore);
+
+    const auto assertCreatedShape = [&]() {
+        uno::Reference<drawing::XShape> xCreated(
+            xDrawPage->getByIndex(nShapeCountBefore), uno::UNO_QUERY_THROW);
+        const awt::Point aPosition = xCreated->getPosition();
+        const awt::Size aSize = xCreated->getSize();
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(1234), aPosition.X);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(2345), aPosition.Y);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(6789), aSize.Width);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(3456), aSize.Height);
+        CPPUNIT_ASSERT_EQUAL(
+            u"AI text box"_ustr,
+            uno::Reference<container::XNamed>(xCreated, uno::UNO_QUERY_THROW)->getName());
+        CPPUNIT_ASSERT_EQUAL(
+            u"Exact browser creation"_ustr,
+            uno::Reference<text::XText>(xCreated, uno::UNO_QUERY_THROW)->getString());
+        sal_Int32 nFillColor = 0;
+        CPPUNIT_ASSERT(uno::Reference<beans::XPropertySet>(xCreated, uno::UNO_QUERY_THROW)
+                           ->getPropertyValue(u"FillColor"_ustr)
+                       >>= nFillColor);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(0x246B5B), nFillColor);
+    };
+    assertCreatedShape();
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nShapeCountBefore, xShapes->getCount());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nShapeCountBefore + 1, xShapes->getCount());
+    assertCreatedShape();
+}
