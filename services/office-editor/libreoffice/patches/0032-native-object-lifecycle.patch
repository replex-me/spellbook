+void handleDuplicateObject(SlideCommandContext& rCtx, const std::string& rKey,
+                           const boost::property_tree::ptree& rValue)
+{
+    if (!rValue.empty() || !rValue.data().empty())
+        throw lang::IllegalArgumentException(u"Duplicate object payload must be empty"_ustr,
+                                              nullptr, 0);
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Duplicate object slide is unavailable"_ustr,
+                                              nullptr, 0);
+
+    SdrObject* pSource = lcl_ResolveObjectPath(*pPage, rKey.substr(16));
+    SdrObjList* pTargetList = pSource->getParentSdrObjListFromSdrObject();
+    if (!pTargetList || pSource->getSdrPageFromSdrObject() != pPage)
+        throw lang::IllegalArgumentException(u"Duplicate object is not on the active slide"_ustr,
+                                              nullptr, 0);
+
+    rtl::Reference<SdrObject> pClone(
+        pSource->CloneSdrObject(pPage->getSdrModelFromSdrPage()));
+    if (!pClone)
+        throw lang::IllegalArgumentException(u"Object cannot be duplicated"_ustr, nullptr, 0);
+
+    // Keep the duplicate directly above its source in z-order. Native cloning
+    // preserves the concrete drawing object, embedded model, text runs and
+    // interoperability data; unique naming changes only the identifier that
+    // must not collide inside a page or group.
+    std::unordered_set<OUString> aNameSet;
+    pTargetList->InsertObjectThenMakeNameUnique(
+        pClone.get(), aNameSet, pSource->GetOrdNum() + 1);
+    rCtx.addUndo(SdrUndoFactory::CreateUndoNewObject(*pClone));
+    rCtx.touch(pPage);
+}
