+// Browser observations address objects by slide-relative paths such as `0`
+// and `2/1`. Resolve the complete path once for every typed object command so
+// creation, duplication and formatting share identical group traversal and
+// fail-closed validation.
+SdrObject* lcl_ResolveObjectPath(SdrObjList& rRoot, std::string_view aObjectPath)
+{
+    if (aObjectPath.empty())
+        throw lang::IllegalArgumentException(u"Object path is empty"_ustr, nullptr, 0);
+
+    SdrObjList* pObjectList = &rRoot;
+    SdrObject* pObject = nullptr;
+    std::size_t nPathOffset = 0;
+    while (true)
+    {
+        const std::size_t nSeparator = aObjectPath.find('/', nPathOffset);
+        const std::string aSegment(aObjectPath.substr(
+            nPathOffset, nSeparator == std::string_view::npos
+                             ? std::string_view::npos
+                             : nSeparator - nPathOffset));
+        std::size_t nConsumed = 0;
+        int nObjectIndex = -1;
+        try
+        {
+            nObjectIndex = stoi(aSegment, &nConsumed);
+        }
+        catch (const std::exception&)
+        {
+            throw lang::IllegalArgumentException(u"Invalid object path"_ustr, nullptr, 0);
+        }
+        if (aSegment.empty() || nConsumed != aSegment.size() || nObjectIndex < 0
+            || nObjectIndex >= static_cast<int>(pObjectList->GetObjCount()))
+            throw lang::IllegalArgumentException(u"Object path out of range"_ustr, nullptr, 0);
+
+        pObject = pObjectList->GetObj(nObjectIndex);
+        if (nSeparator == std::string_view::npos)
+            return pObject;
+        if (nSeparator + 1 >= aObjectPath.size())
+            throw lang::IllegalArgumentException(u"Invalid object path"_ustr, nullptr, 0);
+        pObjectList = pObject->GetSubList();
+        if (!pObjectList)
+            throw lang::IllegalArgumentException(u"Object path is not a group"_ustr, nullptr, 0);
+        nPathOffset = nSeparator + 1;
+    }
+}
