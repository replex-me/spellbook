+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTypedDuplicateObjectPreservesSemanticsAndUndo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    CPPUNIT_ASSERT(pPage && pUndoManager);
+
+    pDoc->EnableUndo(false);
+    rtl::Reference<SdrRectObj> pSource = new SdrRectObj(
+        *pDoc, tools::Rectangle(1234, 2345, 8023, 5801));
+    pSource->SetName(u"Original semantic object"_ustr);
+    pSource->SetTitle(u"Accessible title"_ustr);
+    pSource->SetDescription(u"Accessible description"_ustr);
+    pSource->SetText(u"Mixed 한글 and Latin"_ustr);
+    pPage->InsertObject(pSource.get());
+    pDoc->EnableUndo(true);
+
+    const size_t nSourceIndex = pSource->GetOrdNum();
+    const size_t nObjectCountBefore = pPage->GetObjCount();
+    const size_t nUndoBefore
+        = pUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel);
+    const OUString aSourceName = pSource->GetName();
+    const OutlinerParaObject aSourceText(*pSource->GetOutlinerParaObject());
+    const tools::Rectangle aSourceRectangle = pSource->GetSnapRect();
+    const SdrObjKind eSourceKind = pSource->GetObjIdentifier();
+
+    const OUString aJson = uR"json(
+{
+    "Strict": true,
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"DuplicateObject.)json"_ustr
+                           + OUString::number(nSourceIndex)
+                           + uR"json(": {}}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(nObjectCountBefore + 1, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(
+        size_t(1),
+        pUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel) - nUndoBefore);
+    const auto assertDuplicate = [&]() {
+        SdrObject* pClone = pPage->GetObj(nSourceIndex + 1);
+        CPPUNIT_ASSERT(pClone);
+        CPPUNIT_ASSERT_EQUAL(eSourceKind, pClone->GetObjIdentifier());
+        CPPUNIT_ASSERT_EQUAL(aSourceRectangle, pClone->GetSnapRect());
+        CPPUNIT_ASSERT_EQUAL(u"Accessible title"_ustr, pClone->GetTitle());
+        CPPUNIT_ASSERT_EQUAL(u"Accessible description"_ustr, pClone->GetDescription());
+        CPPUNIT_ASSERT(aSourceText == *static_cast<SdrTextObj*>(pClone)->GetOutlinerParaObject());
+        CPPUNIT_ASSERT(!pClone->GetName().isEmpty());
+        CPPUNIT_ASSERT(pClone->GetName() != aSourceName);
+    };
+    assertDuplicate();
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nObjectCountBefore, pPage->GetObjCount());
+    CPPUNIT_ASSERT_EQUAL(static_cast<SdrObject*>(pSource.get()),
+                         pPage->GetObj(nSourceIndex));
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nObjectCountBefore + 1, pPage->GetObjCount());
+    assertDuplicate();
+}
