+        {
+            pDocument->AddUndo(
+                pDocument->GetSdrUndoFactory().CreateUndoAttrObject(*pObject, true, true));
+            pDocument->AddUndo(
+                pDocument->GetSdrUndoFactory().CreateUndoGeoObject(*pObject));
+        }
         mpShape->_setPropertyValue(aPropertyName, aValue);
     }
 
