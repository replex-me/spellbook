+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureInsertSlideInheritsSourceLayout)
+{
+    createSdImpressDoc();
+
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDoc = pDocument->GetDoc();
+    SdPage* pSource = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pSource);
+    SdPage* pMaster = static_cast<SdPage*>(&pSource->TRG_GetMasterPage());
+    CPPUNIT_ASSERT(pMaster);
+
+    // A standard master does not identify which concrete slide layout should
+    // be used. Inherit the source slide's layout even when the master carries
+    // a different AutoLayout value; otherwise default decks lose the title
+    // and content placeholders expected by InsertMasterSlide.
+    pMaster->SetAutoLayout(AUTOLAYOUT_TITLE_CONTENT, false, false, true);
+    pSource->SetAutoLayout(AUTOLAYOUT_NONE, false, false, true);
+    const size_t nMasterObjectCount = pMaster->GetObjCount();
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"InsertMasterSlide": 0}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(2), pDoc->GetSdPageCount(PageKind::Standard));
+    SdPage* pInserted = pDoc->GetSdPage(1, PageKind::Standard);
+    CPPUNIT_ASSERT(pInserted);
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_NONE, pInserted->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(pMaster,
+                         static_cast<SdPage*>(&pInserted->TRG_GetMasterPage()));
+    CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, pMaster->GetObjCount());
+
+    pDocument->GetDocShell()->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(1), pDoc->GetSdPageCount(PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, pMaster->GetObjCount());
+    pDocument->GetDocShell()->GetUndoManager()->Redo();
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(2), pDoc->GetSdPageCount(PageKind::Standard));
+    pInserted = pDoc->GetSdPage(1, PageKind::Standard);
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_NONE, pInserted->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(pMaster,
+                         static_cast<SdPage*>(&pInserted->TRG_GetMasterPage()));
+    CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, pMaster->GetObjCount());
+}
