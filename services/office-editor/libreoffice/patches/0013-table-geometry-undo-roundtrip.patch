+void SdrTableObj::NbcSyncLogicRectToTableLayout()
+{
+    // SvxShape::getSize() reports the half-open size of maLogicRect. The table
+    // layouter already stores its row/column sums as that same half-open
+    // extent, so copying the completed layout rectangle is the exact
+    // conversion. GetWidth()/GetHeight() would add one 1/100 mm here because
+    // those methods deliberately use closed-interval semantics.
+    const tools::Rectangle& rLayoutRect = getRectangle();
+    maLogicRect = rLayoutRect;
+    SetBoundAndSnapRectsDirty();
+}
