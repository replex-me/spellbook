+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureGraphicCropUndoRedo)
+{
+    createSdImpressDoc("pptx/crop-position.pptx");
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    SdrObject* pObject = pPage->GetObj(0);
+    uno::Reference<beans::XPropertySet> xProperties(pObject->getUnoShape(), uno::UNO_QUERY_THROW);
+
+    text::GraphicCrop aOriginal;
+    CPPUNIT_ASSERT(xProperties->getPropertyValue(u"GraphicCrop"_ustr) >>= aOriginal);
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetGraphicCrop.0": {
+                "Left": 1611,
+                "Top": 1069,
+                "Right": 859,
+                "Bottom": 641
+            }}
+        ]
+    }
+}
+)json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    auto getCrop = [&]() {
+        text::GraphicCrop aCrop;
+        CPPUNIT_ASSERT(xProperties->getPropertyValue(u"GraphicCrop"_ustr) >>= aCrop);
+        return aCrop;
+    };
+    text::GraphicCrop aChanged = getCrop();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1611), aChanged.Left);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1069), aChanged.Top);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(859), aChanged.Right);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(641), aChanged.Bottom);
+
+    pUndoManager->Undo();
+    text::GraphicCrop aUndone = getCrop();
+    CPPUNIT_ASSERT_EQUAL(aOriginal.Left, aUndone.Left);
+    CPPUNIT_ASSERT_EQUAL(aOriginal.Top, aUndone.Top);
+    CPPUNIT_ASSERT_EQUAL(aOriginal.Right, aUndone.Right);
+    CPPUNIT_ASSERT_EQUAL(aOriginal.Bottom, aUndone.Bottom);
+
+    pUndoManager->Redo();
+    text::GraphicCrop aRedone = getCrop();
+    CPPUNIT_ASSERT_EQUAL(aChanged.Left, aRedone.Left);
+    CPPUNIT_ASSERT_EQUAL(aChanged.Top, aRedone.Top);
+    CPPUNIT_ASSERT_EQUAL(aChanged.Right, aRedone.Right);
+    CPPUNIT_ASSERT_EQUAL(aChanged.Bottom, aRedone.Bottom);
+}
