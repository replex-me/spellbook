+void handleSetGraphicCrop(SlideCommandContext& rCtx, const std::string& rKey,
+                          const boost::property_tree::ptree& rValue)
+{
+    int nObjId;
+    try
+    {
+        nObjId = stoi(rKey.substr(15));
+    }
+    catch (const std::exception&)
+    {
+        throw lang::IllegalArgumentException(u"Invalid graphic object index"_ustr, nullptr, 0);
+    }
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<int>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Graphic object index out of range"_ustr,
+                                              nullptr, 0);
+
+    SdrObject* pObject = pPage->GetObj(nObjId);
+    uno::Reference<beans::XPropertySet> xProperties(pObject->getUnoShape(), uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySetInfo> xInfo = xProperties->getPropertySetInfo();
+    if (!xInfo->hasPropertyByName(u"GraphicCrop"_ustr))
+        throw lang::IllegalArgumentException(u"Object has no graphic crop"_ustr, nullptr, 0);
+
+    const sal_Int32 nLeft = rValue.get<sal_Int32>("Left");
+    const sal_Int32 nTop = rValue.get<sal_Int32>("Top");
+    const sal_Int32 nRight = rValue.get<sal_Int32>("Right");
+    const sal_Int32 nBottom = rValue.get<sal_Int32>("Bottom");
+    if (nLeft < 0 || nTop < 0 || nRight < 0 || nBottom < 0)
+        throw lang::IllegalArgumentException(u"Graphic crop must be non-negative"_ustr,
+                                              nullptr, 0);
+
+    text::GraphicCrop aOldCrop;
+    if (!(xProperties->getPropertyValue(u"GraphicCrop"_ustr) >>= aOldCrop))
+        throw lang::IllegalArgumentException(u"Invalid graphic crop property"_ustr, nullptr, 0);
+    text::GraphicCrop aNewCrop;
+    aNewCrop.Left = nLeft;
+    aNewCrop.Top = nTop;
+    aNewCrop.Right = nRight;
+    aNewCrop.Bottom = nBottom;
+    if (aOldCrop.Top == aNewCrop.Top && aOldCrop.Bottom == aNewCrop.Bottom
+        && aOldCrop.Left == aNewCrop.Left && aOldCrop.Right == aNewCrop.Right)
+        return;
+
+    // UNO exposes GraphicCrop as an SdrGrafCropItem but does not add Undo.
+    // Snapshot the object's merged attributes before applying the typed crop;
+    // the surrounding document-structure transform then presents one Undo step.
+    if (rCtx.mbUndo)
+        rCtx.mpDrawView->AddUndo(
+            rCtx.mpDoc->GetSdrUndoFactory().CreateUndoAttrObject(*pObject));
+    xProperties->setPropertyValue(u"GraphicCrop"_ustr, cpo::uno::Any(aNewCrop));
+    rCtx.touch(pPage);
+}
