+// AI-issued transforms opt into strict mode. Validate the complete command
+// vocabulary before opening the native transaction so an unknown command can
+// never leave an earlier valid mutation behind.
+void lcl_ValidateStrictTransform(const boost::property_tree::ptree& rTree)
+{
+    bool bSawSlideCommands = false;
+    for (const auto& rRootItem : rTree)
+    {
+        if (rRootItem.first == "Strict")
+            continue;
+        if (rRootItem.first != "Transforms")
+            throw lang::IllegalArgumentException(u"Unsupported strict transform root"_ustr,
+                                                  nullptr, 0);
+
+        for (const auto& rTransformObject : rRootItem.second)
+        {
+            if (rTransformObject.first.empty() && rTransformObject.second.empty())
+                throw lang::IllegalArgumentException(u"Empty strict transform"_ustr, nullptr,
+                                                      0);
+            const auto& rTransform
+                = rTransformObject.first.empty()
+                      ? *rTransformObject.second.ordered_begin()
+                      : rTransformObject;
+            if (rTransform.first != "SlideCommands")
+                throw lang::IllegalArgumentException(
+                    u"Unsupported strict transform collection"_ustr, nullptr, 0);
+            bSawSlideCommands = true;
+
+            for (const auto& rCommandObject : rTransform.second)
+            {
+                if (rCommandObject.first.empty() && rCommandObject.second.empty())
+                    throw lang::IllegalArgumentException(u"Empty strict slide command"_ustr,
+                                                          nullptr, 0);
+                const auto& rCommand
+                    = rCommandObject.first.empty()
+                          ? *rCommandObject.second.ordered_begin()
+                          : rCommandObject;
+                if (!lcl_FindSlideCommand(rCommand.first))
+                    throw lang::IllegalArgumentException(
+                        u"Unsupported strict slide command: "_ustr
+                            + OUString::fromUtf8(rCommand.first),
+                        nullptr, 0);
+            }
+        }
+    }
+    if (!bSawSlideCommands)
+        throw lang::IllegalArgumentException(u"Strict transform has no slide commands"_ustr,
+                                              nullptr, 0);
+}
