+// Owns the native history boundary of one document transform. Command
+// handlers only contribute typed Undo actions; this guard is the sole owner of
+// list-action lifetime, commit and failure rollback.
+class NativeMutationTransaction final
+{
+public:
+    NativeMutationTransaction(SfxUndoManager* pUndoManager, bool bUndo, ViewShellId nViewShellId)
+        : mpUndoManager(pUndoManager)
+        , mbUndo(bUndo)
+        , mnInitialDepth(bUndo ? pUndoManager->GetListActionDepth() : 0)
+        , mnInitialUndoCount(
+              bUndo ? pUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel) : 0)
+    {
+        if (!mbUndo)
+            return;
+        mpUndoManager->EnterListAction(SdResId(STR_UNDO_TRANSFORM_DOCUMENT),
+                                       SdResId(STR_UNDO_TRANSFORM_DOCUMENT), 0,
+                                       nViewShellId);
+        mbOpen = true;
+    }
+
+    NativeMutationTransaction(const NativeMutationTransaction&) = delete;
+    NativeMutationTransaction& operator=(const NativeMutationTransaction&) = delete;
+
+    ~NativeMutationTransaction() { rollback(); }
+
+    void commit()
+    {
+        if (!mbOpen)
+            return;
+        if (mpUndoManager->GetListActionDepth() != mnInitialDepth + 1)
+            throw std::runtime_error("Unbalanced nested Undo context in document transform");
+        mpUndoManager->LeaveListAction();
+        mbOpen = false;
+        if (mpUndoManager->GetListActionDepth() != mnInitialDepth
+            || mpUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel)
+                   > mnInitialUndoCount + 1)
+            throw std::runtime_error("Invalid Undo result from document transform");
+        mbCommitted = true;
+    }
+
+    void rollback() noexcept
+    {
+        if (!mbUndo || mbCommitted)
+            return;
+        while (mpUndoManager->GetListActionDepth() > mnInitialDepth)
+            mpUndoManager->LeaveListAction();
+        mbOpen = false;
+        while (mpUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel)
+               > mnInitialUndoCount)
+        {
+            if (!mpUndoManager->Undo())
+                break;
+        }
+        SAL_WARN_IF(mpUndoManager->GetListActionDepth() != mnInitialDepth
+                        || mpUndoManager->GetUndoActionCount(SfxUndoManager::TopLevel)
+                               != mnInitialUndoCount,
+                    "sd", "Document transform rollback did not restore its Undo boundary");
+    }
+
+private:
+    SfxUndoManager* mpUndoManager;
+    bool mbUndo;
+    size_t mnInitialDepth;
+    size_t mnInitialUndoCount;
+    bool mbOpen = false;
+    bool mbCommitted = false;
 };
 
