+void SdMiscTest::testApiTableCellTextUndo()
+{
+    createSdImpressDoc("tdf99396.odp");
+    auto pXImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pXImpressDocument);
+    SdPage* pPage = pXImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    auto pTableObject = dynamic_cast<sdr::table::SdrTableObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTableObject);
+
+    uno::Reference<table::XTable> xTable = pTableObject->getTable();
+    uno::Reference<text::XTextRange> xCell(xTable->getCellByPosition(0, 0),
+                                           uno::UNO_QUERY_THROW);
+    const OUString aOriginal = xCell->getString();
+    const OutlinerParaObject aOriginalModelText(
+        *pTableObject->getText(0)->GetOutlinerParaObject());
+    auto* pUndoManager = pXImpressDocument->GetDocShell()->GetUndoManager();
+    CPPUNIT_ASSERT_EQUAL(size_t(0), pUndoManager->GetUndoActionCount());
+
+    xCell->setString(u"Changed through UNO"_ustr);
+    const OutlinerParaObject aChangedModelText(
+        *pTableObject->getText(0)->GetOutlinerParaObject());
+    CPPUNIT_ASSERT(aOriginalModelText != aChangedModelText);
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    CPPUNIT_ASSERT_EQUAL(u"Changed through UNO"_ustr, xCell->getString());
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(aOriginal, xCell->getString());
+    CPPUNIT_ASSERT(aOriginalModelText
+                   == *pTableObject->getText(0)->GetOutlinerParaObject());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(u"Changed through UNO"_ustr, xCell->getString());
+    CPPUNIT_ASSERT(aChangedModelText
+                   == *pTableObject->getText(0)->GetOutlinerParaObject());
+}
