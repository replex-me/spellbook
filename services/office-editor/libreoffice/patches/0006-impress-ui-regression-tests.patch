+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureObjectPropertiesUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    SdrObject* pObject = pPage->GetObj(0);
+    uno::Reference<beans::XPropertySet> xProperties(pObject->getUnoShape(), uno::UNO_QUERY_THROW);
+
+    sal_Int32 nOldLeft = 0;
+    bool bOldShadow = false;
+    bool bOldMoveProtect = false;
+    xProperties->getPropertyValue(u"TextLeftDistance"_ustr) >>= nOldLeft;
+    xProperties->getPropertyValue(u"Shadow"_ustr) >>= bOldShadow;
+    xProperties->getPropertyValue(u"MoveProtect"_ustr) >>= bOldMoveProtect;
+    const OUString aOldTitle = pObject->GetTitle();
+    const OUString aOldDescription = pObject->GetDescription();
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetObjectProperties.0": {
+                "Title": "Accessible title",
+                "Description": "Accessible description",
+                "TextLeftDistance": 321,
+                "Shadow": true,
+                "MoveProtect": true
+            }}
+        ]
+    }
+}
+)json"_ustr;
+    const size_t nUndoBefore = pDoc->GetUndoManager()->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    sal_Int32 nLeft = 0;
+    bool bShadow = false;
+    bool bMoveProtect = false;
+    xProperties->getPropertyValue(u"TextLeftDistance"_ustr) >>= nLeft;
+    xProperties->getPropertyValue(u"Shadow"_ustr) >>= bShadow;
+    xProperties->getPropertyValue(u"MoveProtect"_ustr) >>= bMoveProtect;
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pDoc->GetUndoManager()->GetUndoActionCount() - nUndoBefore);
+    CPPUNIT_ASSERT_EQUAL(u"Accessible title"_ustr, pObject->GetTitle());
+    CPPUNIT_ASSERT_EQUAL(u"Accessible description"_ustr, pObject->GetDescription());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(321), nLeft);
+    CPPUNIT_ASSERT(bShadow);
+    CPPUNIT_ASSERT(bMoveProtect);
+
+    pImpressDocument->GetDocShell()->GetUndoManager()->Undo();
+    xProperties->getPropertyValue(u"TextLeftDistance"_ustr) >>= nLeft;
+    xProperties->getPropertyValue(u"Shadow"_ustr) >>= bShadow;
+    xProperties->getPropertyValue(u"MoveProtect"_ustr) >>= bMoveProtect;
+    CPPUNIT_ASSERT_EQUAL(aOldTitle, pObject->GetTitle());
+    CPPUNIT_ASSERT_EQUAL(aOldDescription, pObject->GetDescription());
+    CPPUNIT_ASSERT_EQUAL(nOldLeft, nLeft);
+    CPPUNIT_ASSERT_EQUAL(bOldShadow, bShadow);
+    CPPUNIT_ASSERT_EQUAL(bOldMoveProtect, bMoveProtect);
+
+    pImpressDocument->GetDocShell()->GetUndoManager()->Redo();
+    xProperties->getPropertyValue(u"TextLeftDistance"_ustr) >>= nLeft;
+    xProperties->getPropertyValue(u"Shadow"_ustr) >>= bShadow;
+    xProperties->getPropertyValue(u"MoveProtect"_ustr) >>= bMoveProtect;
+    CPPUNIT_ASSERT_EQUAL(u"Accessible title"_ustr, pObject->GetTitle());
+    CPPUNIT_ASSERT_EQUAL(u"Accessible description"_ustr, pObject->GetDescription());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(321), nLeft);
+    CPPUNIT_ASSERT(bShadow);
+    CPPUNIT_ASSERT(bMoveProtect);
+}
