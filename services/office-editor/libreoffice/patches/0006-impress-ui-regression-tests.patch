+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureMultiMovePreservesObjectNames)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+
+    static constexpr OUString aInsertJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"InsertMasterSlide": 0},
+            {"InsertMasterSlide": 0}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aInsertJson) });
+
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(3), pDoc->GetSdPageCount(PageKind::Standard));
+    std::vector<SdPage*> aPages;
+    pDoc->EnableUndo(false);
+    for (sal_uInt16 nPage = 0; nPage < 3; ++nPage)
+    {
+        SdPage* pPage = pDoc->GetSdPage(nPage, PageKind::Standard);
+        aPages.push_back(pPage);
+        for (sal_uInt16 nShape = 0; nShape < 3; ++nShape)
+        {
+            rtl::Reference<SdrRectObj> pRect = new SdrRectObj(
+                *pDoc, tools::Rectangle(1000 + nShape * 1000, 1000, 1800 + nShape * 1000, 1800));
+            pRect->SetName(u"Present Rectangle "_ustr
+                           + OUString::number(nPage * 3 + nShape + 1));
+            pPage->NbcInsertObject(pRect.get());
+        }
+    }
+    pDoc->EnableUndo(true);
+
+    auto getNames = [](const SdPage* pPage) {
+        std::vector<OUString> aNames;
+        for (size_t nObject = 0; nObject < pPage->GetObjCount(); ++nObject)
+            aNames.push_back(pPage->GetObj(nObject)->GetName());
+        return aNames;
+    };
+    std::vector<std::vector<OUString>> aOriginalNames;
+    for (const SdPage* pPage : aPages)
+        aOriginalNames.push_back(getNames(pPage));
+
+    static constexpr OUString aMoveJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"MoveSlide.2": 0},
+            {"MoveSlide.1": 2}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aMoveJson) });
+    CPPUNIT_ASSERT_EQUAL(aPages[2], pDoc->GetSdPage(0, PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(aPages[1], pDoc->GetSdPage(1, PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(aPages[0], pDoc->GetSdPage(2, PageKind::Standard));
+    for (size_t nPage = 0; nPage < aPages.size(); ++nPage)
+        CPPUNIT_ASSERT(aOriginalNames[nPage] == getNames(aPages[nPage]));
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    for (size_t nPage = 0; nPage < aPages.size(); ++nPage)
+    {
+        CPPUNIT_ASSERT_EQUAL(aPages[nPage],
+                             pDoc->GetSdPage(nPage, PageKind::Standard));
+        CPPUNIT_ASSERT(aOriginalNames[nPage] == getNames(aPages[nPage]));
+    }
+
+    dispatchCommand(mxComponent, u".uno:Redo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(aPages[2], pDoc->GetSdPage(0, PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(aPages[1], pDoc->GetSdPage(1, PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(aPages[0], pDoc->GetSdPage(2, PageKind::Standard));
+    for (size_t nPage = 0; nPage < aPages.size(); ++nPage)
+        CPPUNIT_ASSERT(aOriginalNames[nPage] == getNames(aPages[nPage]));
+}
