+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testRenameSlideUndoRestoresUnnamedState)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    sd::ViewShell* pViewShell = pImpressDocument->GetDocShell()->GetViewShell();
+    CPPUNIT_ASSERT(pViewShell);
+    SdPage* pPage = pViewShell->getCurrentPage();
+    CPPUNIT_ASSERT(pPage->GetRealName().isEmpty());
+
+    cpo::uno::Sequence<beans::PropertyValue> aArgs = {
+        comphelper::makePropertyValue(u"Name"_ustr, u"Custom slide name"_ustr),
+    };
+    dispatchCommand(mxComponent, u".uno:RenamePage"_ustr, aArgs);
+    CPPUNIT_ASSERT_EQUAL(u"Custom slide name"_ustr, pPage->GetRealName());
+
+    pImpressDocument->GetDocShell()->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT(pPage->GetRealName().isEmpty());
+    pImpressDocument->GetDocShell()->GetUndoManager()->Redo();
+    CPPUNIT_ASSERT_EQUAL(u"Custom slide name"_ustr, pPage->GetRealName());
+}
+
+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTransformSlideVisibilityUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdPage* pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    CPPUNIT_ASSERT(!pPage->IsExcluded());
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetSlideVisible": false}
+        ]
+    }
+}
+)json"_ustr;
+
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+    CPPUNIT_ASSERT(pPage->IsExcluded());
+
+    pImpressDocument->GetDocShell()->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT(!pPage->IsExcluded());
+    pImpressDocument->GetDocShell()->GetUndoManager()->Redo();
+    CPPUNIT_ASSERT(pPage->IsExcluded());
+}
