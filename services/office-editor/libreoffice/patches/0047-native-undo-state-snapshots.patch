+// Paragraph UNO setters author properties through a background text source.
+// A drawing text-object snapshot does not restore that source's live property
+// state after Undo. Replay the exact bounded paragraph values instead.
+class SetParagraphPropertiesUndoAction final : public SdUndoAction
+{
+public:
+    using PropertyValues = std::vector<std::pair<OUString, cpo::uno::Any>>;
+
+    SetParagraphPropertiesUndoAction(SdDrawDocument& rDoc, SdrObject& rObject,
+                                     sal_Int32 nParagraph, PropertyValues aOldValues,
+                                     PropertyValues aNewValues)
+        : SdUndoAction(rDoc)
+        , mxObject(&rObject)
+        , mnParagraph(nParagraph)
+        , maOldValues(std::move(aOldValues))
+        , maNewValues(std::move(aNewValues))
+    {
+    }
+
+    void Undo() override { apply(maOldValues); }
+    void Redo() override { apply(maNewValues); }
+
+private:
+    void apply(const PropertyValues& rValues)
+    {
+        uno::Reference<text::XText> xText(mxObject->getUnoShape(), uno::UNO_QUERY_THROW);
+        uno::Reference<container::XEnumerationAccess> xAccess(xText, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XEnumeration> xParagraphs = xAccess->createEnumeration();
+        cpo::uno::Any aParagraph;
+        for (sal_Int32 nIndex = 0; nIndex <= mnParagraph; ++nIndex)
+        {
+            if (!xParagraphs->hasMoreElements())
+                throw lang::IllegalArgumentException(u"Undo paragraph is unavailable"_ustr,
+                                                      nullptr, 0);
+            aParagraph = xParagraphs->nextElement();
+        }
+        uno::Reference<beans::XPropertySet> xProperties(aParagraph, uno::UNO_QUERY_THROW);
+        for (const auto& [rName, rValue] : rValues)
+            xProperties->setPropertyValue(rName, rValue);
+    }
+
+    rtl::Reference<SdrObject> mxObject;
+    sal_Int32 mnParagraph;
+    PropertyValues maOldValues;
+    PropertyValues maNewValues;
+};
