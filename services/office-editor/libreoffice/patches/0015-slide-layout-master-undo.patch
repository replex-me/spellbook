+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTypedLayoutPreservesImportedMaster)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdPage* pPage = pDocument->GetDocShell()->GetViewShell()->GetActualPage();
+    CPPUNIT_ASSERT(pPage);
+    SdPage& rMasterPage = static_cast<SdPage&>(pPage->TRG_GetMasterPage());
+
+    // Model an imported PPTX master that intentionally has no LibreOffice
+    // title/body placeholders and owns hard background attributes. The typed
+    // AI command must be a slide-local edit, not a master normalization pass.
+    auto removePlaceholder = [&rMasterPage](PresObjKind eKind) {
+        if (SdrObject* pObject = rMasterPage.GetPresObj(eKind))
+            rMasterPage.RemoveObject(pObject->GetOrdNum());
+    };
+    removePlaceholder(PresObjKind::Title);
+    removePlaceholder(PresObjKind::Outline);
+    SdrPageProperties& rMasterProperties = rMasterPage.getSdrPageProperties();
+    rMasterProperties.PutItem(XFillStyleItem(drawing::FillStyle_SOLID));
+    rMasterProperties.PutItem(XFillColorItem(OUString(), Color(0x4472c4)));
+
+    const size_t nMasterObjectCount = rMasterPage.GetObjCount();
+    std::vector<const SdrObject*> aMasterObjects;
+    std::vector<::tools::Rectangle> aMasterRectangles;
+    for (size_t nIndex = 0; nIndex < nMasterObjectCount; ++nIndex)
+    {
+        aMasterObjects.push_back(rMasterPage.GetObj(nIndex));
+        aMasterRectangles.push_back(rMasterPage.GetObj(nIndex)->GetLogicRect());
+    }
+    SfxStyleSheet* pMasterStyle = rMasterProperties.GetStyleSheet();
+    std::shared_ptr<model::Theme> pMasterTheme = rMasterProperties.getTheme();
+
+    auto assertMasterUnchanged = [&]() {
+        CPPUNIT_ASSERT_EQUAL(nMasterObjectCount, rMasterPage.GetObjCount());
+        CPPUNIT_ASSERT(!rMasterPage.GetPresObj(PresObjKind::Title));
+        CPPUNIT_ASSERT(!rMasterPage.GetPresObj(PresObjKind::Outline));
+        for (size_t nIndex = 0; nIndex < nMasterObjectCount; ++nIndex)
+        {
+            CPPUNIT_ASSERT(aMasterObjects[nIndex] == rMasterPage.GetObj(nIndex));
+            CPPUNIT_ASSERT(aMasterRectangles[nIndex]
+                           == rMasterPage.GetObj(nIndex)->GetLogicRect());
+        }
+        CPPUNIT_ASSERT(pMasterStyle == rMasterProperties.GetStyleSheet());
+        CPPUNIT_ASSERT(pMasterTheme == rMasterProperties.getTheme());
+        const SfxItemSet& rAttributes = rMasterProperties.GetItemSet();
+        CPPUNIT_ASSERT(rAttributes.GetItemState(XATTR_FILLSTYLE, false)
+                       == SfxItemState::SET);
+        CPPUNIT_ASSERT_EQUAL(drawing::FillStyle_SOLID,
+                             rAttributes.Get(XATTR_FILLSTYLE).GetValue());
+        CPPUNIT_ASSERT_EQUAL(Color(0x4472c4),
+                             rAttributes.GetItem(XATTR_FILLCOLOR)->GetColorValue());
+    };
+
+    const AutoLayout eOldLayout = pPage->GetAutoLayout();
+    const size_t nOldPageObjectCount = pPage->GetObjCount();
+    std::vector<const SdrObject*> aOldPageObjects;
+    std::vector<::tools::Rectangle> aOldPageRectangles;
+    for (size_t nIndex = 0; nIndex < nOldPageObjectCount; ++nIndex)
+    {
+        aOldPageObjects.push_back(pPage->GetObj(nIndex));
+        aOldPageRectangles.push_back(pPage->GetObj(nIndex)->GetLogicRect());
+    }
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"ChangeLayoutByName": "AUTOLAYOUT_TITLE_ONLY"}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+    CPPUNIT_ASSERT_EQUAL(AutoLayout::AUTOLAYOUT_TITLE_ONLY, pPage->GetAutoLayout());
+    assertMasterUnchanged();
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    Scheduler::ProcessEventsToIdle();
+    CPPUNIT_ASSERT_EQUAL(eOldLayout, pPage->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(nOldPageObjectCount, pPage->GetObjCount());
+    for (size_t nIndex = 0; nIndex < nOldPageObjectCount; ++nIndex)
+    {
+        CPPUNIT_ASSERT(aOldPageObjects[nIndex] == pPage->GetObj(nIndex));
+        CPPUNIT_ASSERT(aOldPageRectangles[nIndex] == pPage->GetObj(nIndex)->GetLogicRect());
+    }
+    assertMasterUnchanged();
+
+    dispatchCommand(mxComponent, u".uno:Redo"_ustr, {});
+    Scheduler::ProcessEventsToIdle();
+    CPPUNIT_ASSERT_EQUAL(AutoLayout::AUTOLAYOUT_TITLE_ONLY, pPage->GetAutoLayout());
+    assertMasterUnchanged();
+}
