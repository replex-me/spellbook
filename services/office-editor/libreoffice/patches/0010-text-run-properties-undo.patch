+void handleSetTextProperties(SlideCommandContext& rCtx, const std::string& rKey,
+                             const boost::property_tree::ptree& rValue)
+{
+    int nObjId;
+    try
+    {
+        nObjId = stoi(rKey.substr(18));
+    }
+    catch (const std::exception&)
+    {
+        throw lang::IllegalArgumentException(u"Invalid text object index"_ustr, nullptr, 0);
+    }
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<int>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Text object index out of range"_ustr, nullptr, 0);
+
+    SdrObject* pObject = pPage->GetObj(nObjId);
+    if (!pObject->IsSdrTextObj())
+        throw lang::IllegalArgumentException(u"Object has no editable text"_ustr, nullptr, 0);
+    auto* pTextObject = static_cast<SdrTextObj*>(pObject);
+    const OutlinerParaObject* pOriginal = pTextObject->GetOutlinerParaObject();
+    if (!pOriginal)
+        throw lang::IllegalArgumentException(u"Object has no text paragraphs"_ustr, nullptr, 0);
+
+    static const std::set<std::string> aAllowedProperties = {
+        "Kerning",
+        "Escapement",
+        "EscapementHeight",
+    };
+    for (const auto& rEntry : rValue)
+    {
+        if (!aAllowedProperties.contains(rEntry.first))
+            throw lang::IllegalArgumentException(
+                u"Unsupported text property: "_ustr + OUString::fromUtf8(rEntry.first),
+                nullptr, 0);
+    }
+
+    const auto oKerning = rValue.get_optional<sal_Int32>("Kerning");
+    const auto oEscapement = rValue.get_optional<sal_Int32>("Escapement");
+    const auto oEscapementHeight = rValue.get_optional<sal_Int32>("EscapementHeight");
+    if (!oKerning && !oEscapement && !oEscapementHeight)
+        throw lang::IllegalArgumentException(u"No text properties supplied"_ustr, nullptr, 0);
+    if (oEscapement.has_value() != oEscapementHeight.has_value())
+        throw lang::IllegalArgumentException(
+            u"Escapement and height must be supplied together"_ustr, nullptr, 0);
+    if (oKerning && (*oKerning < -10000 || *oKerning > 10000))
+        throw lang::IllegalArgumentException(u"Text kerning out of range"_ustr, nullptr, 0);
+    if (oEscapement
+        && (*oEscapement < -100 || *oEscapement > 100 || *oEscapementHeight < 1
+            || *oEscapementHeight > 100))
+        throw lang::IllegalArgumentException(u"Text escapement out of range"_ustr, nullptr, 0);
+
+    Outliner* pOutliner = rCtx.mpDoc->GetInternalOutliner();
+    const OutlinerMode eOldMode = pOutliner->GetOutlinerMode();
+    comphelper::ScopeGuard const aOutlinerGuard([pOutliner, eOldMode]() {
+        pOutliner->Init(eOldMode);
+    });
+    pOutliner->Init(pOriginal->GetOutlinerMode());
+    pOutliner->SetText(*pOriginal);
+    SfxItemSet aTextAttributes(pOutliner->GetEmptyItemSet());
+    if (oKerning)
+    {
+        const sal_Int64 nTwips = sanitiseMm100ToTwip(*oKerning);
+        if (nTwips < std::numeric_limits<sal_Int16>::min()
+            || nTwips > std::numeric_limits<sal_Int16>::max())
+            throw lang::IllegalArgumentException(u"Text kerning conversion out of range"_ustr,
+                                                  nullptr, 0);
+        aTextAttributes.Put(
+            SvxKerningItem(static_cast<sal_Int16>(nTwips), EE_CHAR_KERNING));
+    }
+    if (oEscapement)
+        aTextAttributes.Put(SvxEscapementItem(
+            static_cast<sal_Int16>(*oEscapement),
+            static_cast<sal_uInt8>(*oEscapementHeight), EE_CHAR_ESCAPEMENT));
+
+    if (rCtx.mbUndo)
+        rCtx.mpDrawView->AddUndo(
+            rCtx.mpDoc->GetSdrUndoFactory().CreateUndoObjectSetText(*pObject, 0));
+    for (sal_Int32 nParagraph = 0; nParagraph < pOutliner->GetParagraphCount(); ++nParagraph)
+        pOutliner->SetCharAttribs(nParagraph, aTextAttributes);
+    pTextObject->SetOutlinerParaObject(pOutliner->CreateParaObject());
+    rCtx.touch(pPage);
+}
