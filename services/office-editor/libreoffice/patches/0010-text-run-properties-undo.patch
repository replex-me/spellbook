+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureTextPropertiesUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    auto* pTextObject = dynamic_cast<SdrTextObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTextObject);
+
+    pDoc->EnableUndo(false);
+    pTextObject->SetText(u"Alpha BETA Omega"_ustr);
+    SdOutliner* pOutliner = pDoc->GetInternalOutliner();
+    pOutliner->Init(pTextObject->GetOutlinerParaObject()->GetOutlinerMode());
+    pOutliner->SetText(*pTextObject->GetOutlinerParaObject());
+    SfxItemSet aBoldSet(pOutliner->GetEmptyItemSet());
+    aBoldSet.Put(SvxWeightItem(WEIGHT_BOLD, EE_CHAR_WEIGHT));
+    pOutliner->QuickSetAttribs(aBoldSet, ESelection(0, 6, 0, 10));
+    pTextObject->SetOutlinerParaObject(pOutliner->CreateParaObject());
+    pDoc->EnableUndo(true);
+    const OutlinerParaObject aOriginal(*pTextObject->GetOutlinerParaObject());
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetTextProperties.0": {
+                "Kerning": 44,
+                "Escapement": 33,
+                "EscapementHeight": 58
+            }}
+        ]
+    }
+}
+)json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    const OutlinerParaObject aChanged(*pTextObject->GetOutlinerParaObject());
+    CPPUNIT_ASSERT(aChanged != aOriginal);
+    const EditTextObject& rChangedText = aChanged.GetTextObject();
+    std::vector<EECharAttrib> aAttributes;
+    rChangedText.GetCharAttribs(0, aAttributes);
+    const sal_Int32 nTextLength = rChangedText.GetTextLen(0);
+    const sal_Int16 nExpectedKerning
+        = static_cast<sal_Int16>(sanitiseMm100ToTwip(sal_Int32(44)));
+    const bool bKerningApplied = std::any_of(
+        aAttributes.begin(), aAttributes.end(), [&](const EECharAttrib& rAttribute) {
+            const auto* pKerning = dynamic_cast<const SvxKerningItem*>(rAttribute.pAttr);
+            return pKerning && rAttribute.nStart == 0 && rAttribute.nEnd == nTextLength
+                   && pKerning->GetValue() == nExpectedKerning;
+        });
+    const bool bEscapementApplied = std::any_of(
+        aAttributes.begin(), aAttributes.end(), [&](const EECharAttrib& rAttribute) {
+            const auto* pEscapement = dynamic_cast<const SvxEscapementItem*>(rAttribute.pAttr);
+            return pEscapement && rAttribute.nStart == 0 && rAttribute.nEnd == nTextLength
+                   && pEscapement->GetEsc() == 33
+                   && pEscapement->GetProportionalHeight() == 58;
+        });
+    const bool bBoldRunPreserved = std::any_of(
+        aAttributes.begin(), aAttributes.end(), [](const EECharAttrib& rAttribute) {
+            const auto* pWeight = dynamic_cast<const SvxWeightItem*>(rAttribute.pAttr);
+            return pWeight && rAttribute.nStart == 6 && rAttribute.nEnd == 10
+                   && pWeight->GetWeight() == WEIGHT_BOLD;
+        });
+    CPPUNIT_ASSERT(bKerningApplied);
+    CPPUNIT_ASSERT(bEscapementApplied);
+    CPPUNIT_ASSERT(bBoldRunPreserved);
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT(aOriginal == *pTextObject->GetOutlinerParaObject());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT(aChanged == *pTextObject->GetOutlinerParaObject());
+}
