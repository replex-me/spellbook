+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureAnimationLifecycleUndoRoundtrip)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const sal_Int32 nTargetObject = 0;
+    const sal_Int32 nOriginalCount = pPage->getMainSequence()->getCount();
+
+    auto dispatchAnimation = [&](std::u16string_view rCommand, const OUString& rPayload) {
+        const OUString aJson
+            = uR"json({"Transforms":{"SlideCommands":[{"JumpToSlide":0},{")json"_ustr
+              + OUString(rCommand) + u"."_ustr + OUString::number(nTargetObject)
+              + uR"json(":)json"_ustr + rPayload + uR"json(}]}})json"_ustr;
+        const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+        dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                        { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+        CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    };
+    auto effectAt = [&]() {
+        std::shared_ptr<sd::MainSequence> pSequence = pPage->getMainSequence();
+        return pSequence->getBegin() == pSequence->getEnd()
+                   ? sd::CustomAnimationEffectPtr()
+                   : *pSequence->getBegin();
+    };
+
+    dispatchAnimation(
+        u"AddAnimationEffect",
+        uR"json({"PresetId":"ooo-entrance-appear","Duration":0.8,"Delay":0.1,"Start":"after-previous","InsertIndex":0})json"_ustr);
+    CPPUNIT_ASSERT_EQUAL(nOriginalCount + 1, pPage->getMainSequence()->getCount());
+    auto pAdded = effectAt();
+    CPPUNIT_ASSERT(pAdded);
+    CPPUNIT_ASSERT_EQUAL(u"ooo-entrance-appear"_ustr, pAdded->getPresetId());
+    CPPUNIT_ASSERT_EQUAL(0.8, pAdded->getDuration());
+    CPPUNIT_ASSERT_EQUAL(0.1, pAdded->getBegin());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(presentation::EffectNodeType::AFTER_PREVIOUS),
+                         pAdded->getNodeType());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalCount, pPage->getMainSequence()->getCount());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalCount + 1, pPage->getMainSequence()->getCount());
+
+    dispatchAnimation(
+        u"ReplaceAnimationEffect",
+        uR"json({"SequenceIndex":0,"ExpectedPresetId":"ooo-entrance-appear","PresetId":"ooo-entrance-wipe"})json"_ustr);
+    auto pReplaced = effectAt();
+    CPPUNIT_ASSERT(pReplaced);
+    CPPUNIT_ASSERT_EQUAL(u"ooo-entrance-wipe"_ustr, pReplaced->getPresetId());
+    CPPUNIT_ASSERT_EQUAL(0.8, pReplaced->getDuration());
+    CPPUNIT_ASSERT_EQUAL(0.1, pReplaced->getBegin());
+
+    if (pPage->getMainSequence()->getCount() > 1)
+    {
+        dispatchAnimation(
+            u"MoveAnimationEffect",
+            uR"json({"SequenceIndex":0,"ExpectedPresetId":"ooo-entrance-wipe","TargetIndex:)json"_ustr
+                + OUString::number(pPage->getMainSequence()->getCount() - 1) + u"}"_ustr);
+        auto pSequence = pPage->getMainSequence();
+        auto it = pSequence->getEnd();
+        --it;
+        CPPUNIT_ASSERT_EQUAL(u"ooo-entrance-wipe"_ustr, (*it)->getPresetId());
+        dispatchAnimation(
+            u"RemoveAnimationEffect",
+            uR"json({"SequenceIndex:)json"_ustr
+                + OUString::number(pPage->getMainSequence()->getCount() - 1)
+                + uR"json(,"ExpectedPresetId":"ooo-entrance-wipe"})json"_ustr);
+    }
+    else
+    {
+        dispatchAnimation(
+            u"RemoveAnimationEffect",
+            uR"json({"SequenceIndex":0,"ExpectedPresetId":"ooo-entrance-wipe"})json"_ustr);
+    }
+    CPPUNIT_ASSERT_EQUAL(nOriginalCount, pPage->getMainSequence()->getCount());
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nOriginalCount + 1, pPage->getMainSequence()->getCount());
+
+    saveAndReload(TestFilter::PPTX);
+    pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    CPPUNIT_ASSERT_EQUAL(nOriginalCount + 1, pPage->getMainSequence()->getCount());
+}
