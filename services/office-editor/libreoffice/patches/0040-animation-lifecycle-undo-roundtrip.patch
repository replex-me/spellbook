+sal_Int32 lcl_AnimationObjectIndex(const std::string& rKey)
+{
+    const std::size_t nSeparator = rKey.rfind('.');
+    if (nSeparator == std::string::npos || nSeparator + 1 >= rKey.size())
+        throw lang::IllegalArgumentException(u"Invalid animation target index"_ustr, nullptr, 0);
+    try
+    {
+        return stoi(rKey.substr(nSeparator + 1));
+    }
+    catch (const std::exception&)
+    {
+        throw lang::IllegalArgumentException(u"Invalid animation target index"_ustr, nullptr, 0);
+    }
+}
+
+sal_Int16 lcl_AnimationStartMode(const std::string& rStart)
+{
+    if (rStart == "on-click")
+        return presentation::EffectNodeType::ON_CLICK;
+    if (rStart == "with-previous")
+        return presentation::EffectNodeType::WITH_PREVIOUS;
+    if (rStart == "after-previous")
+        return presentation::EffectNodeType::AFTER_PREVIOUS;
+    throw lang::IllegalArgumentException(u"Unsupported animation start mode"_ustr, nullptr, 0);
+}
+
+sd::CustomAnimationEffectPtr lcl_AnimationEffectAt(
+    const std::shared_ptr<sd::MainSequence>& pSequence, sal_Int32 nIndex)
+{
+    if (!pSequence || nIndex < 0 || nIndex >= pSequence->getCount())
+        return {};
+    sal_Int32 nCurrent = 0;
+    for (auto it = pSequence->getBegin(); it != pSequence->getEnd(); ++it, ++nCurrent)
+    {
+        if (nCurrent == nIndex)
+            return *it;
+    }
+    return {};
+}
+
+sd::CustomAnimationEffectPtr lcl_ValidatedAnimationEffect(
+    const std::shared_ptr<sd::MainSequence>& pSequence, sal_Int32 nIndex,
+    const uno::Reference<drawing::XShape>& xTarget, const OUString& rExpectedPresetId)
+{
+    sd::CustomAnimationEffectPtr pEffect = lcl_AnimationEffectAt(pSequence, nIndex);
+    if (!pEffect || pEffect->getTargetShape() != xTarget
+        || pEffect->getPresetId() != rExpectedPresetId)
+        throw lang::IllegalArgumentException(
+            u"Animation effect no longer matches observation"_ustr, nullptr, 0);
+    return pEffect;
+}
+
+sd::CustomAnimationPresetPtr lcl_AnimationPreset(const OUString& rPresetId)
+{
+    if (rPresetId.isEmpty() || rPresetId.getLength() > 128
+        || !(rPresetId.startsWith(u"ooo-entrance-")
+             || rPresetId.startsWith(u"ooo-emphasis-")
+             || rPresetId.startsWith(u"ooo-exit-")
+             || rPresetId.startsWith(u"ooo-motionpath-")))
+        throw lang::IllegalArgumentException(u"Invalid animation preset"_ustr, nullptr, 0);
+    sd::CustomAnimationPresetPtr pPreset
+        = sd::CustomAnimationPresets::getCustomAnimationPresets().getEffectDescriptor(rPresetId);
+    if (!pPreset)
+        throw lang::IllegalArgumentException(u"Unknown animation preset"_ustr, nullptr, 0);
+    return pPreset;
+}
+
+void handleAddAnimationEffect(SlideCommandContext& rCtx, const std::string& rKey,
+                              const boost::property_tree::ptree& rValue)
+{
+    const sal_Int32 nObjId = lcl_AnimationObjectIndex(rKey);
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<sal_Int32>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Animation target index out of range"_ustr,
+                                              nullptr, 0);
+    const uno::Reference<drawing::XShape> xTarget = pPage->GetObj(nObjId)->getUnoShape();
+    if (!xTarget.is())
+        throw lang::IllegalArgumentException(u"Animation target has no UNO shape"_ustr,
+                                              nullptr, 0);
+    const OUString aPresetId = OUString::fromUtf8(rValue.get<std::string>("PresetId"));
+    const sd::CustomAnimationPresetPtr pPreset = lcl_AnimationPreset(aPresetId);
+    const double fDuration = rValue.get<double>("Duration");
+    const double fDelay = rValue.get<double>("Delay");
+    const sal_Int16 nNodeType = lcl_AnimationStartMode(rValue.get<std::string>("Start"));
+    const sal_Int32 nInsertIndex = rValue.get<sal_Int32>("InsertIndex");
+    std::shared_ptr<sd::MainSequence> pSequence = pPage->getMainSequence();
+    if (fDuration < 0.001 || fDuration > 60.0 || fDelay < 0.0 || fDelay > 60.0
+        || nInsertIndex < 0 || nInsertIndex > pSequence->getCount()
+        || pSequence->getCount() >= 200)
+        throw lang::IllegalArgumentException(u"Animation effect value is out of range"_ustr,
+                                              nullptr, 0);
+    const sd::CustomAnimationEffectPtr pInsertBefore
+        = nInsertIndex == pSequence->getCount()
+              ? sd::CustomAnimationEffectPtr()
+              : lcl_AnimationEffectAt(pSequence, nInsertIndex);
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<sd::UndoAnimation>(rCtx.mpDoc, pPage));
+    {
+        sd::MainSequenceRebuildGuard aGuard(pSequence);
+        sd::CustomAnimationEffectPtr pCreated
+            = pSequence->append(pPreset, uno::Any(xTarget), fDuration);
+        if (!pCreated)
+            throw lang::IllegalArgumentException(u"Animation effect creation failed"_ustr,
+                                                  nullptr, 0);
+        pCreated->setBegin(fDelay);
+        pCreated->setNodeType(nNodeType);
+        if (pInsertBefore)
+            pSequence->moveToBeforeEffect(pCreated, pInsertBefore);
+    }
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
+
+void handleRemoveAnimationEffect(SlideCommandContext& rCtx, const std::string& rKey,
+                                 const boost::property_tree::ptree& rValue)
+{
+    const sal_Int32 nObjId = lcl_AnimationObjectIndex(rKey);
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<sal_Int32>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Animation target index out of range"_ustr,
+                                              nullptr, 0);
+    const uno::Reference<drawing::XShape> xTarget = pPage->GetObj(nObjId)->getUnoShape();
+    const OUString aExpectedPresetId
+        = OUString::fromUtf8(rValue.get<std::string>("ExpectedPresetId"));
+    std::shared_ptr<sd::MainSequence> pSequence = pPage->getMainSequence();
+    sd::CustomAnimationEffectPtr pEffect = lcl_ValidatedAnimationEffect(
+        pSequence, rValue.get<sal_Int32>("SequenceIndex"), xTarget, aExpectedPresetId);
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<sd::UndoAnimation>(rCtx.mpDoc, pPage));
+    {
+        sd::MainSequenceRebuildGuard aGuard(pSequence);
+        pSequence->remove(pEffect);
+    }
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
+
+void handleReplaceAnimationEffect(SlideCommandContext& rCtx, const std::string& rKey,
+                                  const boost::property_tree::ptree& rValue)
+{
+    const sal_Int32 nObjId = lcl_AnimationObjectIndex(rKey);
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<sal_Int32>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Animation target index out of range"_ustr,
+                                              nullptr, 0);
+    const uno::Reference<drawing::XShape> xTarget = pPage->GetObj(nObjId)->getUnoShape();
+    const OUString aExpectedPresetId
+        = OUString::fromUtf8(rValue.get<std::string>("ExpectedPresetId"));
+    const OUString aPresetId = OUString::fromUtf8(rValue.get<std::string>("PresetId"));
+    const sd::CustomAnimationPresetPtr pPreset = lcl_AnimationPreset(aPresetId);
+    std::shared_ptr<sd::MainSequence> pSequence = pPage->getMainSequence();
+    sd::CustomAnimationEffectPtr pEffect = lcl_ValidatedAnimationEffect(
+        pSequence, rValue.get<sal_Int32>("SequenceIndex"), xTarget, aExpectedPresetId);
+    if (aExpectedPresetId == aPresetId)
+        return;
+    const double fDuration = pEffect->getDuration();
+    const double fDelay = pEffect->getBegin();
+    const sal_Int16 nNodeType = pEffect->getNodeType();
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<sd::UndoAnimation>(rCtx.mpDoc, pPage));
+    {
+        sd::MainSequenceRebuildGuard aGuard(pSequence);
+        pSequence->replace(pEffect, pPreset, fDuration);
+        pEffect->setBegin(fDelay);
+        pEffect->setNodeType(nNodeType);
+    }
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
+
+void handleMoveAnimationEffect(SlideCommandContext& rCtx, const std::string& rKey,
+                               const boost::property_tree::ptree& rValue)
+{
+    const sal_Int32 nObjId = lcl_AnimationObjectIndex(rKey);
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<sal_Int32>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Animation target index out of range"_ustr,
+                                              nullptr, 0);
+    const uno::Reference<drawing::XShape> xTarget = pPage->GetObj(nObjId)->getUnoShape();
+    const OUString aExpectedPresetId
+        = OUString::fromUtf8(rValue.get<std::string>("ExpectedPresetId"));
+    const sal_Int32 nSequenceIndex = rValue.get<sal_Int32>("SequenceIndex");
+    const sal_Int32 nTargetIndex = rValue.get<sal_Int32>("TargetIndex");
+    std::shared_ptr<sd::MainSequence> pSequence = pPage->getMainSequence();
+    sd::CustomAnimationEffectPtr pEffect = lcl_ValidatedAnimationEffect(
+        pSequence, nSequenceIndex, xTarget, aExpectedPresetId);
+    if (nTargetIndex < 0 || nTargetIndex >= pSequence->getCount())
+        throw lang::IllegalArgumentException(u"Animation position is out of range"_ustr,
+                                              nullptr, 0);
+    if (nTargetIndex == nSequenceIndex)
+        return;
+    std::vector<sd::CustomAnimationEffectPtr> aRemaining;
+    for (auto it = pSequence->getBegin(); it != pSequence->getEnd(); ++it)
+    {
+        if (*it != pEffect)
+            aRemaining.push_back(*it);
+    }
+    const sd::CustomAnimationEffectPtr pInsertBefore
+        = nTargetIndex < static_cast<sal_Int32>(aRemaining.size())
+              ? aRemaining[nTargetIndex]
+              : sd::CustomAnimationEffectPtr();
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<sd::UndoAnimation>(rCtx.mpDoc, pPage));
+    {
+        sd::MainSequenceRebuildGuard aGuard(pSequence);
+        pSequence->moveToBeforeEffect(pEffect, pInsertBefore);
+    }
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
