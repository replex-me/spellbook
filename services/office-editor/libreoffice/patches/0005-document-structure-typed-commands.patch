+void handleSetSlideVisible(SlideCommandContext& rCtx, const std::string& /*rKey*/,
+                           const boost::property_tree::ptree& rValue)
+{
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        return;
+
+    const bool bVisible = rValue.get_value<bool>();
+    const bool bOldExcluded = pPage->IsExcluded();
+    const bool bNewExcluded = !bVisible;
+    if (bOldExcluded == bNewExcluded)
+        return;
+
+    if (rCtx.mbUndo)
+        rCtx.mpUndoManager->AddUndoAction(
+            std::make_unique<SetSlideExcludedUndoAction>(
+                *rCtx.mpDoc, pPage, bOldExcluded, bNewExcluded));
+    lcl_SetSlideExcluded(*rCtx.mpDoc, pPage, bNewExcluded);
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
