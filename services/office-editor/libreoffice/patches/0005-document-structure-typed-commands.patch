+void handleSetObjectProperties(SlideCommandContext& rCtx, const std::string& rKey,
+                               const boost::property_tree::ptree& rValue)
+{
+    int nObjId;
+    try
+    {
+        nObjId = stoi(rKey.substr(20));
+    }
+    catch (const std::exception&)
+    {
+        throw lang::IllegalArgumentException(u"Invalid object index"_ustr, nullptr, 0);
+    }
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<int>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Object index out of range"_ustr, nullptr, 0);
+
+    SdrObject* pObject = pPage->GetObj(nObjId);
+    uno::Reference<beans::XPropertySet> xProperties(pObject->getUnoShape(), uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySetInfo> xInfo = xProperties->getPropertySetInfo();
+    static const std::set<OUString> aAllowedProperties = {
+        u"Name"_ustr,
+        u"Title"_ustr,
+        u"Description"_ustr,
+        u"Decorative"_ustr,
+        u"TextLeftDistance"_ustr,
+        u"TextRightDistance"_ustr,
+        u"TextUpperDistance"_ustr,
+        u"TextLowerDistance"_ustr,
+        u"TextAutoGrowHeight"_ustr,
+        u"TextAutoGrowWidth"_ustr,
+        u"TextWordWrap"_ustr,
+        u"CharKerning"_ustr,
+        u"CharEscapement"_ustr,
+        u"CharEscapementHeight"_ustr,
+        u"Shadow"_ustr,
+        u"ShadowColor"_ustr,
+        u"ShadowTransparence"_ustr,
+        u"ShadowXDistance"_ustr,
+        u"ShadowYDistance"_ustr,
+        u"ShadowBlur"_ustr,
+        u"MoveProtect"_ustr,
+        u"SizeProtect"_ustr,
+        u"Printable"_ustr,
+    };
+
+    std::vector<std::pair<OUString, cpo::uno::Any>> aValues;
+    for (const auto& rEntry : rValue)
+    {
+        const OUString aName = OUString::fromUtf8(rEntry.first);
+        if (!aAllowedProperties.contains(aName) || !xInfo->hasPropertyByName(aName))
+            throw lang::IllegalArgumentException(u"Unsupported object property: "_ustr + aName,
+                                                  nullptr, 0);
+
+        cpo::uno::Any aValue;
+        const cpo::uno::TypeClass eType
+            = xInfo->getPropertyByName(aName).Type.getTypeClass();
+        switch (eType)
+        {
+            case cpo::uno::TypeClass_STRING:
+                aValue <<= OUString::fromUtf8(rEntry.second.get_value<std::string>());
+                break;
+            case cpo::uno::TypeClass_BOOLEAN:
+                aValue <<= rEntry.second.get_value<bool>();
+                break;
+            case cpo::uno::TypeClass_BYTE:
+                aValue <<= static_cast<sal_Int8>(rEntry.second.get_value<sal_Int32>());
+                break;
+            case cpo::uno::TypeClass_SHORT:
+                aValue <<= static_cast<sal_Int16>(rEntry.second.get_value<sal_Int32>());
+                break;
+            case cpo::uno::TypeClass_UNSIGNED_SHORT:
+                aValue <<= static_cast<sal_uInt16>(rEntry.second.get_value<sal_Int32>());
+                break;
+            case cpo::uno::TypeClass_LONG:
+                aValue <<= rEntry.second.get_value<sal_Int32>();
+                break;
+            case cpo::uno::TypeClass_UNSIGNED_LONG:
+                aValue <<= rEntry.second.get_value<sal_uInt32>();
+                break;
+            case cpo::uno::TypeClass_HYPER:
+                aValue <<= rEntry.second.get_value<sal_Int64>();
+                break;
+            case cpo::uno::TypeClass_FLOAT:
+                aValue <<= rEntry.second.get_value<float>();
+                break;
+            case cpo::uno::TypeClass_DOUBLE:
+                aValue <<= rEntry.second.get_value<double>();
+                break;
+            default:
+                throw lang::IllegalArgumentException(u"Unsupported object property type: "_ustr
+                                                          + aName,
+                                                      nullptr, 0);
+        }
+        aValues.emplace_back(aName, std::move(aValue));
+    }
+    if (aValues.empty())
+        throw lang::IllegalArgumentException(u"No object properties supplied"_ustr, nullptr, 0);
+
+    // UNO property setters do not consistently create native Undo actions.
+    // Attribute undo covers merged drawing/text items; geometry undo covers
+    // protection, visibility, printable state, layer and glue-point fields.
+    // String metadata and Decorative also add their specialized actions in
+    // SdrObject. The surrounding TransformDocumentStructure list action folds
+    // them into one user-visible Undo step.
+    if (rCtx.mbUndo)
+    {
+        rCtx.mpDrawView->AddUndo(
+            rCtx.mpDoc->GetSdrUndoFactory().CreateUndoAttrObject(*pObject, true, true));
+        rCtx.mpDrawView->AddUndo(
+            rCtx.mpDoc->GetSdrUndoFactory().CreateUndoGeoObject(*pObject));
+    }
+    for (const auto& [rName, rValueAny] : aValues)
+        xProperties->setPropertyValue(rName, rValueAny);
+    rCtx.touch(pPage);
+}
