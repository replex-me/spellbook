+// Slide visibility is document state, not slide-sorter selection state. Keep
+// the model mutation valid in headless/kit contexts, while still asking the
+// slide sorter to repaint when its descriptor is available.
+bool lcl_SetSlideExcluded(SdDrawDocument& rDoc, SdPage* pPage, bool bExcluded)
+{
+    if (!pPage || pPage->IsExcluded() == bExcluded)
+        return false;
+
+    DrawDocShell* pDocShell = rDoc.GetDocSh();
+    ViewShell* pViewShell = pDocShell ? pDocShell->GetViewShell() : nullptr;
+    if (pViewShell)
+    {
+        slidesorter::SlideSorterViewShell* pSlideSorterViewShell
+            = slidesorter::SlideSorterViewShell::GetSlideSorter(
+                pViewShell->GetViewShellBase());
+        if (pSlideSorterViewShell)
+        {
+            slidesorter::SlideSorter& rSlideSorter
+                = pSlideSorterViewShell->GetSlideSorter();
+            slidesorter::model::SlideSorterModel& rModel = rSlideSorter.GetModel();
+            for (sal_Int32 nIndex = 0; nIndex < rModel.GetPageCount(); ++nIndex)
+            {
+                slidesorter::model::SharedPageDescriptor pDescriptor
+                    = rModel.GetPageDescriptor(nIndex);
+                if (pDescriptor && pDescriptor->GetPage() == pPage)
+                    return rSlideSorter.GetView().SetState(
+                        pDescriptor,
+                        slidesorter::model::PageDescriptor::ST_Excluded,
+                        bExcluded);
+            }
+        }
+    }
+
+    pPage->SetExcluded(bExcluded);
+    return true;
+}
+
+class SetSlideExcludedUndoAction final : public SdUndoAction
+{
+public:
+    SetSlideExcludedUndoAction(SdDrawDocument& rDoc, SdPage* pPage,
+                               bool bOldExcluded, bool bNewExcluded)
+        : SdUndoAction(rDoc)
+        , mpPage(pPage)
+        , mbOldExcluded(bOldExcluded)
+        , mbNewExcluded(bNewExcluded)
+        , maComment(bNewExcluded ? SdResId(STR_UNDO_HIDE_SLIDE)
+                                 : SdResId(STR_UNDO_SHOW_SLIDE))
+    {
+    }
+
+    void Undo() override { lcl_SetSlideExcluded(mrDoc, mpPage, mbOldExcluded); }
+    void Redo() override { lcl_SetSlideExcluded(mrDoc, mpPage, mbNewExcluded); }
+    OUString GetComment() const override { return maComment; }
+
+private:
+    SdPage* mpPage;
+    bool mbOldExcluded;
+    bool mbNewExcluded;
+    OUString maComment;
+};
