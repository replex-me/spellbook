+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxEmptyContentPlaceholderStaysEditable)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdPage* pPage = pDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+
+    // Impress represents an untouched object/content placeholder as an empty
+    // OLE2 presentation object. PPTX must receive an editable <p:sp><p:ph
+    // type="obj">, not the placeholder icon as a flattened <p:pic>.
+    pPage->SetAutoLayout(AUTOLAYOUT_OBJ, true, false, true);
+    SdrObject* pContent = pPage->GetPresObj(PresObjKind::Object);
+    CPPUNIT_ASSERT(pContent);
+    CPPUNIT_ASSERT_EQUAL(SdrObjKind::OLE2, pContent->GetObjIdentifier());
+    const size_t nObjectCount = pPage->GetObjCount();
+
+    saveAndReload(TestFilter::PPTX);
+    pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    pPage = pDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_OBJ, pPage->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(nObjectCount, pPage->GetObjCount());
 
+    // OOXML imports its editable object placeholder through the text-capable
+    // representation. Either internal role is valid; a Graphic object is not.
+    pContent = pPage->GetPresObj(PresObjKind::Object);
+    if (!pContent)
+        pContent = pPage->GetPresObj(PresObjKind::Outline);
+    CPPUNIT_ASSERT(pContent);
+    CPPUNIT_ASSERT(pContent->GetObjIdentifier() != SdrObjKind::Graphic);
+    CPPUNIT_ASSERT(!pPage->GetPresObj(PresObjKind::Graphic));
+    uno::Reference<beans::XPropertySet> xContent(pContent->getUnoShape(),
+                                                 uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT(xContent->getPropertyValue(u"IsPresentationObject"_ustr).get<bool>());
+}
