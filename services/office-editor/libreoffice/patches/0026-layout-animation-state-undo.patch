+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTypedLayoutUndoRestoresAnimationTree)
+{
+    createSdImpressDoc();
+
+    static constexpr OUString aDuplicate = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"DuplicateSlide": 0}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aDuplicate) });
+
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(
+        mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(1), uno::UNO_QUERY_THROW);
+    uno::Reference<animations::XAnimationNodeSupplier> xAnimationSupplier(
+        xPage, uno::UNO_QUERY_THROW);
+    uno::Reference<animations::XAnimationNode> xRoot
+        = xAnimationSupplier->getAnimationNode();
+    CPPUNIT_ASSERT(xRoot.is());
+
+    // Express the fixture through the public UNO animation contract. Direct
+    // SdPage animation methods are private implementation details and are not
+    // exported from the release shared library used by full product builds.
+    uno::Reference<animations::XTimeContainer> xRootContainer(xRoot, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XEnumerationAccess> xRootAccess(xRoot, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XEnumeration> xChildren = xRootAccess->createEnumeration();
+    while (xChildren->hasMoreElements())
+    {
+        uno::Reference<animations::XAnimationNode> xChild(
+            xChildren->nextElement(), uno::UNO_QUERY_THROW);
+        xRootContainer->removeChild(xChild);
+    }
+
+    std::function<size_t(const uno::Reference<animations::XAnimationNode>&)> countNodes;
+    countNodes = [&countNodes](const uno::Reference<animations::XAnimationNode>& xNode) {
+        if (!xNode.is())
+            return size_t(0);
+        size_t nCount = 1;
+        uno::Reference<container::XEnumerationAccess> xAccess(xNode, uno::UNO_QUERY);
+        if (!xAccess.is())
+            return nCount;
+        uno::Reference<container::XEnumeration> xEnumeration = xAccess->createEnumeration();
+        while (xEnumeration->hasMoreElements())
+        {
+            uno::Reference<animations::XAnimationNode> xChild(
+                xEnumeration->nextElement(), uno::UNO_QUERY);
+            nCount += countNodes(xChild);
+        }
+        return nCount;
+    };
+    const size_t nOldNodeCount = countNodes(xAnimationSupplier->getAnimationNode());
+
+    static constexpr OUString aChangeLayout = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 1},
+            {"ChangeLayoutByName": "AUTOLAYOUT_TITLE_ONLY"}
+        ]
+    }
+}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aChangeLayout) });
+    const size_t nNewNodeCount = countNodes(xAnimationSupplier->getAnimationNode());
+    CPPUNIT_ASSERT(nNewNodeCount > nOldNodeCount);
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    Scheduler::ProcessEventsToIdle();
+    CPPUNIT_ASSERT_EQUAL(nOldNodeCount, countNodes(xAnimationSupplier->getAnimationNode()));
+
+    dispatchCommand(mxComponent, u".uno:Redo"_ustr, {});
+    Scheduler::ProcessEventsToIdle();
+    CPPUNIT_ASSERT_EQUAL(nNewNodeCount, countNodes(xAnimationSupplier->getAnimationNode()));
+}
