+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxObjectLocksRoundTrip)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xDrawPagesSupplier(mxComponent,
+                                                                   uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xDrawPage(
+        xDrawPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xDrawPage, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+
+    auto addShape = [&](const OUString& rService, const OUString& rName,
+                        const awt::Point& rPosition) {
+        uno::Reference<drawing::XShape> xShape(xFactory->createInstance(rService),
+                                               uno::UNO_QUERY_THROW);
+        xShape->setPosition(rPosition);
+        xShape->setSize(awt::Size(5000, 3000));
+        uno::Reference<container::XNamed>(xShape, uno::UNO_QUERY_THROW)->setName(rName);
+        xShapes->add(xShape);
+        return xShape;
+    };
+
+    uno::Reference<drawing::XShape> xMoveLocked = addShape(
+        u"com.sun.star.drawing.TextShape"_ustr, u"Move locked"_ustr, awt::Point(1000, 1000));
+    uno::Reference<beans::XPropertySet> xMoveProperties(xMoveLocked, uno::UNO_QUERY_THROW);
+    xMoveProperties->setPropertyValue(u"MoveProtect"_ustr, cpo::uno::Any(true));
+    xMoveProperties->setPropertyValue(u"SizeProtect"_ustr, cpo::uno::Any(false));
+
+    uno::Reference<drawing::XShape> xSizeLocked = addShape(
+        u"com.sun.star.drawing.RectangleShape"_ustr, u"Size locked"_ustr,
+        awt::Point(7000, 1000));
+    uno::Reference<beans::XPropertySet> xSizeProperties(xSizeLocked, uno::UNO_QUERY_THROW);
+    xSizeProperties->setPropertyValue(u"MoveProtect"_ustr, cpo::uno::Any(false));
+    xSizeProperties->setPropertyValue(u"SizeProtect"_ustr, cpo::uno::Any(true));
+
+    saveAndReload(TestFilter::PPTX);
+    xmlDocUniquePtr pXmlDoc = parseExport(u"ppt/slides/slide1.xml"_ustr);
+    assertXPath(pXmlDoc, "//a:spLocks[@noMove='1' and not(@noResize)]", 1);
+    assertXPath(pXmlDoc, "//a:spLocks[@noResize='1' and not(@noMove)]", 1);
+
+    xDrawPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xDrawPage.set(xDrawPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    auto findShape = [&](const OUString& rName) {
+        for (sal_Int32 nIndex = 0; nIndex < xDrawPage->getCount(); ++nIndex)
+        {
+            uno::Reference<drawing::XShape> xShape(xDrawPage->getByIndex(nIndex),
+                                                   uno::UNO_QUERY_THROW);
+            uno::Reference<container::XNamed> xNamed(xShape, uno::UNO_QUERY);
+            if (xNamed.is() && xNamed->getName() == rName)
+                return xShape;
+        }
+        return uno::Reference<drawing::XShape>();
+    };
+    auto lockState = [](const uno::Reference<drawing::XShape>& xShape,
+                        const OUString& rPropertyName) {
+        CPPUNIT_ASSERT(xShape.is());
+        bool bValue = false;
+        uno::Reference<beans::XPropertySet>(xShape, uno::UNO_QUERY_THROW)
+            ->getPropertyValue(rPropertyName) >>= bValue;
+        return bValue;
+    };
+
+    xMoveLocked = findShape(u"Move locked"_ustr);
+    CPPUNIT_ASSERT(lockState(xMoveLocked, u"MoveProtect"_ustr));
+    CPPUNIT_ASSERT(!lockState(xMoveLocked, u"SizeProtect"_ustr));
+    xSizeLocked = findShape(u"Size locked"_ustr);
+    CPPUNIT_ASSERT(!lockState(xSizeLocked, u"MoveProtect"_ustr));
+    CPPUNIT_ASSERT(lockState(xSizeLocked, u"SizeProtect"_ustr));
+}
