+void handleSetSlideTransition(SlideCommandContext& rCtx, const std::string& /*rKey*/,
+                              const boost::property_tree::ptree& rValue)
+{
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Slide transition target is unavailable"_ustr,
+                                              nullptr, 0);
+
+    const sal_Int16 nType = rValue.get<sal_Int16>("Type");
+    const sal_Int16 nSubtype = rValue.get<sal_Int16>("Subtype");
+    const bool bDirection = rValue.get<bool>("Direction");
+    const sal_Int32 nFadeColor = rValue.get<sal_Int32>("FadeColor");
+    const double fDuration = rValue.get<double>("Duration");
+    if (nType < 0 || nType > 43 || nSubtype < 0 || nSubtype > 119
+        || nFadeColor < 0 || nFadeColor > 0x00ffffff || fDuration < 0.0
+        || fDuration > 60.0)
+        throw lang::IllegalArgumentException(u"Slide transition value is out of range"_ustr,
+                                              nullptr, 0);
+
+    if (pPage->getTransitionType() == nType
+        && pPage->getTransitionSubtype() == nSubtype
+        && pPage->getTransitionDirection() == bDirection
+        && pPage->getTransitionFadeColor() == nFadeColor
+        && rtl::math::approxEqual(pPage->getTransitionDuration(), fDuration))
+        return;
+
+    // The transition pane already uses this complete page-level snapshot.
+    // Reuse it for typed document transforms so effect, direction, duration
+    // and sound state remain one native history operation.
+    if (rCtx.mbUndo)
+        rCtx.mpUndoManager->AddUndoAction(
+            std::make_unique<sd::UndoTransition>(*rCtx.mpDoc, pPage));
+    pPage->setTransitionType(nType);
+    pPage->setTransitionSubtype(nSubtype);
+    pPage->setTransitionDirection(bDirection);
+    pPage->setTransitionFadeColor(nFadeColor);
+    pPage->setTransitionDuration(fDuration);
+    rCtx.mpDoc->SetChanged();
+    rCtx.touch(pPage);
+}
