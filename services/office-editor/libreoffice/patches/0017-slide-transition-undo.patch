+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureSlideTransitionUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdPage* pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+
+    const sal_Int16 nOldType = pPage->getTransitionType();
+    const sal_Int16 nOldSubtype = pPage->getTransitionSubtype();
+    const bool bOldDirection = pPage->getTransitionDirection();
+    const sal_Int32 nOldFadeColor = pPage->getTransitionFadeColor();
+    const double fOldDuration = pPage->getTransitionDuration();
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetSlideTransition": {
+                "Type": 37,
+                "Subtype": 101,
+                "Direction": true,
+                "FadeColor": 16711935,
+                "Duration": 0.75
+            }}
+        ]
+    }
+}
+)json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(37), pPage->getTransitionType());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(101), pPage->getTransitionSubtype());
+    CPPUNIT_ASSERT(pPage->getTransitionDirection());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(16711935), pPage->getTransitionFadeColor());
+    CPPUNIT_ASSERT_EQUAL(0.75, pPage->getTransitionDuration());
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nOldType, pPage->getTransitionType());
+    CPPUNIT_ASSERT_EQUAL(nOldSubtype, pPage->getTransitionSubtype());
+    CPPUNIT_ASSERT_EQUAL(bOldDirection, pPage->getTransitionDirection());
+    CPPUNIT_ASSERT_EQUAL(nOldFadeColor, pPage->getTransitionFadeColor());
+    CPPUNIT_ASSERT_EQUAL(fOldDuration, pPage->getTransitionDuration());
+
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(37), pPage->getTransitionType());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(101), pPage->getTransitionSubtype());
+    CPPUNIT_ASSERT(pPage->getTransitionDirection());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(16711935), pPage->getTransitionFadeColor());
+    CPPUNIT_ASSERT_EQUAL(0.75, pPage->getTransitionDuration());
+}
