+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    SdrObject* pObject = pPage->GetObj(0);
+
+    SdAnimationInfo* pOldInfo = SdDrawDocument::GetShapeUserData(*pObject, true);
+    pOldInfo->mbDimHide = true;
+    pOldInfo->mnVerb = 42;
+    const presentation::ClickAction eOldAction
+        = pOldInfo ? pOldInfo->meClickAction : presentation::ClickAction_NONE;
+    const OUString aOldBookmark = pOldInfo ? pOldInfo->GetBookmark() : OUString();
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetObjectInteraction.0": {
+                "Action": "external_url",
+                "Target": "https://example.invalid/presentation"
+            }}
+        ]
+    }
+}
+)json"_ustr;
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    auto getInteraction = [&]() {
+        SdAnimationInfo* pInfo = SdDrawDocument::GetShapeUserData(*pObject, false);
+        return std::pair(
+            pInfo ? pInfo->meClickAction : presentation::ClickAction_NONE,
+            pInfo ? pInfo->GetBookmark() : OUString());
+    };
+    auto assertAdjacentState = [&]() {
+        SdAnimationInfo* pInfo = SdDrawDocument::GetShapeUserData(*pObject, false);
+        CPPUNIT_ASSERT(pInfo);
+        CPPUNIT_ASSERT(pInfo->mbDimHide);
+        CPPUNIT_ASSERT_EQUAL(sal_uInt16(42), pInfo->mnVerb);
+    };
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+    auto [eAction, aBookmark] = getInteraction();
+    CPPUNIT_ASSERT_EQUAL(presentation::ClickAction_DOCUMENT, eAction);
+    CPPUNIT_ASSERT_EQUAL(u"https://example.invalid/presentation"_ustr, aBookmark);
+    assertAdjacentState();
+
+    pUndoManager->Undo();
+    std::tie(eAction, aBookmark) = getInteraction();
+    CPPUNIT_ASSERT_EQUAL(eOldAction, eAction);
+    CPPUNIT_ASSERT_EQUAL(aOldBookmark, aBookmark);
+    assertAdjacentState();
+    pUndoManager->Redo();
+    std::tie(eAction, aBookmark) = getInteraction();
+    CPPUNIT_ASSERT_EQUAL(presentation::ClickAction_DOCUMENT, eAction);
+    CPPUNIT_ASSERT_EQUAL(u"https://example.invalid/presentation"_ustr, aBookmark);
+    assertAdjacentState();
+
+    saveAndReload(TestFilter::PPTX);
+    pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    pObject = pPage->GetObj(0);
+    std::tie(eAction, aBookmark) = getInteraction();
+    CPPUNIT_ASSERT_EQUAL(presentation::ClickAction_DOCUMENT, eAction);
