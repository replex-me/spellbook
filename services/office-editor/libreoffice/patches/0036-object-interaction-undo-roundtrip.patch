+void handleSetObjectInteraction(SlideCommandContext& rCtx, const std::string& rKey,
+                                const boost::property_tree::ptree& rValue)
+{
+    static const std::set<std::string> aAllowedKeys = {
+        "Action",
+        "Target",
+        "TargetSlideIndex",
+    };
+    for (const auto& rEntry : rValue)
+    {
+        if (!aAllowedKeys.contains(rEntry.first))
+            throw lang::IllegalArgumentException(
+                u"Unsupported object interaction field: "_ustr
+                    + OUString::fromUtf8(rEntry.first),
+                nullptr, 0);
+    }
+
+    const auto oAction = rValue.get_optional<std::string>("Action");
+    const auto oTarget = rValue.get_optional<std::string>("Target");
+    const auto oTargetSlide = rValue.get_optional<sal_Int32>("TargetSlideIndex");
+    if (!oAction)
+        throw lang::IllegalArgumentException(u"Object interaction action is required"_ustr,
+                                              nullptr, 0);
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage)
+        throw lang::IllegalArgumentException(u"Object interaction slide is unavailable"_ustr,
+                                              nullptr, 0);
+    SdrObject* pObject = lcl_ResolveObjectPath(*pPage, rKey.substr(21));
+
+    presentation::ClickAction eNewAction = presentation::ClickAction_NONE;
+    OUString aNewBookmark;
+    if (*oAction == "external_url")
+    {
+        if (!oTarget || oTargetSlide || oTarget->empty() || oTarget->size() > 2048)
+            throw lang::IllegalArgumentException(u"External link target is invalid"_ustr,
+                                                  nullptr, 0);
+        INetURLObject aUrl(OUString::fromUtf8(*oTarget));
+        if (aUrl.HasError()
+            || (aUrl.GetProtocol() != INetProtocol::Http
+                && aUrl.GetProtocol() != INetProtocol::Https)
+            || aUrl.HasUserData() || aUrl.GetHost().isEmpty())
+            throw lang::IllegalArgumentException(u"Only credential-free HTTP links are allowed"_ustr,
+                                                  nullptr, 0);
+        eNewAction = presentation::ClickAction_DOCUMENT;
+        aNewBookmark = aUrl.GetMainURL(INetURLObject::DecodeMechanism::NONE);
+    }
+    else if (*oAction == "internal_slide")
+    {
+        if (oTarget || !oTargetSlide || *oTargetSlide < 0
+            || *oTargetSlide >= rCtx.mnPageCount)
+            throw lang::IllegalArgumentException(u"Internal slide target is invalid"_ustr,
+                                                  nullptr, 0);
+        SdPage* pTarget = rCtx.mpDoc->GetSdPage(
+            static_cast<sal_uInt16>(*oTargetSlide), PageKind::Standard);
+        if (!pTarget)
+            throw lang::IllegalArgumentException(u"Internal slide target is unavailable"_ustr,
+                                                  nullptr, 0);
+        eNewAction = presentation::ClickAction_BOOKMARK;
+        aNewBookmark = pTarget->GetName();
+    }
+    else
+    {
+        if (oTarget || oTargetSlide)
+            throw lang::IllegalArgumentException(u"Navigation action has an unexpected target"_ustr,
+                                                  nullptr, 0);
+        static const std::map<std::string, presentation::ClickAction> aNavigationActions = {
+            { "none", presentation::ClickAction_NONE },
+            { "next_slide", presentation::ClickAction_NEXTPAGE },
+            { "previous_slide", presentation::ClickAction_PREVPAGE },
+            { "first_slide", presentation::ClickAction_FIRSTPAGE },
+            { "last_slide", presentation::ClickAction_LASTPAGE },
+            { "end_show", presentation::ClickAction_STOPPRESENTATION },
+        };
+        const auto it = aNavigationActions.find(*oAction);
+        if (it == aNavigationActions.end())
+            throw lang::IllegalArgumentException(u"Unsupported object interaction action"_ustr,
+                                                  nullptr, 0);
+        eNewAction = it->second;
+    }
+
+    SdAnimationInfo* pOldInfo = SdDrawDocument::GetShapeUserData(*pObject, false);
+    if (pOldInfo && pOldInfo->mbSecondSoundOn)
+        throw lang::IllegalArgumentException(
+            u"Object interaction cannot replace a shared second-effect sound target"_ustr,
+            nullptr, 0);
+    const bool bHadOldInfo = pOldInfo != nullptr;
+    const presentation::ClickAction eOldAction
+        = pOldInfo ? pOldInfo->meClickAction : presentation::ClickAction_NONE;
+    const OUString aOldBookmark = pOldInfo ? pOldInfo->GetBookmark() : OUString();
+    if (eOldAction == eNewAction && aOldBookmark == aNewBookmark)
+        return;
+
+    rCtx.addUndo(std::make_unique<SetObjectInteractionUndoAction>(
+        *rCtx.mpDoc, *pObject, bHadOldInfo, eOldAction, aOldBookmark,
+        eNewAction, aNewBookmark));
+    lcl_SetObjectInteraction(*pObject, eNewAction, aNewBookmark);
+    rCtx.touch(pPage);
+}
