+void lcl_SetObjectInteraction(SdrObject& rObject,
+                              presentation::ClickAction eAction,
+                              const OUString& rBookmark)
+{
+    SdAnimationInfo* pInfo = SdDrawDocument::GetShapeUserData(rObject, true);
+    pInfo->meClickAction = eAction;
+    pInfo->SetBookmark(rBookmark);
+    rObject.SetChanged();
+    rObject.BroadcastObjectChange();
+}
+
+// Interaction data lives in SdAnimationInfo rather than the ordinary drawing
+// item set, so generic attribute Undo cannot restore it. Keep this action
+// deliberately narrow: changing a link must not overwrite animation, sound,
+// dimming or other presentation state stored beside it.
+class SetObjectInteractionUndoAction final : public SdUndoAction
+{
+public:
+    SetObjectInteractionUndoAction(
+        SdDrawDocument& rDoc, SdrObject& rObject, bool bHadOldInfo,
+        presentation::ClickAction eOldAction, const OUString& rOldBookmark,
+        presentation::ClickAction eNewAction, const OUString& rNewBookmark)
+        : SdUndoAction(rDoc)
+        , mrObject(rObject)
+        , mbHadOldInfo(bHadOldInfo)
+        , meOldAction(eOldAction)
+        , maOldBookmark(rOldBookmark)
+        , meNewAction(eNewAction)
+        , maNewBookmark(rNewBookmark)
+    {
+    }
+
+    void Undo() override
+    {
+        if (mbHadOldInfo)
+            lcl_SetObjectInteraction(mrObject, meOldAction, maOldBookmark);
+        else
+        {
+            mrObject.deleteUserData(UserDataID::ID_SdAnimationInfo);
+            mrObject.SetChanged();
+            mrObject.BroadcastObjectChange();
+        }
+    }
+
+    void Redo() override
+    {
+        lcl_SetObjectInteraction(mrObject, meNewAction, maNewBookmark);
+    }
+
+private:
+    SdrObject& mrObject;
+    bool mbHadOldInfo;
+    presentation::ClickAction meOldAction;
+    OUString maOldBookmark;
+    presentation::ClickAction meNewAction;
+    OUString maNewBookmark;
+};
