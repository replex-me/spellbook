+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTypedTextMetricsRecenterLiveExportAfterUndoRedo)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                                uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPage> xPage(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    while (xPage->getCount())
+    {
+        uno::Reference<drawing::XShape> xShape(xPage->getByIndex(0),
+                                                uno::UNO_QUERY_THROW);
+        xPage->remove(xShape);
+    }
+    uno::Reference<beans::XPropertySet> xPageProperties(xPage, uno::UNO_QUERY_THROW);
+    sal_Int32 nPageWidth = 0;
+    sal_Int32 nPageHeight = 0;
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue(u"Width"_ustr) >>= nPageWidth);
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue(u"Height"_ustr) >>= nPageHeight);
+
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent,
+                                                         uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance(u"com.sun.star.drawing.TextShape"_ustr),
+        uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(nPageWidth / 4, nPageHeight / 3));
+    xShape->setSize(awt::Size(nPageWidth / 2, nPageHeight / 3));
+    xPage->add(xShape);
+    uno::Reference<beans::XPropertySet> xShapeProperties(xShape, uno::UNO_QUERY_THROW);
+    xShapeProperties->setPropertyValue(u"FillStyle"_ustr,
+                                       cpo::uno::Any(drawing::FillStyle_NONE));
+    xShapeProperties->setPropertyValue(u"LineStyle"_ustr,
+                                       cpo::uno::Any(drawing::LineStyle_NONE));
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString(u"CENTERED METRICS"_ustr);
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+    xCursor->gotoEnd(true);
+    uno::Reference<beans::XPropertySet> xTextProperties(xCursor, uno::UNO_QUERY_THROW);
+    xTextProperties->setPropertyValue(u"CharColor"_ustr,
+                                      cpo::uno::Any(sal_Int32(0xff0000)));
+    xTextProperties->setPropertyValue(u"CharHeight"_ustr, cpo::uno::Any(32.0f));
+    xTextProperties->setPropertyValue(u"ParaAdjust"_ustr,
+                                      cpo::uno::Any(style::ParagraphAdjust_CENTER));
+
+    auto renderRedBounds = [&]() {
+        utl::TempFileNamed aTempFile;
+        aTempFile.EnableKillingFile();
+        uno::Reference<drawing::XGraphicExportFilter> xExporter
+            = drawing::GraphicExportFilter::create(getComponentContext());
+        xExporter->setSourceDocument(
+            uno::Reference<lang::XComponent>(xPage, uno::UNO_QUERY_THROW));
+        cpo::uno::Sequence<beans::PropertyValue> aFilterData{
+            comphelper::makePropertyValue(u"PixelWidth"_ustr, sal_Int32(1000)),
+            comphelper::makePropertyValue(
+                u"PixelHeight"_ustr,
+                sal_Int32(std::round(1000.0 * nPageHeight / nPageWidth))),
+        };
+        cpo::uno::Sequence<beans::PropertyValue> aDescriptor{
+            comphelper::makePropertyValue(u"URL"_ustr, aTempFile.GetURL()),
+            comphelper::makePropertyValue(u"FilterName"_ustr, u"PNG"_ustr),
+            comphelper::makePropertyValue(u"FilterData"_ustr, aFilterData),
+        };
+        CPPUNIT_ASSERT(xExporter->filter(aDescriptor));
+        SvFileStream aStream(aTempFile.GetURL(), StreamMode::READ);
+        Bitmap aBitmap = vcl::PngImageReader(aStream).read();
+        BitmapScopedReadAccess pReadAccess(aBitmap);
+        tools::Long nLeft = aBitmap.GetSizePixel().Width();
+        tools::Long nRight = -1;
+        tools::Long nRedPixels = 0;
+        for (tools::Long nY = 0; nY < aBitmap.GetSizePixel().Height(); ++nY)
+            for (tools::Long nX = 0; nX < aBitmap.GetSizePixel().Width(); ++nX)
+            {
+                const Color aColor = pReadAccess->GetColor(nY, nX);
+                if (aColor.GetRed() <= 160 || aColor.GetGreen() >= 120
+                    || aColor.GetBlue() >= 120)
+                    continue;
+                nLeft = std::min(nLeft, nX);
+                nRight = std::max(nRight, nX);
+                ++nRedPixels;
+            }
+        CPPUNIT_ASSERT(nRedPixels > 20);
+        return std::tuple(aBitmap.GetSizePixel().Width(), nLeft, nRight);
+    };
+    const auto assertCentered = [](const auto& rBounds) {
+        const auto [nWidth, nLeft, nRight] = rBounds;
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(nWidth / 2.0, (nLeft + nRight) / 2.0, 3.0);
+    };
+
+    const auto aBefore = renderRedBounds();
+    assertCentered(aBefore);
+    static constexpr OUString aJson = uR"json(
+{"Transforms":{"SlideCommands":[{"JumpToSlide":0},{"SetTextProperties.0":{"Escapement":33,"EscapementHeight":58}}]}}
+)json"_ustr;
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+    const auto aAfter = renderRedBounds();
+    assertCentered(aAfter);
+    CPPUNIT_ASSERT(std::get<2>(aAfter) - std::get<1>(aAfter)
+                   < std::get<2>(aBefore) - std::get<1>(aBefore));
+
+    auto* pUndoManager = pImpressDocument->GetDocShell()->GetUndoManager();
+    pUndoManager->Undo();
+    assertCentered(renderRedBounds());
+    pUndoManager->Redo();
+    assertCentered(renderRedBounds());
+}
