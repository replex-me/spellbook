+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testDocumentStructureTextRangePreservesFormatting)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdDrawDocument* pDoc = pImpressDocument->GetDoc();
+    SdPage* pPage = pDoc->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage && pPage->GetObjCount() > 0);
+    auto* pTextObject = dynamic_cast<SdrTextObj*>(pPage->GetObj(0));
+    CPPUNIT_ASSERT(pTextObject);
+    pDoc->EnableUndo(false);
+    pTextObject->SetText(u"Alpha BETA Omega"_ustr);
+    SdOutliner* pOutliner = pDoc->GetInternalOutliner();
+    pOutliner->Init(pTextObject->GetOutlinerParaObject()->GetOutlinerMode());
+    pOutliner->SetText(*pTextObject->GetOutlinerParaObject());
+    SfxItemSet aBoldSet(pOutliner->GetEmptyItemSet());
+    aBoldSet.Put(SvxWeightItem(WEIGHT_BOLD, EE_CHAR_WEIGHT));
+    pOutliner->QuickSetAttribs(aBoldSet, ESelection(0, 6, 0, 10));
+    pTextObject->SetOutlinerParaObject(pOutliner->CreateParaObject());
+    pDoc->EnableUndo(true);
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"JumpToSlide": 0},
+            {"SetTextRange.0": {
+                "Paragraph": 0,
+                "Start": 6,
+                "End": 10,
+                "ExpectedText": "BETA",
+                "Text": "Gamma"
+            }}
+        ]
+    }
+}
+)json"_ustr;
+    const size_t nUndoBefore = pDoc->GetUndoManager()->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pDoc->GetUndoManager()->GetUndoActionCount() - nUndoBefore);
+    pOutliner->SetText(*pTextObject->GetOutlinerParaObject());
+    CPPUNIT_ASSERT_EQUAL(u"Alpha Gamma Omega"_ustr,
+                         pOutliner->GetText(pOutliner->GetParagraph(0)));
+    const SfxItemSet aReplacementAttributes
+        = pOutliner->GetEditEngine().GetAttribs(0, 6, 11);
+    CPPUNIT_ASSERT_EQUAL(WEIGHT_BOLD,
+                         aReplacementAttributes.Get(EE_CHAR_WEIGHT).GetWeight());
+
+    pImpressDocument->GetDocShell()->GetUndoManager()->Undo();
+    pOutliner->SetText(*pTextObject->GetOutlinerParaObject());
+    CPPUNIT_ASSERT_EQUAL(u"Alpha BETA Omega"_ustr,
+                         pOutliner->GetText(pOutliner->GetParagraph(0)));
+    pImpressDocument->GetDocShell()->GetUndoManager()->Redo();
+    pOutliner->SetText(*pTextObject->GetOutlinerParaObject());
+    CPPUNIT_ASSERT_EQUAL(u"Alpha Gamma Omega"_ustr,
+                         pOutliner->GetText(pOutliner->GetParagraph(0)));
+}
