+void handleSetTextRange(SlideCommandContext& rCtx, const std::string& rKey,
+                        const boost::property_tree::ptree& rValue)
+{
+    int nObjId;
+    try
+    {
+        nObjId = stoi(rKey.substr(13));
+    }
+    catch (const std::exception&)
+    {
+        throw lang::IllegalArgumentException(u"Invalid text object index"_ustr, nullptr, 0);
+    }
+
+    SdPage* pPage = rCtx.mpDoc->GetSdPage(rCtx.mnActPageId, PageKind::Standard);
+    if (!pPage || nObjId < 0 || nObjId >= static_cast<int>(pPage->GetObjCount()))
+        throw lang::IllegalArgumentException(u"Text object index out of range"_ustr, nullptr, 0);
+
+    SdrObject* pObject = pPage->GetObj(nObjId);
+    if (!pObject->IsSdrTextObj())
+        throw lang::IllegalArgumentException(u"Object has no editable text"_ustr, nullptr, 0);
+    auto* pTextObject = static_cast<SdrTextObj*>(pObject);
+    const OutlinerParaObject* pOriginal = pTextObject->GetOutlinerParaObject();
+    if (!pOriginal)
+        throw lang::IllegalArgumentException(u"Object has no text paragraphs"_ustr, nullptr, 0);
+
+    const sal_Int32 nParagraph = rValue.get<sal_Int32>("Paragraph");
+    const sal_Int32 nStart = rValue.get<sal_Int32>("Start");
+    const sal_Int32 nEnd = rValue.get<sal_Int32>("End");
+    const OUString aExpected
+        = OUString::fromUtf8(rValue.get<std::string>("ExpectedText"));
+    const OUString aReplacement = OUString::fromUtf8(rValue.get<std::string>("Text"));
+
+    Outliner* pOutliner = rCtx.mpDoc->GetInternalOutliner();
+    const OutlinerMode eOldMode = pOutliner->GetOutlinerMode();
+    comphelper::ScopeGuard const aOutlinerGuard([pOutliner, eOldMode]() {
+        pOutliner->Init(eOldMode);
+    });
+    pOutliner->Init(pOriginal->GetOutlinerMode());
+    pOutliner->SetText(*pOriginal);
+    if (nParagraph < 0 || nParagraph >= pOutliner->GetParagraphCount())
+        throw lang::IllegalArgumentException(u"Paragraph index out of range"_ustr, nullptr, 0);
+    const OUString aParagraph = pOutliner->GetText(pOutliner->GetParagraph(nParagraph));
+    if (nStart < 0 || nEnd < nStart || nEnd > aParagraph.getLength())
+        throw lang::IllegalArgumentException(u"Text range out of range"_ustr, nullptr, 0);
+    if (aParagraph.copy(nStart, nEnd - nStart) != aExpected)
+        throw lang::IllegalArgumentException(u"Text range changed"_ustr, nullptr, 0);
+
+    if (aExpected == aReplacement)
+        return;
+    if (rCtx.mbUndo)
+        rCtx.mpDrawView->AddUndo(
+            rCtx.mpDoc->GetSdrUndoFactory().CreateUndoObjectSetText(*pObject, 0));
+    pOutliner->QuickInsertText(
+        aReplacement, ESelection(nParagraph, nStart, nParagraph, nEnd));
+    pTextObject->SetOutlinerParaObject(pOutliner->CreateParaObject());
+    pObject->SetEmptyPresObj(false);
+    rCtx.touch(pPage);
+}
