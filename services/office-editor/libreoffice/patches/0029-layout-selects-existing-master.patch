+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testTypedLayoutSelectsExistingMaster)
+{
+    createSdImpressDoc();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDoc = pDocument->GetDoc();
+    SdPage* pPage = pDocument->GetDocShell()->GetViewShell()->GetActualPage();
+    CPPUNIT_ASSERT(pDoc && pPage && pPage->TRG_HasMasterPage());
+    SdPage* pOriginalMaster = static_cast<SdPage*>(&pPage->TRG_GetMasterPage());
+
+    uno::Reference<drawing::XMasterPagesSupplier> xMasterPagesSupplier(
+        mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XDrawPages> xMasterPages
+        = xMasterPagesSupplier->getMasterPages();
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), xMasterPages->getCount());
+    xMasterPages->insertNewByIndex(1);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(2), xMasterPages->getCount());
+    SdPage* pAlternateMaster = pDoc->GetMasterSdPage(1, PageKind::Standard);
+    CPPUNIT_ASSERT(pAlternateMaster);
+    pAlternateMaster->SetAutoLayout(AUTOLAYOUT_NONE, true, true);
+    const OUString aAlternateLayoutName = pAlternateMaster->GetLayoutName();
+    const sal_uInt16 nMasterCount = pDoc->GetMasterSdPageCount(PageKind::Standard);
+
+    static constexpr OUString aJson = uR"json(
+{
+    "Transforms": {
+        "SlideCommands": [
+            {"ChangeLayout": {"MasterIndex": 1, "Layout": 20}}
+        ]
+    }
+}
+)json"_ustr;
+    auto* pUndoManager = pDocument->GetDocShell()->GetUndoManager();
+    const size_t nUndoBefore = pUndoManager->GetUndoActionCount();
+    dispatchCommand(mxComponent, u".uno:TransformDocumentStructure"_ustr,
+                    { comphelper::makePropertyValue(u"DataJson"_ustr, aJson) });
+
+    CPPUNIT_ASSERT_EQUAL(nMasterCount, pDoc->GetMasterSdPageCount(PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_NONE, pPage->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(aAlternateLayoutName, pPage->GetLayoutName());
+    CPPUNIT_ASSERT(&pPage->TRG_GetMasterPage() == pAlternateMaster);
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount() - nUndoBefore);
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nMasterCount, pDoc->GetMasterSdPageCount(PageKind::Standard));
+    CPPUNIT_ASSERT(&pPage->TRG_GetMasterPage() == pOriginalMaster);
+
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nMasterCount, pDoc->GetMasterSdPageCount(PageKind::Standard));
+    CPPUNIT_ASSERT_EQUAL(AUTOLAYOUT_NONE, pPage->GetAutoLayout());
+    CPPUNIT_ASSERT_EQUAL(aAlternateLayoutName, pPage->GetLayoutName());
+    CPPUNIT_ASSERT(&pPage->TRG_GetMasterPage() == pAlternateMaster);
+}
