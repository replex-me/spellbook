+void handleSetSections(SlideCommandContext& rCtx, const std::string& /*rKey*/,
+                       const boost::property_tree::ptree& rValue)
+{
+    std::vector<sd::SlideSection> aSections;
+    std::set<OUString> aIds;
+    std::set<OUString> aNames;
+    sal_Int32 nPreviousStart = -1;
+    const sal_Int32 nPageCount
+        = rCtx.mpDoc->GetSdPageCount(PageKind::Standard);
+    for (const auto& rEntry : rValue)
+    {
+        const boost::property_tree::ptree& rSection = rEntry.second;
+        for (const auto& rField : rSection)
+        {
+            if (rField.first != "Id" && rField.first != "Name"
+                && rField.first != "StartIndex")
+                throw lang::IllegalArgumentException(
+                    u"Unsupported slide section field"_ustr, nullptr, 0);
+        }
+        const OUString aId
+            = OUString::fromUtf8(rSection.get<std::string>("Id")).toAsciiUpperCase();
+        const OUString aName = OUString::fromUtf8(rSection.get<std::string>("Name"));
+        const sal_Int32 nStart = rSection.get<sal_Int32>("StartIndex");
+        const auto isHex = [](sal_Unicode c) {
+            return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F');
+        };
+        bool bValidId = aId.getLength() == 38 && aId[0] == '{' && aId[37] == '}';
+        for (sal_Int32 nIndex = 1; bValidId && nIndex < 37; ++nIndex)
+        {
+            const bool bHyphen = nIndex == 9 || nIndex == 14 || nIndex == 19 || nIndex == 24;
+            bValidId = bHyphen ? aId[nIndex] == '-' : isHex(aId[nIndex]);
+        }
+        if (!bValidId || aName.isEmpty() || aName.getLength() > 255
+            || aIds.contains(aId) || aNames.contains(aName) || nStart < 0
+            || nStart >= nPageCount || nStart <= nPreviousStart
+            || (aSections.empty() && nStart != 0))
+            throw lang::IllegalArgumentException(u"Invalid slide section"_ustr, nullptr, 0);
+        aIds.insert(aId);
+        aNames.insert(aName);
+        aSections.push_back({ aName, aId, nStart });
+        nPreviousStart = nStart;
+    }
+
+    sd::SlideSectionManager& rManager = rCtx.mpDoc->GetSectionManager();
+    const std::vector<sd::SlideSection> aOldSections = rManager.GetSectionsSnapshot();
+    const bool bSame = aOldSections.size() == aSections.size()
+        && std::equal(aOldSections.begin(), aOldSections.end(), aSections.begin(),
+                      [](const sd::SlideSection& rLeft, const sd::SlideSection& rRight) {
+                          return rLeft.maId == rRight.maId && rLeft.maName == rRight.maName
+                                 && rLeft.mnStartIndex == rRight.mnStartIndex;
+                      });
+    if (bSame)
+        return;
+    if (rCtx.mbUndo)
+        rCtx.addUndo(std::make_unique<sd::UndoSlideSection>(
+            *rCtx.mpDoc, u"AI set slide sections"_ustr, aOldSections));
+    rManager.RestoreSectionsSnapshot(aSections);
+    rCtx.mpDoc->SetChanged();
+    for (sal_Int32 nIndex = 0; nIndex < nPageCount; ++nIndex)
+        rCtx.touch(rCtx.mpDoc->GetSdPage(nIndex, PageKind::Standard));
+}
